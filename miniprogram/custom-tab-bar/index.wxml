<view wx:if="{{!hidden}}" class="curved-tabs {{largeText?'large-text':''}}" style="background:{{surface}};color:{{muted}};--surface:{{surface}};--border:{{border}}">
 <view class="tab-items"><button wx:for="{{items}}" wx:key="name" class="tab-item {{item.name==='publish'?'tab-publish':''}} {{route===item.route?'selected':''}}" data-route="{{item.route}}" bindtap="select" aria-label="{{item.label}}{{item.name==='messages'&&unread?'，'+unread+'条未读':''}}" aria-selected="{{route===item.route}}" style="color:{{route===item.route?selectedColor:muted}}" hover-class="none"><view class="tab-icon"><image src="/assets/icons/nav-{{item.name}}{{route===item.route?'-'+theme:''}}.png" aria-hidden="true"/><text wx:if="{{item.name==='messages'&&unread}}" class="tab-badge">{{unread>99?'99+':unread}}</text></view><text class="tab-label">{{item.label}}</text></button></view>
</view>
