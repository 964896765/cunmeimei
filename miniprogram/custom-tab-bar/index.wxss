:host { display:block; }
.curved-tabs {
 position:fixed; z-index:1000; left:16px; right:16px; bottom:calc(9px + env(safe-area-inset-bottom));
 height:60px; padding:4px; box-sizing:border-box; border:1px solid var(--border); border-radius:28px; background:var(--surface);
 box-shadow:0 10px 24px #211b362e,0 2px 5px #211b3612;
}
.tab-items { display:flex; align-items:stretch; height:100%; }
.tab-item { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; flex:1; min-width:0; min-height:44px; height:100%; padding:2px 0; margin:0; border:0; border-radius:20px; background:transparent; overflow:visible; line-height:1.2; font-weight:400; }
.tab-item::after { border:0; }
.tab-icon { display:flex; align-items:center; justify-content:center; position:relative; width:34px; height:30px; }
.tab-icon image { display:block; width:30px; height:30px; }
.tab-label { font-size:12px; line-height:15px; }
.tab-publish .tab-icon { width:32px; height:30px; border-radius:10px; background:var(--surface); border:1rpx solid var(--border); }
.tab-publish .tab-icon image { width:30px; height:30px; }
.tab-publish.selected .tab-icon { border-color:var(--tab-active); background:var(--tab-active); }
.tab-item.selected .tab-label { font-weight:700; }
.tab-badge { position:absolute; top:-2px; left:20px; min-width:16px; height:16px; padding:0 4px; box-sizing:border-box; border-radius:8px; background:#8D3D51; color:#FFFFFF; font-size:11px; line-height:16px; text-align:center; }
.neutral-tabs .tab-icon image,.neutral-tabs .tab-badge { filter:grayscale(1); }
.large-text .tab-label { font-size:12px; }
.prism-tabs {
 border-color:#fff; background:linear-gradient(155deg,#fff,#f7f8ff);
 box-shadow:inset 0 1px 0 #fff,0 10px 25px #3d335533,0 2px 5px #3d335515;
}
@supports (backdrop-filter:blur(14px)) {
 .prism-tabs { background:linear-gradient(155deg,#ffffffed,#f7f8ffe5); backdrop-filter:blur(14px); }
}
.prism-tabs .tab-item.selected { background:linear-gradient(145deg,#fbeaf2,#f7eef8); }
.prism-tabs .tab-publish.selected { background:transparent; }
.prism-tabs .tab-icon image { width:28px; height:28px; }
.prism-tabs .tab-publish .tab-icon { width:36px; height:30px; border-radius:12px; background:#f0eef4; }
.prism-tabs .tab-publish.selected .tab-icon {
 border-color:transparent; background:linear-gradient(148deg,#dc598f,#b02863 64%,#982250);
 box-shadow:inset 0 1px 0 #ffffff67,0 3px 7px #a6336450;
}
