:host{display:block}.curved-tabs{position:fixed;left:0;right:0;bottom:0;height:calc(49px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box;z-index:1000}.tab-curve{position:absolute;left:0;top:-16px;width:100%;height:17px;pointer-events:none}.tab-items{height:49px;display:flex;position:relative;align-items:stretch}.tab-item{width:20%;height:49px;min-height:44px;border:0;border-radius:0;padding:5px 0 2px;margin:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:space-between;overflow:visible;line-height:1.2;font-weight:400}.tab-item::after{border:0}.tab-icon{height:25px;width:28px;position:relative;display:flex;align-items:center;justify-content:center}.tab-icon image{width:24px;height:24px;display:block}.tab-label{font-size:10px;line-height:14px}.tab-publish .tab-icon{height:25px}.tab-publish .tab-icon image{position:absolute;width:32px;height:32px;top:-13px}.tab-badge{position:absolute;left:18px;top:-3px;min-width:16px;height:16px;padding:0 4px;border-radius:10px;background:#FF4D4F;color:#FFFFFF;font-size:11px;line-height:16px;text-align:center;box-sizing:border-box}.large-text .tab-label{font-size:12px}
