:host{display:block}.curved-tabs{position:fixed;left:0;right:0;bottom:0;height:calc(49px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box;z-index:1000}.tab-curve{position:absolute;left:0;top:-16px;width:100%;height:17px;pointer-events:none}.tab-items{height:49px;display:flex;position:relative;align-items:stretch}.tab-item{width:20%;height:49px;min-height:44px;border:0;border-radius:0;padding:5px 0 2px;margin:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:space-between;overflow:visible;line-height:1.2;font-weight:400}.tab-item::after{border:0}.tab-icon{height:25px;width:28px;position:relative;display:flex;align-items:center;justify-content:center}.tab-icon image{width:24px;height:24px;display:block}.tab-label{font-size:10px;line-height:14px}.tab-publish .tab-icon{height:25px}.tab-publish .tab-icon image{position:absolute;width:32px;height:32px;top:-13px}.tab-badge{position:absolute;left:18px;top:-3px;min-width:16px;height:16px;padding:0 4px;border-radius:10px;background:#A13B4B;color:#FFFFFF;font-size:11px;line-height:16px;text-align:center;box-sizing:border-box}.large-text .tab-label{font-size:12px}

.curved-tabs{border-top:1rpx solid var(--border,#E9E6E2);box-shadow:0 -8rpx 28rpx rgba(74,54,65,.035)}.tab-publish .tab-icon{width:44px;height:44px;border-radius:50%;background:var(--surface,#FFFFFF);border:1rpx solid var(--border,#E9E6E2);box-shadow:0 4rpx 18rpx rgba(74,54,65,.1);position:absolute;top:-13px}.tab-publish .tab-icon image{width:24px;height:24px;top:9px}.tab-publish .tab-label{margin-top:auto}.tab-item.selected .tab-label{font-weight:600}.tab-icon image{width:23px;height:23px}
.pearl-sunset-tabs{border-top-color:rgba(255,255,255,.94);backdrop-filter:blur(12px)}.pearl-sunset-tabs .tab-curve{opacity:.82}.pearl-sunset-tabs .tab-publish .tab-icon{background:rgba(255,255,255,.94);border-color:rgba(255,255,255,.98)}
