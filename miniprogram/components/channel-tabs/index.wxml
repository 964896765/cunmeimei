<view class="channel-tabs {{theme==='dark'?'is-dark':''}} {{largeText?'large-text':''}}"><scroll-view class="channel-scroll" scroll-x="true" enhanced="true" show-scrollbar="{{false}}" scroll-into-view="{{value==='all'?'channel-start':'channel-'+value}}" scroll-with-animation="{{!reduceMotion}}"><view class="channel-row" role="tablist"><view id="channel-start" class="channel-edge" aria-hidden="true"></view><button wx:for="{{channels}}" wx:key="id" id="channel-{{item.id}}" class="channel-tab {{value===item.id?'is-selected':''}}" data-type="{{item.id}}" bindtap="select" role="tab" aria-selected="{{value===item.id}}"><image class="channel-icon" src="/assets/icons/channel-{{item.id}}-{{theme==='prism'?'':theme+'-'}}{{value===item.id?'active':'normal'}}.png" aria-hidden="true"/><text>{{item.name}}</text></button><view class="channel-edge" aria-hidden="true"></view></view></scroll-view></view>
