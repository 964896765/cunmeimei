:host { display:block; }
.channel-tabs { height:56px; padding:4px 0; box-sizing:border-box; background:var(--background); }
.channel-scroll { width:100%; height:48px; white-space:nowrap; }
.channel-row { display:flex; align-items:center; justify-content:space-between; min-width:100%; height:48px; padding:0 18rpx; box-sizing:border-box; }
.channel-tab { position:relative; display:flex; align-items:center; justify-content:center; flex-shrink:0; min-width:76rpx; min-height:44px; margin:0; padding:8rpx 13rpx; border:0; border-radius:28rpx; background:transparent; color:var(--ink); font-size:29rpx; font-weight:600; line-height:1.5; }
.channel-tab::after { border:0; }
.channel-tab.is-selected { background:var(--action); color:var(--on-action); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.3); }
.channel-tab.is-selected::before { content:''; position:absolute; width:42rpx; height:4rpx; left:50%; bottom:-10rpx; margin-left:-21rpx; border-radius:6rpx; background:var(--link); }
.channel-icon,.channel-edge { display:none; }
.large-text .channel-row { display:inline-flex; gap:12rpx; }
.large-text .channel-tab { font-size:34rpx; min-width:94rpx; }

.underlined .channel-tab.is-selected { background:transparent; color:var(--link); box-shadow:none; }
.underlined .channel-tab.is-selected::before { bottom:0; height:5rpx; }
