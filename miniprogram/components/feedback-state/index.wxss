:host{display:block}.feedback{padding:40rpx 28rpx;margin:24rpx 0;text-align:center;border:1rpx solid var(--border);border-radius:var(--radius-md,24rpx);background:var(--glass-surface,var(--surface));color:var(--text);line-height:1.75}.state-symbol{width:72rpx;height:72rpx;border-radius:24rpx;background:var(--soft);display:flex;align-items:center;justify-content:center;margin:0 auto 20rpx}.state-mark{width:24rpx;height:28rpx;border:2rpx solid var(--link);border-radius:6rpx;position:relative}.state-mark::after{content:'';position:absolute;left:5rpx;right:5rpx;top:10rpx;border-top:2rpx solid var(--link)}.error .state-symbol{background:var(--danger-soft)}.error .state-mark,.error .state-mark::after{border-color:var(--danger)}.state-heading{font-size:var(--card-title,31rpx);font-weight:600;color:var(--ink);line-height:1.5}.state-description{display:block;margin-top:10rpx;font-size:var(--card-meta,25rpx);white-space:pre-wrap;word-break:break-all}.state-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;margin:24rpx auto 0;padding:14rpx 28rpx;border:1rpx solid var(--border);border-radius:18rpx;background:var(--soft);color:var(--link);font-size:var(--card-meta,25rpx);line-height:1.5}.state-action::after{border:0}.state-action[disabled]{opacity:.55}.compact{display:flex;align-items:center;text-align:left;gap:16rpx;padding:18rpx 22rpx;margin:16rpx 0;border-radius:18rpx}.compact .state-copy{flex:1;min-width:0}.compact .state-description{margin:0}.compact .state-heading{font-size:var(--card-meta,25rpx)}.compact .state-action{flex-shrink:0;margin:0;padding:8rpx 14rpx}.skeleton-list{margin-bottom:24rpx}.skeleton-row{height:26rpx;margin:12rpx 0;border-radius:8rpx;background:var(--border)}.skeleton-row.short{width:64%}.large .state-heading{font-size:38rpx}.large .state-description,.large .state-action{font-size:30rpx}.large.compact{flex-wrap:wrap}
