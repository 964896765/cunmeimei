:host { display:block; }
.feedback { position:relative; overflow:hidden; padding:40rpx 28rpx; margin:24rpx 0; border:1rpx solid var(--border); border-radius:26rpx; background:var(--glass-surface,var(--surface)); box-shadow:var(--elevation); color:var(--text); text-align:center; line-height:1.75; }
.state-symbol { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin:0 auto 20rpx; border-radius:24rpx; background:var(--soft); }
.state-mark { position:relative; width:24rpx; height:28rpx; border:2rpx solid var(--link); border-radius:6rpx; }
.state-mark::after { content:''; position:absolute; left:5rpx; right:5rpx; top:10rpx; border-top:2rpx solid var(--link); }
.error .state-symbol { background:var(--danger-soft); }
.error .state-mark,.error .state-mark::after { border-color:var(--danger); }
.state-heading { color:var(--ink); font-size:var(--card-title,31rpx); font-weight:600; line-height:1.5; }
.state-description { display:block; margin-top:10rpx; font-size:var(--card-meta,25rpx); white-space:pre-wrap; word-break:break-all; }
.state-action { display:inline-flex; align-items:center; justify-content:center; min-height:44px; margin:24rpx auto 0; padding:14rpx 28rpx; border:1rpx solid var(--border); border-radius:18rpx; background:var(--soft); color:var(--link); font-size:var(--card-meta,25rpx); line-height:1.5; }
.state-action::after { border:0; }.state-action[disabled] { opacity:.55; }
.compact { display:flex; align-items:center; gap:16rpx; padding:26rpx 24rpx; margin:16rpx 0; text-align:left; }
.compact .state-copy { flex:1; min-width:0; }
.compact .state-description { margin:8rpx 0 0; }
.compact .state-heading { font-size:28rpx; font-weight:650; }
.compact .state-action { flex-shrink:0; margin:0; padding:8rpx 14rpx; font-weight:600; }
.skeleton-list { margin-bottom:24rpx; }
.skeleton-row { height:26rpx; margin:12rpx 0; border-radius:8rpx; background:var(--border); }
.skeleton-row.short { width:64%; }
.large .state-heading { font-size:38rpx; }
.large .state-description,.large .state-action { font-size:30rpx; }
.large.compact { flex-wrap:wrap; }.large.compact .state-heading { font-size:34rpx; }
.empty-scene { position:absolute; display:block; right:0; bottom:0; width:42%; height:120rpx; opacity:.55; }
.state-copy,.state-symbol,.state-action,.skeleton-list { position:relative; z-index:1; }
