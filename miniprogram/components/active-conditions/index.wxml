<scroll-view wx:if="{{chips.length||hasFilters}}" class="{{horizontal?'condition-scroll-x':'condition-scroll-wrap'}}" scroll-x="{{horizontal}}" show-scrollbar="{{false}}"><view wx:if="{{chips.length||hasFilters}}" class="conditions {{horizontal?'horizontal':''}} {{largeText?'large':''}}"><button wx:for="{{chips}}" wx:key="key" class="condition" data-key="{{item.key}}" bindtap="remove" aria-label="移除{{item.label}}"><text>{{item.label}}</text><text aria-hidden="true">×</text></button><button wx:if="{{hasFilters}}" class="reset" bindtap="reset">重置筛选</button></view></scroll-view>
