<view wx:if="{{open}}" class="sheet-overlay">
 <view class="sheet-scrim" bindtap="close" catchtouchmove="preventScroll"></view>
 <view class="sheet-panel {{structured?'structured-sheet':''}}" role="dialog" aria-modal="true" aria-label="{{label}}">
  <view class="sheet-handle" aria-hidden="true"></view>
  <slot name="header"/>
  <scroll-view class="sheet-content" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><slot/></scroll-view>
  <slot name="footer"/>
 </view>
</view>
