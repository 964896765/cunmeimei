.page-header{position:fixed;z-index:50;top:0;left:0;width:100%;box-sizing:border-box;background:var(--background);color:var(--ink)}
.nav-row{position:relative;display:flex;align-items:center}
.nav-back{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0 0 0 6px;padding:0;border:0;border-radius:0;background:transparent;flex-shrink:0}
.nav-back::after{border:0}
.nav-back-icon{width:12px;height:12px;border-left:2px solid var(--ink);border-bottom:2px solid var(--ink);transform:rotate(45deg)}
.nav-title{position:absolute;text-align:center;font-size:32rpx;font-weight:600;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--ink)}
.header-large-text .nav-title{font-size:38rpx}
.nav-action{position:absolute;top:0;bottom:0;display:flex;align-items:center;justify-content:flex-end;min-width:44px;min-height:44px;margin:0;padding:0 4px;background:transparent;border:0;color:var(--muted);font-size:28rpx;font-weight:400;line-height:1.3}
.nav-action::after{border:0}.header-large-text .nav-action{font-size:32rpx}

.continuous-header{background-color:var(--continuous-header-base,var(--background));background-image:var(--page-wash,none);background-size:100% 900rpx;background-repeat:no-repeat}
.transparent-header{background:transparent;background-image:none}

.page-header{border-bottom:1rpx solid var(--border);background:var(--glass-surface,var(--background))}.continuous-header{background-color:var(--glass-surface,var(--background));background-image:none}.transparent-header{border-bottom-color:transparent}.nav-title{font-weight:600;letter-spacing:.5rpx}.nav-back{border-radius:18rpx}.nav-back:active{background:var(--soft)}
