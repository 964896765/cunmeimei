.page-header { position:fixed; z-index:50; top:0; left:0; width:100%; box-sizing:border-box; border-bottom:0; background-color:var(--background); background-image:var(--page-wash,none); background-size:100% 1600rpx; color:var(--ink); }
.nav-row { position:relative; display:flex; align-items:center; }
.nav-back { display:flex; align-items:center; justify-content:center; width:44px; height:44px; margin:0 0 0 6px; padding:0; border:0; border-radius:12rpx; background:transparent; flex-shrink:0; }
.nav-back::after,.nav-action::after { border:0; }
.nav-back-icon { width:11px; height:11px; border-left:2px solid var(--ink); border-bottom:2px solid var(--ink); transform:rotate(45deg); }
.nav-title { position:absolute; color:var(--ink); font-size:38rpx; font-weight:600; line-height:1.4; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.title-start { text-align:left; }
.logo-title { display:flex; align-items:center; justify-content:center; height:100%; }
.logo-title.title-start { justify-content:flex-start; }
.nav-logo-frame { position:relative; width:var(--header-logo-width,64rpx); height:var(--header-logo-height,64rpx); overflow:hidden; border-radius:18rpx; }
.nav-logo { position:absolute; display:block; width:var(--header-logo-image-width,100%); height:var(--header-logo-image-height,100%); left:var(--header-logo-offset-x,0); top:var(--header-logo-offset-y,0); }
.nav-action { position:absolute; top:0; bottom:0; display:flex; align-items:center; justify-content:flex-end; min-width:44px; min-height:44px; margin:0; padding:0 4px; border:0; background:transparent; color:var(--link); font-size:28rpx; line-height:1.5; }
.nav-back:active,.nav-action:active { opacity:.65; }
.nav-action[disabled] { opacity:.45; }
.header-large-text .nav-title { font-size:40rpx; }
.header-large-text .nav-action { font-size:32rpx; }

.logo-title { gap:16rpx; }
.nav-logo-frame { flex-shrink:0; }
.brand-copy { flex:1; min-width:0; text-align:left; }
.brand-name { font-size:28rpx; font-weight:700; line-height:1.45; white-space:nowrap; }
.brand-subtitle { display:block; margin-top:3rpx; color:var(--muted); font-size:19rpx; font-weight:400; white-space:nowrap; }
@media (min-width:390px) { .brand-name { font-size:30rpx; } .brand-subtitle { font-size:20rpx; } }
.header-large-text .brand-name { font-size:32rpx; }
.header-large-text .brand-subtitle { display:none; }

.header-collapsed .nav-title { visibility:hidden; }
.brand-name { font-size:var(--header-brand-size,28rpx); }
.brand-subtitle { font-size:var(--header-subtitle-size,19rpx); }
@media (min-width:390px) { .brand-name { font-size:var(--header-brand-size,30rpx); } .brand-subtitle { font-size:var(--header-subtitle-size,20rpx); } }
.header-large-text .brand-name { font-size:32rpx; }
.nav-leading { position:absolute; left:16rpx; display:flex; align-items:center; }
