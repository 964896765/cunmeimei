<bottom-sheet open="{{open}}" label="{{title}}">
 <view class="dialog-panel">
  <view class="dialog-title">{{title}}</view>
  <text wx:if="{{description}}" class="dialog-description">{{description}}</text>
  <text wx:if="{{error}}" class="dialog-error" role="alert">{{error}}</text>
  <button class="dialog-confirm" bindtap="confirm" loading="{{busy}}" disabled="{{busy}}">{{confirmText}}</button>
  <button wx:if="{{secondaryText}}" class="dialog-secondary" bindtap="secondary" disabled="{{busy}}">{{secondaryText}}</button>
  <button class="dialog-cancel" bindtap="cancel" disabled="{{busy}}">{{cancelText}}</button>
 </view>
</bottom-sheet>
