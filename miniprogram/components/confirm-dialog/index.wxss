:host { display:block; }
.dialog-title { color:var(--ink); font-size:36rpx; font-weight:600; line-height:1.5; }
.dialog-description,.dialog-error { display:block; margin:16rpx 0 24rpx; color:var(--muted); font-size:28rpx; line-height:1.7; }
.dialog-error { color:var(--danger); }
.dialog-panel button { display:flex; align-items:center; justify-content:center; min-height:96rpx; margin:16rpx 0 0; padding:20rpx; border:0; border-radius:16rpx; font-size:30rpx; line-height:1.5; }
.dialog-panel button::after { border:0; }
.dialog-confirm { background:var(--action); color:var(--on-action); font-weight:600; }
.dialog-secondary { background:var(--soft); color:var(--ink); }
.dialog-cancel { background:transparent; color:var(--link); }
