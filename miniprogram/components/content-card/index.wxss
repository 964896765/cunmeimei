:host { display:block; }
.content-card { display:flex; align-items:center; gap:22rpx; min-height:176rpx; padding:18rpx; margin-bottom:4rpx; border:1rpx solid var(--border); border-radius:24rpx; background:var(--surface); color:var(--text); }
.photo-wrap { position:relative; flex-shrink:0; width:192rpx; height:148rpx; }
.cover { display:block; width:100%; height:100%; border-radius:14rpx; background:var(--soft); }
.photo-count { position:absolute; right:6rpx; bottom:6rpx; padding:0 9rpx; border-radius:8rpx; background:rgba(25,23,28,.72); color:#FFFFFF; font-size:21rpx; line-height:1.6; }
.body { flex:1; min-width:0; }
.card-heading { display:flex; align-items:center; gap:8rpx; min-height:32rpx; margin-bottom:4rpx; }
.category { display:inline-block; max-width:75%; padding:0 10rpx; border-radius:12rpx; background:var(--soft); color:var(--link); font-size:22rpx; line-height:1.5; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.name { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--ink); font-size:var(--card-title,30rpx); font-weight:650; line-height:1.45; }
.meta { margin-top:3rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:var(--muted); font-size:var(--card-meta,26rpx); line-height:1.5; }
.card-footer { display:flex; align-items:baseline; justify-content:space-between; gap:12rpx; min-height:36rpx; margin-top:5rpx; }
.price { color:var(--price); font-size:30rpx; font-weight:650; line-height:1.4; }
.location { margin-left:auto; max-width:60%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:var(--muted); font-size:22rpx; }
.bookable { flex-shrink:0; color:var(--link); font-size:21rpx; }
.save-button { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:44px; height:44px; min-height:44px; margin:-16rpx -12rpx -10rpx auto; padding:0; border:0; background:transparent; color:var(--muted); font-size:44rpx; line-height:1; }
.save-button::after { border:0; }
.is-saved { color:var(--link); }
.image-unavailable { color:var(--muted); font-size:22rpx; margin-top:8rpx; }
.stream,.article { padding:22rpx 0; border-width:0 0 1rpx; border-radius:0; margin-bottom:0; }
.stream .photo-wrap { width:184rpx; height:150rpx; }
.text-led { min-height:140rpx; }
.text-led .body { padding:4rpx 6rpx; }
.merchant { padding:22rpx; margin-bottom:18rpx; }
.merchant .photo-wrap,.service .photo-wrap { width:176rpx; height:176rpx; }
.service { margin-bottom:16rpx; }
.compact { flex-direction:column; align-items:stretch; height:100%; padding:0; margin:0; overflow:hidden; }
.compact .photo-wrap { width:100%; height:230rpx; }
.compact .cover { border-radius:0; }
.compact .body { padding:20rpx; }
.compact .name { font-size:28rpx; }
.compact .card-footer { flex-wrap:wrap; }
.theme-clear { border-color:var(--control-border); }

.discovery { align-items:stretch; gap:18rpx; padding:18rpx; margin-bottom:16rpx; border-color:transparent; border-radius:24rpx; }
.discovery .photo-wrap { width:216rpx; height:auto; min-height:186rpx; overflow:hidden; border-radius:16rpx; }
.discovery .cover { position:absolute; top:0; left:0; height:100%; border-radius:16rpx; }
.photo-category { position:absolute; top:0; left:0; max-width:100%; padding:3rpx 12rpx; border-radius:14rpx 0 12rpx 0; background:var(--action); color:var(--on-action); font-size:22rpx; line-height:1.5; }
.discovery .name { font-size:var(--card-title,30rpx); line-height:1.45; }
.listing-tags { display:flex; flex-wrap:wrap; align-items:center; gap:6rpx 10rpx; margin:8rpx 0; }
.listing-tags .category { max-width:100%; padding:0 10rpx; border-radius:10rpx; }
.listing-tag { padding:0 8rpx; border-radius:6rpx; background:var(--background); color:var(--text); font-size:22rpx; line-height:1.5; }
.listing-summary { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--text); font-size:var(--card-meta,26rpx); line-height:1.5; }
.listing-price { color:var(--price); font-weight:600; }
.listing-footer { display:flex; flex-wrap:wrap; align-items:center; gap:4rpx 10rpx; min-height:48rpx; margin-top:8rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }
.listing-location { flex:1; display:flex; align-items:center; gap:5rpx; min-width:80rpx; }
.listing-location image { flex-shrink:0; width:22rpx; height:26rpx; }
.listing-location text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.listing-time { flex-shrink:0; }
.discovery .save-button { width:44px; height:44px; margin:-10rpx -10rpx -10rpx 0; font-size:36rpx; }
.discovery.text-led .body { padding:0; }
@media (max-width:350px) { .discovery .photo-wrap { width:176rpx; } }
