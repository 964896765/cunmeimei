:host { display:block; }
.content-card { display:flex; align-items:center; gap:24rpx; padding:26rpx; margin-bottom:24rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); }
.cover { flex-shrink:0; width:152rpx; height:152rpx; border-radius:14rpx; background:var(--background); }
.placeholder { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; background:var(--soft); }
.placeholder-icon { width:40rpx; height:40rpx; }
.placeholder text { display:none; }
.body { flex:1; min-width:0; }
.category { margin-bottom:8rpx; color:var(--muted); font-size:24rpx; line-height:1.5; }
.name { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--ink); font-size:var(--card-title,32rpx); font-weight:600; line-height:1.5; }
.meta { margin-top:8rpx; color:var(--muted); font-size:var(--card-meta,26rpx); line-height:1.6; }
.price { margin-top:12rpx; color:var(--price); font-size:32rpx; font-weight:600; }
.arrow { flex-shrink:0; color:var(--muted); font-size:32rpx; }
.bookable { display:inline-block; margin-left:12rpx; padding:3rpx 10rpx; border-radius:6rpx; background:var(--soft); color:var(--link); font-size:24rpx; line-height:1.5; }
.compact { flex-direction:column; align-items:stretch; height:100%; padding:0; margin:0; overflow:hidden; }
.compact .cover { width:100%; height:230rpx; border-radius:0; }
.compact .placeholder { height:72rpx; }
.compact .body { padding:24rpx; }
.compact .arrow { display:none; }
.stream { margin-bottom:24rpx; padding:26rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); color:var(--text); }
.stream-heading { display:flex; align-items:center; gap:10rpx; color:var(--muted); font-size:24rpx; line-height:1.5; }
.stream-heading image { flex-shrink:0; width:30rpx; height:30rpx; }
.stream-region { margin-left:auto; max-width:40%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.stream-main { display:flex; align-items:flex-start; gap:24rpx; margin-top:20rpx; }
.stream-copy { flex:1; min-width:0; }
.stream-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--ink); font-size:var(--card-title,32rpx); font-weight:600; line-height:1.5; }
.stream-meta { margin-top:12rpx; color:var(--muted); font-size:var(--card-meta,26rpx); line-height:1.6; }
.stream-photo-wrap { position:relative; flex-shrink:0; width:160rpx; height:160rpx; }
.stream-photo { display:block; width:100%; height:100%; border-radius:14rpx; }
.photo-count { position:absolute; right:8rpx; bottom:8rpx; padding:2rpx 8rpx; border-radius:6rpx; background:rgba(36,35,41,.74); color:#FFFFFF; font-size:22rpx; }
.stream-image-fallback { padding:16rpx 0; color:var(--muted); font-size:24rpx; }
.stream-footer { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:24rpx; }
.stream-footer-copy { display:flex; align-items:baseline; flex-wrap:wrap; gap:16rpx; }
.stream-price { color:var(--price); font-size:30rpx; font-weight:600; }
.stream-date { color:var(--muted); font-size:24rpx; }
.stream-save { flex-shrink:0; display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:12rpx 8rpx; margin:0; border:0; border-radius:12rpx; background:transparent; color:var(--link); font-size:26rpx; line-height:1.5; }
.stream-save::after { border:0; }
.is-saved { background:var(--soft); }
.merchant .stream-main { flex-direction:column-reverse; gap:20rpx; }
.merchant .stream-photo-wrap { width:100%; height:260rpx; }
.merchant .stream-title { font-size:34rpx; }
.service .stream-photo-wrap { width:176rpx; height:176rpx; }
.article { border-width:0 0 1rpx; border-radius:0; padding:28rpx 0; background:transparent; }
.article .stream-photo-wrap { width:136rpx; height:136rpx; }
.theme-clear { border-color:var(--control-border); }
