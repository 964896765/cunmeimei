<view class="content-card {{layout}} theme-{{theme}} type-{{item.type}} kind-{{item.kind}} {{compact?'compact':''}} {{item.cover&&!coverFailed?'has-photo':'text-led'}}" bindtap="open" role="button" aria-label="{{item.category}}，{{item.title}}，{{item.district}}">
 <view wx:if="{{item.cover&&!coverFailed}}" class="photo-wrap"><image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load="true" binderror="imageError" catchtap="preview" aria-label="查看信息图片"/><text wx:if="{{item.images.length>1}}" class="photo-count">▧ {{item.images.length}}</text></view>
 <view class="body"><view class="card-heading"><text class="category">{{item.category}}</text><text wx:if="{{item.kind==='service'}}" class="bookable">可预约</text><button wx:if="{{layout==='stream'||layout==='merchant'||layout==='service'||layout==='article'}}" class="save-button {{item.isSaved?'is-saved':''}}" catchtap="favorite" aria-pressed="{{item.favoriteKnown===false?'mixed':!!item.isSaved}}" aria-label="{{item.favoriteKnown===false?'核对收藏状态':item.isSaved?'取消收藏':'收藏信息'}}"><text>{{item.isSaved?'♥':'♡'}}</text></button></view>
  <view class="name">{{item.title}}</view><view wx:if="{{item.meta}}" class="meta">{{item.meta}}</view><view wx:elif="{{item.description}}" class="meta">{{item.description}}</view>
  <view wx:if="{{coverFailed}}" class="image-unavailable">图片暂不可用，仍可查看信息详情</view>
  <view class="card-footer"><text class="price">{{item.priceText}}</text><text class="location">{{distanceText||item.district||item.locationText}}</text></view>
 </view>
</view>
