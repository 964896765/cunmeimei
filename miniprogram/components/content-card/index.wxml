<view class="content-card {{layout}} theme-{{theme}} type-{{item.type}} kind-{{item.kind}} {{compact?'compact':''}} {{item.cover&&!coverFailed?'has-photo':'text-led'}}" bindtap="open" role="button" aria-label="{{item.category}}，{{item.title}}，{{item.district}}">
 <view wx:if="{{item.cover&&!coverFailed}}" class="photo-wrap"><image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load="true" binderror="imageError" catchtap="preview" aria-label="查看信息图片"/><text wx:if="{{item.images.length>1}}" class="photo-count">▧ {{item.images.length}}</text></view>
 <view wx:if="{{layout==='discovery'}}" class="body discovery-body">
  <view class="listing-heading"><view class="name">{{item.title}}</view><button class="save-button {{item.isSaved?'is-saved':''}}" catchtap="favorite" disabled="{{item.favoriteBusy}}" aria-pressed="{{item.favoriteKnown===false?'mixed':!!item.isSaved}}" aria-label="{{item.favoriteKnown===false?'核对收藏状态':item.isSaved?'取消收藏':'收藏信息'}}"><text>{{item.isSaved?'♥':'♡'}}</text></button></view>
  <text wx:if="{{salary||item.priceText}}" class="listing-price">{{salary||item.priceText}}</text>
  <view wx:elif="{{item.description||item.detail}}" class="listing-summary">{{item.description||item.detail}}</view>
  <view wx:if="{{listingCategory||listingTags.length||item.kind==='service'}}" class="listing-tags"><text wx:if="{{!listingTags.length&&listingCategory}}" class="category">{{listingCategory}}</text><text wx:for="{{listingTags}}" wx:key="*this" class="listing-tag">{{item}}</text><text wx:if="{{item.kind==='service'}}" class="bookable">可预约</text></view>
  <view wx:if="{{coverFailed}}" class="image-unavailable">图片暂不可用，可查看详情</view>
  <view class="listing-footer"><view wx:if="{{distanceText||item.locationText||item.district}}" class="listing-location"><image src="/assets/icons/location-{{iconPalette}}.png" mode="aspectFit" aria-hidden="true"/><text>{{item.district||item.locationText}}{{(item.district||item.locationText)&&distanceText?' · ':''}}{{distanceText}}</text></view><text wx:if="{{publicationTime}}" class="listing-time">{{publicationTime}}</text></view>
 </view>
 <view wx:else class="body"><view class="card-heading"><text class="category">{{layout==='home-list'?listingCategory:item.category}}</text><view wx:if="{{layout==='home-list'}}" class="name">{{item.title}}</view><text wx:if="{{item.kind==='service'}}" class="bookable">可预约</text><button wx:if="{{layout==='home-list'||layout==='stream'||layout==='merchant'||layout==='service'||layout==='article'}}" class="save-button {{item.isSaved?'is-saved':''}}" catchtap="favorite" disabled="{{item.favoriteBusy}}" aria-pressed="{{item.favoriteKnown===false?'mixed':!!item.isSaved}}" aria-label="{{item.favoriteKnown===false?'核对收藏状态':item.isSaved?'取消收藏':'收藏信息'}}"><text>{{item.isSaved?'♥':'♡'}}</text></button></view>
  <view wx:if="{{layout!=='home-list'}}" class="name">{{item.title}}</view>
  <view wx:if="{{layout==='home-list'}}" class="meta">{{item.district||item.locationText}}{{(item.district||item.locationText)&&(item.meta||item.description)?' · ':''}}{{item.meta||item.description}}</view>
  <view wx:elif="{{item.meta}}" class="meta">{{item.meta}}</view><view wx:elif="{{item.description}}" class="meta">{{item.description}}</view>
  <view wx:if="{{coverFailed}}" class="image-unavailable">图片暂不可用，仍可查看信息详情</view>
  <view wx:if="{{layout!=='home-list'||item.priceText||salary||publicationTime}}" class="card-footer"><text class="price">{{layout==='home-list'?(salary||item.priceText):item.priceText}}</text><text class="location">{{layout==='home-list'?publicationTime:distanceText||item.district||item.locationText}}</text></view>
 </view>
</view>
