<view class="upload-progress" role="status" aria-live="polite"><view class="upload-copy"><text>{{busy?'正在上传照片':error?'照片上传需要重试':'已添加 '+count+' / '+limit+' 张照片'}}</text><text wx:if="{{busy}}">请稍候</text></view><view wx:if="{{busy}}" class="upload-track"><view class="upload-fill" style="width:{{count/limit*100}}%"></view></view><text wx:if="{{error}}" class="upload-error">{{error}}</text></view>
