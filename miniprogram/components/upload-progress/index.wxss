:host{display:block}.upload-progress{padding:14rpx 0;color:var(--muted);font-size:var(--card-meta,25rpx);line-height:1.6}.upload-copy{display:flex;justify-content:space-between;gap:16rpx}.upload-track{height:8rpx;border-radius:8rpx;background:var(--border);margin-top:14rpx;overflow:hidden}.upload-fill{height:100%;min-width:8rpx;background:var(--link);border-radius:8rpx}.upload-error{display:block;color:var(--danger);margin-top:10rpx}
