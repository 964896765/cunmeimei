<view class="search-bar {{readonly?'readonly':''}}" bindtap="activate" role="{{readonly?'button':'search'}}" aria-label="{{placeholder}}"><view class="search-symbol" aria-hidden="true"></view><text wx:if="{{readonly}}" class="placeholder">{{placeholder}}</text><input wx:else value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}" focus="{{focused}}" maxlength="{{maxLength}}" bindinput="input" bindconfirm="search" confirm-type="search" aria-label="{{placeholder}}"/><view wx:if="{{readonly&&framed}}" class="search-frame" aria-hidden="true"><view class="frame-corner"/><view class="frame-corner"/><view class="frame-corner"/><view class="frame-corner"/></view><button wx:if="{{value&&!readonly}}" class="clear" bindtap="clear" disabled="{{disabled}}" aria-label="清空搜索">×</button><button wx:if="{{!readonly&&showSubmit}}" class="submit" bindtap="search" disabled="{{disabled}}">{{label}}</button></view>
