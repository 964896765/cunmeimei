<view class="search-bar {{readonly?'readonly':''}}" bindtap="activate" role="{{readonly?'button':'search'}}" aria-label="{{placeholder}}"><view class="search-symbol" aria-hidden="true"></view><text wx:if="{{readonly}}" class="placeholder">{{placeholder}}</text><input wx:else value="{{value}}" placeholder="{{placeholder}}" disabled="{{disabled}}" focus="{{focused}}" maxlength="{{maxLength}}" bindinput="input" bindconfirm="search" confirm-type="search" aria-label="{{placeholder}}"/><button wx:if="{{value&&!readonly}}" class="clear" bindtap="clear" aria-label="清空搜索">×</button><button wx:if="{{!readonly}}" class="submit" bindtap="search" disabled="{{disabled}}">{{label}}</button></view>
