:host{display:block}.privacy-mask{display:flex;align-items:center;gap:18rpx;padding:20rpx 22rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--soft);color:var(--text)}.privacy-symbol{width:26rpx;height:30rpx;flex-shrink:0;border:2rpx solid var(--link);border-radius:14rpx 14rpx 12rpx 12rpx}.privacy-copy{flex:1;min-width:0}.privacy-label,.privacy-description{display:block;font-size:var(--card-meta,25rpx);line-height:1.6}.privacy-description{color:var(--muted);margin-top:4rpx}.privacy-mask button{min-width:44px;min-height:44px;padding:8rpx 0;margin:0;border:0;background:transparent;color:var(--link);font-size:var(--card-meta,25rpx)}.privacy-mask button::after{border:0}
