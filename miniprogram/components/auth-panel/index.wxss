:host{display:block}.auth-panel{padding:90rpx 36rpx 40rpx;box-sizing:border-box;text-align:center;color:var(--ink)}.brand{font-size:46rpx;font-weight:600;letter-spacing:3rpx;line-height:1.5}.intro{font-size:30rpx;color:var(--muted);margin-top:18rpx}.purpose{font-size:27rpx;color:var(--muted);line-height:1.7;margin:52rpx 0 36rpx}.wechat-button{background:var(--action);color:var(--on-action);font-size:31rpx;line-height:1.5;min-height:96rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;padding:24rpx 20rpx;font-weight:600}.wechat-button::after,.guest-button::after,.legal-link::after{border:0}.wechat-button.is-disabled{background-color:var(--soft)!important;color:var(--muted)!important}.guest-button{color:var(--link);background:transparent;font-size:28rpx;line-height:1.5;min-height:96rpx;padding:24rpx 12rpx;margin:14rpx 0 30rpx}.agreement{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:0 8rpx;font-size:24rpx;line-height:1.8;color:var(--muted)}.agreement label{display:flex;align-items:center;min-height:88rpx}.agreement checkbox{transform:scale(.82);margin-right:4rpx}.legal-link{display:inline-flex;align-items:center;justify-content:center;min-height:88rpx;padding:12rpx 0;margin:0;background:transparent;color:var(--link);font-size:24rpx;line-height:1.8}.feedback{color:var(--danger);font-size:26rpx;line-height:1.7;margin-bottom:24rpx}.large-text .brand{font-size:50rpx}.large-text .intro,.large-text .purpose,.large-text .guest-button,.large-text .agreement,.large-text .legal-link{font-size:30rpx}.large-text .wechat-button{font-size:36rpx}.large-text .feedback{font-size:30rpx}
