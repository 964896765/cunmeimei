<view class="auth-panel {{largeText?'large-text':''}}">
 <view class="auth-brand"><view class="auth-logo-frame"><image class="auth-logo" src="/assets/brand-butterfly-transparent.png" mode="aspectFill"/></view><view class="brand">青方睐村美美</view><view class="intro">身边生活 · 简单相遇</view></view>
 <view class="login-card">
  <view class="login-heading">微信快捷登录</view>
  <view wx:if="{{reason&&reason!=='登录后继续刚才的操作'&&reason!=='微信登录后继续'}}" class="purpose">{{reason}}</view>
  <button id="wechat-login" class="wechat-button {{busy||!agreed||!docs.configured||!docs.wechatAvailable?'is-disabled':''}}" disabled="{{busy||!agreed||!docs.configured||!docs.wechatAvailable}}" loading="{{busy}}" open-type="{{needPrivacy?'agreePrivacyAuthorization':''}}" bindtap="login" bindagreeprivacyauthorization="privacyAgreed"><view class="wechat-mark" aria-hidden="true"><view></view><view></view></view><text>{{busy?'正在登录…':'微信一键登录'}}</text></button>
  <view wx:if="{{error}}" class="login-feedback" role="status">{{error}}</view>
  <view class="login-benefits"><view><view class="benefit-icon"><image src="/assets/icons/center-privacy-{{iconPalette}}.png"/></view><text>安全快捷</text></view><view><view class="benefit-icon"><image src="/assets/icons/nav-me-{{iconPalette}}.png"/></view><text>自主授权</text></view><view><view class="benefit-icon"><view class="privacy-lock" aria-hidden="true"></view></view><text>保护隐私</text></view></view>
 </view>
 <button class="guest-button" bindtap="guest">游客浏览<text aria-hidden="true">›</text></button>
 <view class="agreement"><checkbox-group bindchange="agreement"><label><checkbox value="consent" checked="{{agreed}}" color="{{themeColor}}" aria-label="已阅读并同意用户协议和隐私政策"/>我已阅读并同意</label></checkbox-group><button class="legal-link" data-kind="terms" bindtap="legal">《用户协议》</button><text>和</text><button class="legal-link" data-kind="privacy" bindtap="legal">《隐私政策》</button></view>
</view>
