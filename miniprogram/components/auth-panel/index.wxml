<view class="auth-panel {{largeText?'large-text':''}}"><view class="brand">青方睐村美美</view><view class="intro">身边生活，简单相遇</view><view class="purpose">{{reason||'登录后继续刚才的操作，或先随意逛逛。'}}</view><feedback-state wx:if="{{error}}" kind="error" compact="{{true}}" description="{{error}}" large-text="{{largeText}}"/><button id="wechat-login" class="wechat-button {{busy||!agreed||!docs.configured||!docs.wechatAvailable?'is-disabled':''}}" disabled="{{busy||!agreed||!docs.configured||!docs.wechatAvailable}}" loading="{{busy}}" open-type="{{needPrivacy?'agreePrivacyAuthorization':''}}" bindtap="login" bindagreeprivacyauthorization="privacyAgreed">{{busy?'正在登录…':'微信快捷登录'}}</button><button class="guest-button" bindtap="guest">先以游客身份浏览</button><view class="agreement"><checkbox-group bindchange="agreement"><label><checkbox value="consent" checked="{{agreed}}" color="{{themeColor}}" aria-label="已阅读并同意用户协议和隐私政策"/>我已阅读并同意</label></checkbox-group><button class="legal-link" data-kind="terms" bindtap="legal">《用户协议》</button><button class="legal-link" data-kind="privacy" bindtap="legal">《隐私政策》</button></view></view>
