<view class="auth-panel {{largeText?'large-text':''}} {{mode==='sms'&&docs.smsAvailable?'is-sms':''}}">
 <view class="auth-brand"><view class="auth-logo-frame"><image class="auth-logo" src="/assets/brand-butterfly-transparent.png" mode="aspectFill"/></view><view class="brand">青方睐村美美</view><view class="intro">身边生活 · 简单相遇</view></view>
 <view class="login-card">
  <view wx:if="{{docs.smsAvailable}}" class="login-methods" aria-label="登录方式">
   <button class="{{mode==='wechat'?'selected':''}}" data-mode="wechat" bindtap="chooseMode" aria-pressed="{{mode==='wechat'}}">微信登录</button>
   <button class="{{mode==='sms'?'selected':''}}" data-mode="sms" bindtap="chooseMode" aria-pressed="{{mode==='sms'}}">短信登录</button>
  </view>
  <view wx:else class="login-heading">微信快捷登录</view>
  <view wx:if="{{reason&&reason!=='登录后继续刚才的操作'&&reason!=='微信登录后继续'}}" class="purpose">{{reason}}</view>
  <view class="agreement"><checkbox-group bindchange="agreement"><label><checkbox value="consent" checked="{{agreed}}" color="{{themeColor}}" aria-label="已阅读并同意用户协议和隐私政策"/>我已阅读并同意</label></checkbox-group><button class="legal-link" data-kind="terms" bindtap="legal">《用户协议》</button><text>和</text><button class="legal-link" data-kind="privacy" bindtap="legal">《隐私政策》</button></view>
  <block wx:if="{{mode==='sms'&&docs.smsAvailable}}">
   <view class="sms-login-note">首次验证会在当前微信身份下注册并绑定手机号。已有用户会进入原账号，号码默认不公开。</view>
   <button wx:if="{{needPrivacy}}" class="sms-privacy-button" disabled="{{!agreed||busy}}" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="smsPrivacyAgreed">确认微信隐私授权</button>
   <sms-code-form id="sms-login-form" purpose="signin" docs="{{docs}}" enabled="{{agreed&&!needPrivacy&&docs.configured}}" busy="{{busy}}" large-text="{{largeText}}" bind:confirm="smsLogin"/>
  </block>
  <button wx:else id="wechat-login" class="wechat-button {{busy||!agreed||!docs.configured||!docs.wechatAvailable?'is-disabled':''}}" disabled="{{busy||!agreed||!docs.configured||!docs.wechatAvailable}}" loading="{{busy}}" open-type="{{needPrivacy?'agreePrivacyAuthorization':''}}" bindtap="login" bindagreeprivacyauthorization="privacyAgreed"><view class="wechat-mark" aria-hidden="true"><view></view><view></view></view><text>{{busy?'正在登录…':'微信一键登录'}}</text></button>
  <view wx:if="{{docs.configured&&!docs.smsAvailable}}" class="sms-availability">短信登录暂不可用</view>
  <view wx:if="{{error}}" class="login-feedback" role="status">{{error}}</view>
  <view wx:if="{{mode!=='sms'||!docs.smsAvailable}}" class="login-benefits"><view><view class="benefit-icon"><image src="/assets/icons/center-privacy-{{iconPalette}}.png"/></view><text>安全快捷</text></view><view><view class="benefit-icon"><image src="/assets/icons/nav-me-{{iconPalette}}.png"/></view><text>自主授权</text></view><view><view class="benefit-icon"><view class="privacy-lock" aria-hidden="true"></view></view><text>保护隐私</text></view></view>
 </view>
 <button class="guest-button" bindtap="guest">游客浏览<text aria-hidden="true">›</text></button>
</view>
