:host { display:block; min-width:0; }
.browse-filters {
 display:grid;
 grid-template-columns:minmax(0,1fr) minmax(0,1fr);
 gap:8rpx;
 margin:0;
}
.choice {
 box-sizing:border-box;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:8rpx;
 min-height:88rpx;
 padding:10rpx 12rpx;
 color:var(--muted);
 background:transparent;
 border:0;
 border-radius:12rpx;
 font-size:26rpx;
 line-height:1.5;
}
.choice text:first-child {
 min-width:0;
 overflow:hidden;
 white-space:nowrap;
 text-overflow:ellipsis;
}
.choice.selected { color:var(--link); font-weight:600; }
.chevron { flex-shrink:0; font-size:24rpx; }
.large .choice { font-size:31rpx; min-height:96rpx; }
