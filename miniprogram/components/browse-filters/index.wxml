<view class="browse-filters {{largeText?'large':''}}"><picker id="browse-category" mode="multiSelector" range="{{columns}}" range-key="name" value="{{value}}" disabled="{{disabled}}" bindcolumnchange="column" bindchange="selectCategory" bindcancel="cancel"><view class="choice {{categoryId?'selected':''}}" aria-label="筛选行业及项目"><text>{{categoryLabel}}</text><text class="chevron">⌄</text></view></picker><picker id="browse-district" range="{{districts}}" range-key="name" value="{{districtIndex}}" disabled="{{disabled||!cityCode}}" bindchange="selectDistrict"><view class="choice {{districtCode?'selected':''}}" aria-label="筛选区县或街镇"><text>{{cityCode?districtLabel:'先选择城市'}}</text><text class="chevron">⌄</text></view></picker></view>
