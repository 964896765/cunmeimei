:host { display:block; }
.catalog-image { display:block; width:100%; height:100%; }
.catalog-image.muted { filter:grayscale(1); }
.missing-art { display:flex; align-items:center; justify-content:center; width:100%; height:100%; }
.missing-art>view { width:34%; height:34%; border:2rpx solid var(--muted,#777); border-radius:12rpx; }
