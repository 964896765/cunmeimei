<view class="theme-root me-root continuous-page {{pageCompact?'profile-compact':''}} {{themeClass}}" style="{{themeStyle}};{{layoutStyle}}">
<page-header id="navigation-header" bind:measure="headerMeasured" continuous="{{true}}" title="{{mode==='main'?'我的':mode==='profile'?'个人资料':mode==='points'?'积分中心':mode==='service'?'服务中心':mode==='saved'?'我的收藏':mode==='history'?'浏览记录':mode==='account'?'账号与安全':mode==='help'?'帮助与反馈':mode==='about'?'关于小程序':settingsTitle}}" back="{{mode!=='main'}}" large-text="{{displayPreferences.largeText}}" bind:back="back"/>
<view class="container me-page">
 <block wx:if="{{mode==='privacy'}}">
 <view wx:if="{{settingsError}}" class="settings-error" role="alert">{{settingsError}}<button class="center-link" bindtap="reloadSettings">重新读取</button></view>
 <view wx:if="{{settingsBusy}}" class="notice">正在处理…</view>
 <block wx:if="{{settingsSection==='privacy'}}">
 <view class="section-card preference-panel"><view class="settings-row"><view><text class="settings-label">显示主题</text><text class="notice">保留你的选择，不按个人生活状态推断</text></view><picker disabled="{{settingsBusy}}" range="{{themeNames}}" bindchange="selectTheme"><view class="link">选择 ›</view></picker></view>
 <view class="notice">当前：{{preferences.theme==='prism'?'VM 经典':preferences.theme==='dark'?'深海夜色':preferences.theme==='clear'?'清晰高对比':preferences.theme==='quiet'?'静谧灰墨':preferences.theme==='warm'?'温暖关怀':'柔和中性'}}</view>
 <view class="settings-row"><text class="settings-label">大字阅读</text><switch color="{{themeColor}}" disabled="{{settingsBusy}}" checked="{{preferences.largeText}}" data-field="largeText" bindchange="changePreference" aria-label="大字阅读"/></view>
 <view class="settings-row"><text class="settings-label">减少动态效果</text><switch color="{{themeColor}}" disabled="{{settingsBusy}}" checked="{{preferences.reduceMotion}}" data-field="reduceMotion" bindchange="changePreference" aria-label="减少动态效果"/></view>
 <button class="btn" loading="{{settingsBusy}}" disabled="{{settingsBusy||!!settingsError}}" bindtap="savePreferences">保存显示设置</button></view>
 <view class="section-card"><view class="section-title">公开范围</view><view class="notice">个人简介与所在城市仅在本账号资料页使用，不自动生成公开主页或地图点位。发布内容和联系方式继续按原有审核与联系授权规则展示。</view></view>
 <view class="section-card"><view class="section-title">黑名单</view><view class="notice">已屏蔽的用户无法再向你发起联系申请。</view><view wx:if="{{!settingsBusy&&!settingsError&&!blockedItems.length}}" class="notice">暂无屏蔽记录</view><view class="settings-row" wx:for="{{blockedItems}}" wx:key="id"><view><text class="settings-label">{{item.label}}</text><text class="notice">{{item.dateLabel}}</text></view><button class="center-link" disabled="{{settingsBusy}}" bindtap="unblockUser" data-id="{{item.id}}">解除屏蔽</button></view></view>
 </block>
 <block wx:elif="{{settingsSection==='notifications'}}">
 <view class="section-card"><view class="settings-row"><view><text class="settings-label">接收新的联系申请</text><text class="notice">关闭不影响处理已有申请</text></view><switch color="{{themeColor}}" disabled="{{settingsBusy}}" checked="{{preferences.allowContacts}}" data-field="allowContacts" bindchange="changePreference" aria-label="接收新的联系申请"/></view>
 <view class="settings-row"><view><text class="settings-label">显示通知摘要</text><text class="notice">关闭后，服务器隐藏站内通知标题与摘要</text></view><switch color="{{themeColor}}" disabled="{{settingsBusy}}" checked="{{preferences.notificationPreview}}" data-field="notificationPreview" bindchange="changePreference" aria-label="显示通知摘要"/></view>
 <view class="settings-row"><view><text class="settings-label">预约与审核通知</text><text class="notice">保留必要的站内业务通知，暂不支持单独关闭</text></view></view>
 <view class="settings-row"><view><text class="settings-label">微信订阅提醒</text><text class="notice">暂未接通，不会自动申请微信订阅授权</text></view><text class="center-subtitle">未开放</text></view>
 <button class="btn" loading="{{settingsBusy}}" disabled="{{settingsBusy||!!settingsError}}" bindtap="savePreferences">保存通知设置</button></view>
 </block>
 <block wx:elif="{{settingsSection==='data'}}"> <view class="section-card"><view class="section-title">数据申请与处理记录</view><view class="notice">可导出本人资料和本人创作内容，或申请更正、删除与账号注销。注销需单独确认并人工执行；必要账本、审核与业务证据仍保留。不要填写身份证、病历或其他无关敏感资料。</view><button class="btn light" bindtap="exportPersonalData" disabled="{{settingsBusy}}">导出我的数据</button><view class="notice">导出文件临时生成，由你选择保存方式；完成或取消后清理临时文件。</view><picker range="{{requestNames}}" value="{{requestKindIndex}}" bindchange="requestKind"><view class="field">{{requestNames[requestKindIndex]}} ⌄</view></picker><textarea class="field-area" maxlength="500" value="{{requestText}}" bindinput="requestReason" placeholder="请说明请求范围，8–500字；无需提交证件或健康资料" aria-label="个人数据请求范围"/><button class="btn light" bindtap="submitPrivacyRequest" disabled="{{settingsBusy}}">提交请求</button>
 <view class="privacy-record" wx:for="{{privacyItems}}" wx:key="id"><view class="row"><text class="section-title">{{item.kindLabel}}</text><status-badge   label="{{item.statusLabel}}"/></view><view class="body-copy">{{item.reason}}</view><view wx:if="{{item.response}}" class="notice">处理答复：{{item.response}}</view><text wx:if="{{item.status==='pending'||item.status==='reviewing'}}" class="link" data-id="{{item.id}}" bindtap="cancelPrivacyRequest">撤回请求</text></view></view>
 </block>
 </block><block wx:elif="{{mode==='saved'}}"><view class="notice">已结束或暂不可见的内容不会公开展示。</view><content-card id="saved-content-{{item.id}}" layout="discovery" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" wx:for="{{items}}" wx:key="id" item="{{item}}" bind:open="openSaved" bind:favorite="removeSaved"/><feedback-state wx:if="{{loading}}" kind="loading" description="正在加载收藏…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/><feedback-state wx:elif="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重试" bind:action="loadSaved"/><feedback-state wx:elif="{{!items.length}}" kind="empty" title="还没有可查看的收藏" description="发现喜欢的信息后，点亮收藏即可在这里找到。" action-text="去发现" bind:action="goDiscover"/><button id="saved-more" wx:if="{{hasMore}}" class="btn light" bindtap="loadSaved">继续加载</button></block>
 <block wx:elif="{{mode==='points'}}"><include src="./points-panel.wxml"/></block>
 <block wx:elif="{{mode==='history'}}"><view class="notice">记录只保存在当前账号的本机，最多30条。已下架内容不会展示。</view><content-card theme="{{displayPreferences.theme}}" icon-palette="{{iconPalette}}" wx:for="{{items}}" wx:key="id" item="{{item}}" bind:open="openSaved"/><feedback-state wx:if="{{loading}}" kind="loading" description="正在读取…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/><feedback-state wx:elif="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重试" bind:action="showHistory"/><feedback-state wx:elif="{{!items.length}}" kind="empty" title="暂无浏览记录" description="浏览过且仍公开的信息会显示在这里。" action-text="去发现" bind:action="goDiscover"/><button wx:if="{{items.length}}" class="btn light" disabled="{{loading}}" bindtap="clearHistory">清空本机记录</button></block>

 <block wx:elif="{{mode==='profile'}}">
 <button class="avatar-editor" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileBusy||summaryLoading||!!summaryError}}" aria-label="更换头像"><view class="profile-avatar avatar-large"><image wx:if="{{avatarSrc}}" src="{{avatarSrc}}" mode="aspectFill"/><image wx:else class="avatar-placeholder" src="/assets/icons/center-profile-{{iconPalette||'prism'}}.png"/></view><text>{{profileBusy?'正在保存…':'更换头像'}}</text></button>
 <view wx:if="{{summaryError||profileError}}" class="settings-error" role="alert">{{profileError||summaryError}}<button wx:if="{{summaryError}}" class="center-link" bindtap="refresh">重新读取资料</button></view>
 <button wx:if="{{avatarError}}" class="center-link" bindtap="retryAvatar">{{avatarError}}</button>
 <view class="profile-fields">
 <button class="profile-field" bindtap="editProfileField" data-field="displayName" disabled="{{profileBusy||summaryLoading||!!summaryError}}"><text class="profile-field-label">昵称</text><text class="profile-field-value">{{displayName}}</text><text class="center-chevron">›</text></button>
 <button class="profile-field" bindtap="editProfileField" data-field="bio" disabled="{{profileBusy||summaryLoading||!!summaryError}}"><text class="profile-field-label">个人简介</text><text class="profile-field-value">{{bio||'未填写'}}</text><text class="center-chevron">›</text></button>
 <button class="profile-field" bindtap="selectProfileCity" disabled="{{profileBusy||summaryLoading||!!summaryError}}"><text class="profile-field-label">所在城市</text><text class="profile-field-value">{{profileCityName||'未设置'}}</text><text class="center-chevron">›</text></button>
 </view>
 <view class="profile-footnote">个人资料不会自动公开；所在城市不影响浏览城市与发布地址。</view>
 </block>
 <block wx:elif="{{mode==='service'}}">
  <view class="support-hero">
   <brand-scene class="support-hero-scene"/>
   <view class="support-hero-copy"><view class="support-title">经营与业务办理</view><text class="center-subtitle">管理入驻、资质与业务申请</text></view>
  </view>
  <view class="support-section">
   <view class="support-section-title">经营与认证</view>
   <view class="support-list">
    <button id="service-merchant" class="support-row" data-section="merchant" bindtap="openServiceSection"><image src="/assets/icons/center-merchant-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/><view class="support-row-copy"><text>商家入驻与管理</text><text>{{hasSession?merchantLabel:'提交主体资料，管理已入驻商家'}}</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
    <button id="service-credentials" class="support-row" data-section="credentials" bindtap="openServiceSection"><image src="/assets/icons/center-data-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/><view class="support-row-copy"><text>行业核验</text><text>查看项目资质要求与核验进度</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
    <button class="support-row" data-section="verification" bindtap="openServiceSection"><image src="/assets/icons/center-privacy-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/><view class="support-row-copy"><text>账号验证</text><text>查看手机号验证、撤回及处置申诉</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   </view>
  </view>
  <view class="support-section"><view class="support-section-title">业务与申请</view><view class="hub-actions service-hub-actions">
   <button id="service-cases" data-section="cases" bindtap="openServiceSection">业务进度<text>约定、完成与争议</text></button>
   <button id="service-business" data-section="mine" bindtap="openServiceSection">我的业务<text>草稿、审核与展示</text></button>
   <button data-section="sent" bindtap="openServiceSection">我的申请<text>咨询、报名与岗位</text></button>
   <button data-section="received" bindtap="openServiceSection">收到的申请<text>处理、答复与会话</text></button>
   <button data-section="reports" bindtap="openServiceSection">举报与答复<text>查看核查与处理结果</text></button>
  </view></view>
  <button class="btn support-primary" bindtap="goPublish">发布新内容</button>
 </block>
 <block wx:elif="{{mode==='account'}}">
 <view class="section-card account-panel">
 <button wx:if="{{hasSession}}" class="center-menu-row" bindtap="copyId" disabled="{{!myUserId}}"><view class="center-menu-copy"><text>账号编号</text><text class="account-id">{{myUserId||'正在读取…'}}</text><text class="center-subtitle">点击复制，仅向可信的主体管理员提供</text></view><text class="center-chevron">›</text></button>
 <view class="settings-row"><text class="settings-label">登录身份</text><text class="center-subtitle">{{hasSession?(loginIdentity||'正在核对…'):'未登录'}}</text></view>
 <button class="center-menu-row" bindtap="openVerification"><view class="center-menu-copy"><text class="settings-label">手机号验证与撤回</text><text class="center-subtitle">单独授权，默认不公开；可查看状态或解除验证</text></view><text class="center-chevron">›</text></button>
 <button id="account-closure" class="center-menu-row" bindtap="openClosure"><view class="center-menu-copy"><text class="settings-label">申请注销账号</text><text class="center-subtitle">在个人数据中提交，先处理未完成业务；退出登录不会注销</text></view><text class="center-chevron">›</text></button>
 </view>
 <button wx:if="{{hasSession}}" id="account-signout" class="signout-action" bindtap="signout" loading="{{signingOut}}" disabled="{{signingOut}}">退出登录</button>
 <button wx:else class="btn" bindtap="signin">登录并开始使用</button>
 </block>
 <block wx:elif="{{mode==='help'}}">
  <view class="support-hero">
   <view class="support-hero-copy"><view class="support-title">问题怎么处理？</view><text class="center-subtitle">查看处理进度、提交个人数据请求或联系运营方</text></view>
   <image class="support-hero-icon" src="/assets/icons/center-help-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/>
  </view>
  <view class="support-section"><view class="support-section-title">办理入口</view><view class="support-list">
   <button class="support-row" bindtap="goMessages"><view class="support-row-copy"><text>通知与处理结果</text><text>查看审核结果、系统通知与会话</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" data-section="reports" bindtap="openServiceSection"><view class="support-row-copy"><text>举报与答复</text><text>查看已提交举报的处理结果</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" bindtap="openPersonalData"><view class="support-row-copy"><text>个人数据申请</text><text>提交查询、更正、删除或注销申请</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" open-type="feedback"><view class="support-row-copy"><text>投诉与建议</text><text>提交使用问题或改进建议</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" bindtap="copySupportContact" data-kind="email"><view class="support-row-copy"><text>联系官方邮箱</text><text>{{officialEmail}}</text></view><text class="support-row-action">复制</text></button>
  </view></view>
  <view class="support-section"><view class="support-section-title">常见问题</view><view class="support-list support-guidance">
   <view><text>如何举报违规信息？</text><text>在对应信息的详情页发起举报。提交后可在「举报与答复」查看处理结果。</text></view>
   <view><text>如何安全联系与交易？</text><text>联系前请核实对方身份与信息，谨慎对待预付要求。如遇骚扰，可在消息中屏蔽。</text></view>
   <view><text>如何申诉？</text><text>账号处置申诉可在「账号与安全」的验证页面提交。积分异议可在积分中心查看明细后申诉。</text></view>
  </view></view>
  <view class="support-section"><view class="support-section-title">平台与规则</view><view class="support-list">
   <button class="support-row" bindtap="showAbout"><view class="support-row-copy"><text>关于小程序</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" data-kind="terms" bindtap="openLegal"><view class="support-row-copy"><text>用户协议</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" data-kind="privacy" bindtap="openLegal"><view class="support-row-copy"><text>隐私政策与微信隐私保护指引</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
  </view></view>
 </block>
 <block wx:elif="{{mode==='about'}}">
  <view class="support-hero about-hero">
   <image class="about-logo" src="/assets/brand-butterfly-transparent.png" mode="aspectFit" aria-hidden="true"/>
   <view class="support-hero-copy"><view class="support-title">青方睐村美美</view><text class="center-subtitle">本地生活信息展示与查询</text></view>
  </view>
  <view class="support-section"><view class="support-section-title">平台与运营</view><view class="support-list support-guidance">
   <view><text>服务范围</text><text>提供招聘求职、房屋租售、二手闲置、本地商家、便民服务等信息的分类浏览、搜索、发布与联系。平台目前不提供在线支付或交易担保。</text></view>
   <view><text>运营主体</text><text>东莞市石排青方睐软件中心（个体工商户）</text></view>
  </view></view>
  <view class="support-section"><view class="support-section-title">官方渠道</view><view class="support-list">
   <button id="official-website" class="support-row" data-kind="website" bindtap="copySupportContact"><view class="support-row-copy"><text>官方网站</text><text>{{officialWebsite}}</text></view><text class="support-row-action">复制网址</text></button>
   <button id="official-email" class="support-row" data-kind="email" bindtap="copySupportContact"><view class="support-row-copy"><text>官方邮箱</text><text>{{officialEmail}}</text></view><text class="support-row-action">复制邮箱</text></button>
   <button class="support-row" bindtap="openPersonalData"><view class="support-row-copy"><text>个人信息请求</text><text>查询、更正、删除与账号注销</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
  </view></view>
  <view class="support-section"><view class="support-section-title">平台规则</view><view class="support-list">
   <button class="support-row" data-kind="terms" bindtap="openLegal"><view class="support-row-copy"><text>用户协议</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
   <button class="support-row" data-kind="privacy" bindtap="openLegal"><view class="support-row-copy"><text>隐私政策与微信隐私保护指引</text></view><text class="center-chevron" aria-hidden="true">›</text></button>
  </view></view>
 </block>
 <block wx:else><view class="main-center">
  <view class="profile-entry" bindtap="{{hasSession?'openProfile':''}}" role="{{hasSession?'button':'group'}}" aria-label="{{hasSession?'查看和编辑个人资料':'欢迎来到村美美'}}">
   <image wx:if="{{iconPalette==='prism'&&!displayPreferences.largeText}}" class="profile-floral" src="/assets/profile-floral.webp" mode="aspectFill" aria-hidden="true"/>
   <view class="profile-avatar"><image wx:if="{{avatarSrc}}" src="{{avatarSrc}}" mode="aspectFill"/><image wx:else class="avatar-placeholder" src="/assets/icons/center-profile-{{iconPalette||'prism'}}.png"/></view>
   <view class="profile-copy"><view class="profile-name">{{hasSession?displayName:'欢迎来到村美美'}}</view><view class="profile-subtitle">{{hasSession?(profileCityName||'查看和编辑个人资料'):'登录后管理您的同城生活'}}</view><button wx:if="{{!hasSession}}" class="btn guest-signin" catchtap="signin">立即登录 <text aria-hidden="true">›</text></button></view><text wx:if="{{hasSession}}" class="center-chevron" aria-hidden="true">›</text>
  </view>
  <feedback-state wx:if="{{summaryError}}" kind="error" description="{{summaryError}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重试" bind:action="refresh"/>
  <view class="workspace-grid">
   <button class="workspace-item posts-entry" bindtap="goPosts" aria-label="我的发布"><image src="/assets/icons/center-posts-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text class="workspace-count">{{postCount===null?'—':postCount}}</text><text class="workspace-label">我的发布</text></button>
   <button class="workspace-item saved-entry" bindtap="showFavorites" aria-label="我的收藏"><image src="/assets/icons/center-saved-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text class="workspace-count">{{favCount===null?'—':favCount}}</text><text class="workspace-label">我的收藏</text></button>
   <button class="workspace-item draft-entry" bindtap="openDrafts" aria-label="草稿箱"><image src="/assets/icons/center-draft-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text class="workspace-count">{{draftCount===null?'—':draftCount}}</text><text class="workspace-label">草稿箱</text></button>
   <button class="workspace-item bookings-entry" bindtap="goBookings" aria-label="我的预约"><image src="/assets/icons/center-booking-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text class="workspace-count">{{bookingCount===null?'—':bookingCount}}</text><text class="workspace-label">我的预约</text></button>
  </view>
  <view class="profile-feature-grid">
   <button id="points-center-entry" class="points-entry" bindtap="showPoints" aria-label="进入积分中心"><view wx:if="{{iconPalette==='prism'}}" class="points-coins" aria-hidden="true"><text>✦</text></view><view wx:else class="points-icon"><image src="/assets/icons/center-points-{{iconPalette||'prism'}}.png" mode="aspectFit"/></view><view class="center-entry-copy"><text class="service-card-title">我的积分 <text aria-hidden="true">›</text></text><text class="center-subtitle">积分记录与兑换</text></view></button>
   <button id="service-center-entry" class="service-center-card" hover-class="service-card-pressed" bindtap="openServiceCenter" aria-label="进入商家服务中心"><view class="service-crown" aria-hidden="true"><view/></view><view class="center-entry-copy"><text class="service-card-title">商家服务 <text aria-hidden="true">›</text></text><text class="center-subtitle">入驻 · 认证 · 管理</text></view></button>
  </view>
  <view class="center-menu personal-services">
   <button class="center-menu-row privacy-entry" bindtap="openPrivacy"><image src="/assets/icons/center-settings-{{iconPalette||'prism'}}.png"/><text class="center-menu-label">隐私与显示</text><text class="center-chevron">›</text></button>
   <button class="center-menu-row notification-settings-entry" bindtap="openNotifications"><image src="/assets/icons/center-notifications-{{iconPalette||'prism'}}.png"/><text class="center-menu-label">消息通知设置</text><text class="center-chevron">›</text></button>
   <button class="center-menu-row account-entry" bindtap="openAccount"><image src="/assets/icons/center-privacy-{{iconPalette||'prism'}}.png"/><text class="center-menu-label">账号与安全</text><text class="center-chevron">›</text></button>
   <button class="center-menu-row data-entry" bindtap="openPersonalData"><image src="/assets/icons/center-data-{{iconPalette||'prism'}}.png"/><text class="center-menu-label">个人数据</text><text class="center-chevron">›</text></button>
   <button class="center-menu-row help-entry" bindtap="openHelp"><image src="/assets/icons/center-help-{{iconPalette||'prism'}}.png"/><text class="center-menu-label">帮助与反馈</text><text class="center-chevron">›</text></button>
  </view>
  <view class="personal-functions"><view class="personal-function-grid">
   <button class="history-entry" bindtap="showHistory"><image src="/assets/icons/center-history-{{iconPalette||'prism'}}.png"/><text>浏览记录</text></button><button class="cache-entry" bindtap="inspectCache"><image src="/assets/icons/center-trash-{{iconPalette||'prism'}}.png"/><text>清理缓存</text></button><button class="about-entry" bindtap="showAbout"><image src="/assets/icons/center-about-{{iconPalette||'prism'}}.png"/><text>关于小程序</text></button>
  </view></view>
  <button wx:if="{{hasSession}}" class="signout-action" bindtap="signout" loading="{{signingOut}}" disabled="{{signingOut}}">退出登录</button>
 </view></block>
</view>
</view>
