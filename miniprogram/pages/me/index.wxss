.me-page{padding:22rpx 30rpx calc(36rpx + env(safe-area-inset-bottom))}
.me-page .profile-entry,.me-page .points-entry,.me-page .merchant-entry,.me-page .center-menu-row,.me-page .center-link{margin:0;background:transparent;border:0;padding:0;border-radius:0;font-weight:400;line-height:1.55;text-align:left;color:var(--text)}
.profile-entry::after,.points-entry::after,.merchant-entry::after,.center-menu-row::after,.center-link::after{border:0}
.me-page .profile-entry{display:flex;align-items:center;gap:26rpx;padding:18rpx 8rpx 24rpx;min-height:132rpx;border-bottom:1rpx solid var(--border)}
.profile-avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;flex-shrink:0;border-radius:50%;overflow:hidden;background:var(--soft)}
.profile-avatar image{width:100%;height:100%}
.profile-avatar .avatar-placeholder{width:46rpx;height:46rpx}
.profile-copy{flex:1;min-width:0}
.profile-name{font-size:35rpx;font-weight:650;color:var(--ink);line-height:1.5;word-break:break-all}
.profile-subtitle{font-size:25rpx;line-height:1.7;color:var(--muted);margin-top:6rpx}
.center-chevron{font-size:40rpx;line-height:1;color:var(--muted);flex-shrink:0;font-weight:300}
.workspace-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:30rpx 2rpx 20rpx}
.workspace-heading .section-title{font-size:29rpx;font-weight:650}
.center-subtitle{display:block;font-size:24rpx;color:var(--muted);line-height:1.7;word-break:break-all}
.workspace-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin:0 0 22rpx}
.workspace-item{display:flex;flex-direction:column;align-items:center;min-width:0;min-height:148rpx;padding:14rpx 0;color:var(--ink);text-align:center}
.workspace-item image{width:34rpx;height:34rpx;margin-bottom:16rpx;flex-shrink:0}
.workspace-label{font-size:23rpx;line-height:1.6;word-break:keep-all}
.workspace-count{display:block;min-height:36rpx;font-size:23rpx;line-height:1.6;color:var(--muted);margin-top:6rpx}
.me-page .points-entry{display:flex;align-items:center;gap:18rpx;min-height:112rpx;padding:18rpx 22rpx;margin-bottom:18rpx;border:1rpx solid var(--border);border-radius:24rpx;background:var(--surface)}
.points-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;background:var(--soft);border-radius:18rpx;flex-shrink:0}
.points-icon image{width:34rpx;height:34rpx}
.center-entry-copy{flex:1;min-width:0}
.center-entry-title{font-size:29rpx;color:var(--ink);font-weight:650;line-height:1.5;margin-bottom:4rpx}
.planning-label{background:var(--soft);color:var(--muted);font-size:21rpx;border-radius:22rpx;padding:3rpx 12rpx;flex-shrink:0}
.me-page .merchant-entry{display:flex;align-items:center;gap:24rpx;min-height:126rpx;padding:22rpx 24rpx;border:1rpx solid var(--border);border-radius:24rpx;background:var(--surface);margin:0 0 16rpx}
.merchant-entry>image{width:36rpx;height:36rpx;flex-shrink:0;margin:0 12rpx 0 8rpx}
.menu-group-title{font-size:25rpx;color:var(--muted);margin:32rpx 8rpx 14rpx}
.center-menu{background:var(--surface);border-radius:24rpx;padding:0 24rpx;overflow:hidden}
.center-menu .center-menu-row:last-child{border-bottom:0}
.me-page .center-menu-row{display:flex;align-items:center;gap:20rpx;min-height:110rpx;padding:22rpx 4rpx;border-bottom:1rpx solid var(--border);font-size:27rpx;width:100%}
.center-menu-row>image{width:32rpx;height:32rpx;flex-shrink:0}
.center-menu-label,.center-menu-copy{flex:1;min-width:0;color:var(--ink)}
.me-page .center-link{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:12rpx 2rpx;color:var(--link);font-size:25rpx;flex-shrink:0}
.account-panel .center-menu-row:last-child{border:0}
.me-page .signout-action{margin:24rpx 0 0;width:100%;min-height:96rpx;padding:22rpx;background:var(--surface);border:0;border-radius:24rpx;color:var(--danger);font-size:28rpx;line-height:1.7}
.signout-action::after{border:0}
.guest-signin{margin-top:22rpx}
.summary-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:24rpx;color:var(--danger)}
.settings-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:112rpx;border-bottom:1rpx solid var(--border)}
.settings-row>view{flex:1;min-width:0}
.settings-row text{display:block}
.settings-row .notice{padding:8rpx 0}
.settings-label{font-size:29rpx;color:var(--ink)}
.privacy-record{border-top:1rpx solid var(--border);padding:24rpx 0}
.privacy-record .body-copy{font-size:26rpx}
.settings-error{color:var(--danger);padding:20rpx 0}
.theme-clear .profile-entry,.theme-clear .points-entry,.theme-clear .merchant-entry,.theme-clear .center-menu-row{border-width:2rpx}
.large-text .profile-name{font-size:40rpx}
.large-text .profile-subtitle,.large-text .center-subtitle{font-size:29rpx}
.large-text .workspace-heading{align-items:flex-start;flex-wrap:wrap}
.large-text .workspace-label,.large-text .workspace-count{font-size:28rpx}
.large-text .workspace-label{word-break:normal;overflow-wrap:anywhere}
.large-text .workspace-item{padding:16rpx 0;min-height:188rpx}
.large-text .center-entry-title{font-size:33rpx}
.large-text .center-menu-row{font-size:32rpx;min-height:120rpx}
.large-text .points-entry{display:grid;grid-template-columns:72rpx minmax(0,1fr) 28rpx;column-gap:18rpx;row-gap:10rpx}
.large-text .points-icon{grid-column:1;grid-row:1 / span 2;align-self:start;margin-top:6rpx}
.large-text .points-entry .center-entry-copy{grid-column:2;grid-row:1}
.large-text .planning-label{grid-column:2;grid-row:2;justify-self:start;font-size:25rpx;margin-left:0}
.large-text .points-entry>.center-chevron{grid-column:3;grid-row:1 / span 2;align-self:center}
.large-text .center-link{font-size:29rpx}

.subpage-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:88rpx;margin-bottom:16rpx}
.subpage-heading .section-title{flex:1;min-width:0;margin:0;font-size:29rpx;font-weight:650;line-height:1.5;color:var(--ink)}
.me-page .subpage-return{min-width:176rpx;justify-content:flex-end;text-align:right;white-space:nowrap}
.large-text .subpage-heading .section-title{font-size:34rpx}
.me-page .avatar-editor{display:flex;flex-direction:column;align-items:center;gap:18rpx;margin:32rpx auto 44rpx;padding:12rpx 28rpx;background:transparent;border:0;color:var(--muted);font-size:27rpx;line-height:1.6}
.avatar-editor::after,.profile-field::after{border:0}
.avatar-large{width:144rpx;height:144rpx}
.avatar-large .avatar-placeholder{width:62rpx;height:62rpx}
.profile-fields{background:var(--surface);border-radius:24rpx;padding:0 28rpx;overflow:hidden}
.me-page .profile-field{display:flex;align-items:center;gap:20rpx;min-height:128rpx;width:100%;padding:24rpx 0;margin:0;border:0;border-radius:0;background:transparent;color:var(--ink);font-size:29rpx;line-height:1.6;text-align:left;border-bottom:1rpx solid var(--border);font-weight:400}
.profile-field:last-child{border-bottom:0}
.profile-field-label{flex-shrink:0}
.profile-field-value{flex:1;min-width:0;text-align:right;color:var(--muted);overflow-wrap:anywhere}
.profile-footnote{text-align:center;padding:32rpx 20rpx;color:var(--muted);font-size:24rpx;line-height:1.9}
.account-id{display:block;font-size:24rpx;color:var(--muted);overflow-wrap:anywhere;margin:8rpx 0}
.large-text .profile-field{font-size:34rpx;min-height:144rpx}
.large-text .profile-footnote,.large-text .menu-group-title{font-size:29rpx}
.large-text .settings-label{font-size:34rpx}
.theme-clear .profile-fields,.theme-clear .center-menu{border:2rpx solid var(--border)}

.points-balances{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;padding:24rpx 0;text-align:center;color:var(--muted);font-size:24rpx}.points-balances text{display:block}.points-number{font-size:38rpx;font-weight:600;color:var(--ink);overflow-wrap:anywhere}.large-text .points-number{font-size:44rpx}.large-text .points-balances{font-size:28rpx}

.points-appeal-form{border-top:1rpx solid var(--border);margin-top:20rpx;padding-top:24rpx}

.hub-intro{padding:4rpx 0 16rpx}.hub-title{font-size:38rpx;font-weight:650;color:var(--ink);margin-bottom:12rpx}.hub-section{margin:10rpx 0 20rpx;padding:20rpx;border:1rpx solid var(--border);border-radius:24rpx;background:var(--surface)}.me-page .hub-row{display:flex;width:100%;align-items:center;justify-content:space-between;gap:18rpx;min-height:104rpx;padding:18rpx 0;margin:0;border-radius:0;background:transparent;text-align:left;border-bottom:1rpx solid var(--border);line-height:1.6}.hub-row::after,.hub-actions button::after{border:0}.hub-row:last-child{border-bottom:0}.hub-row-title{font-size:29rpx;font-weight:550;color:var(--ink)}.hub-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin:20rpx 0}.hub-actions button{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:100rpx;margin:0;padding:18rpx;border-radius:18rpx;background:var(--soft);color:var(--link);font-size:28rpx;font-weight:550;line-height:1.6;text-align:left}.hub-actions button text{font-size:23rpx;color:var(--muted);font-weight:400}.points-center-actions{grid-template-columns:repeat(3,minmax(0,1fr))}.points-center-actions button{padding:18rpx 12rpx}.large-text .hub-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.large-text .hub-row-title,.large-text .hub-actions button{font-size:33rpx}.large-text .hub-actions button text{font-size:28rpx}

/* Main workspace uses a profile header, one statistics group and continuous settings rows. */
.me-page { padding:28rpx 32rpx calc(48rpx + 56px + env(safe-area-inset-bottom)); }
.main-center .profile-entry { padding:12rpx 0 32rpx; border:0; border-radius:0; background:transparent; box-shadow:none; }
.main-center .profile-avatar { width:120rpx; height:120rpx; background:var(--soft-alt); }
.main-center .profile-name { font-size:44rpx; font-weight:650; line-height:1.35; }
.main-center .profile-subtitle { font-size:26rpx; margin-top:12rpx; }
.main-center .workspace-heading { margin:32rpx 0 20rpx; }
.main-center .workspace-heading .section-title { font-size:34rpx; }
.main-center .workspace-grid { padding:24rpx 0; margin:0; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); gap:0; }
.main-center .workspace-item { min-height:128rpx; padding:12rpx 8rpx; border-right:1rpx solid var(--border); }
.main-center .workspace-item:last-child { border-right:0; }
.main-center .workspace-item image { display:none; }
.main-center .workspace-count { order:-1; margin:0 0 10rpx; color:var(--ink); font-size:44rpx; font-weight:650; line-height:1.3; }
.main-center .workspace-label { font-size:26rpx; }
.main-center .menu-group-title { margin:40rpx 0 20rpx; color:var(--ink); font-size:34rpx; font-weight:600; }
.center-hub { padding:0 24rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); }
.main-center .points-entry,.main-center .merchant-entry { width:100%; min-height:112rpx; margin:0; padding:24rpx 0; border:0; border-bottom:1rpx solid var(--border); border-radius:0; background:transparent; gap:20rpx; }
.main-center .merchant-entry { border-bottom:0; }
.main-center .points-icon { width:40rpx; height:40rpx; border-radius:0; background:transparent; }
.main-center .points-icon image,.main-center .merchant-entry>image { width:36rpx; height:36rpx; margin:0; }
.main-center .center-entry-title { font-size:30rpx; font-weight:500; }
.main-center .center-subtitle { font-size:24rpx; }
.main-center .center-menu { border:1rpx solid var(--border); border-radius:20rpx; }
.main-center .center-menu-row { min-height:104rpx; padding:22rpx 0; font-size:30rpx; }
.main-center .signout-action { margin-top:32rpx; border:1rpx solid var(--border); border-radius:16rpx; font-size:28rpx; }
.large-text .main-center .profile-name { font-size:50rpx; }
.large-text .main-center .workspace-count { font-size:50rpx; }
.large-text .main-center .workspace-label,.large-text .main-center .center-menu-row { font-size:34rpx; }
.large-text .main-center .center-subtitle { font-size:30rpx; }

.me-page .profile-entry { border-bottom:0; padding:12rpx 8rpx 24rpx; }
.profile-name { font-size:34rpx; }
.workspace-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; padding:18rpx 0; margin:8rpx 0 20rpx; border-radius:26rpx; background:var(--surface); }
.workspace-item { min-height:80rpx; padding:0 4rpx; }
.workspace-count { order:-1; color:var(--ink); font-size:34rpx; font-weight:650; line-height:1.4; margin:0 0 4rpx; }
.workspace-label { font-size:23rpx; }
.me-page .points-entry { min-height:76rpx; margin:0 0 20rpx; padding:10rpx 20rpx; border:0; border-radius:24rpx; background:#FDEEDD; }
.points-icon { width:44rpx; height:44rpx; background:transparent; }
.points-icon image { width:36rpx; height:36rpx; }
.points-title { flex:1; color:#533C37; font-size:28rpx; font-weight:600; }
.points-action { flex-shrink:0; padding:6rpx 22rpx; border-radius:40rpx; color:var(--on-action); background:var(--action); font-size:23rpx; }
.personal-functions { margin-bottom:20rpx; padding:20rpx 18rpx 12rpx; border-radius:26rpx; background:var(--surface); }
.personal-functions>.section-title { margin:0 6rpx 14rpx; font-size:30rpx; }
.personal-function-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx 0; }
.personal-function-grid button { display:flex; flex-direction:column; align-items:center; gap:8rpx; min-height:100rpx; margin:0; padding:8rpx 0; border:0; background:transparent; color:var(--ink); font-size:23rpx; line-height:1.5; }
.personal-function-grid button::after { border:0; }
.personal-function-grid image { width:52rpx; height:52rpx; padding:8rpx; border-radius:14rpx; background:var(--soft); }
.personal-services .center-menu-row { min-height:90rpx; padding:16rpx 4rpx; }
.large-text .workspace-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; }
.large-text .workspace-label,.large-text .personal-function-grid button { font-size:29rpx; }
.large-text .personal-function-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
.theme-dark .points-entry { background:var(--soft); }
.theme-dark .points-title { color:var(--ink); }

.me-page .service-center-card { display:flex; align-items:center; gap:20rpx; width:100%; min-height:120rpx; margin:0 0 20rpx; padding:22rpx 24rpx; border:1rpx solid var(--border); border-radius:24rpx; background:var(--soft); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.85),var(--elevation); color:var(--ink); text-align:left; line-height:1.5; }
.service-center-card::after { border:0; }
.service-center-icon { width:36rpx; height:36rpx; flex-shrink:0; }
.service-card-title { display:block; font-size:30rpx; font-weight:600; }
.service-center-card .center-subtitle { margin-top:4rpx; font-size:24rpx; }
.large-text .service-card-title { font-size:34rpx; }
.large-text .service-center-card .center-subtitle { font-size:29rpx; }
.theme-clear .service-center-card { border-width:2rpx; }
.service-icon-frame { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; flex-shrink:0; border:1rpx solid var(--border); border-radius:18rpx; background:var(--surface); }
.service-center-card .center-chevron { color:var(--link); }
.service-card-pressed { opacity:.85; }
.main-center .workspace-grid,.personal-functions,.main-center .center-menu { box-shadow:var(--elevation); }
.me-page .points-entry { position:relative; background:linear-gradient(110deg,#FFF4E8,#FCE7E8); border:1rpx solid #FFFFFF; box-shadow:var(--elevation); }
.me-page .service-center-card { position:relative; overflow:hidden; border-color:var(--surface); }
.service-card-scene { position:absolute; right:0; bottom:0; width:40%; height:100%; opacity:.6; }
.service-center-card>.center-entry-copy,.service-center-card>.center-chevron,.service-icon-frame { position:relative; z-index:1; }
.theme-dark .points-entry { background:var(--soft); border-color:var(--border); }
.theme-dark .service-center-card { border-color:var(--border); }
