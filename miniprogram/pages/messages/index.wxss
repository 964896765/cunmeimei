.messages-page { padding:24rpx 32rpx calc(48rpx + 56px + env(safe-area-inset-bottom)); }
.message-toolbar { display:flex; align-items:center; justify-content:space-between; gap:24rpx; padding-bottom:20rpx; border-bottom:1rpx solid var(--border); }
.message-tabs { display:flex; gap:32rpx; align-items:center; }
.message-tab { position:relative; display:flex; align-items:center; justify-content:center; min-width:104rpx; min-height:96rpx; padding:16rpx 0; color:var(--muted); font-size:36rpx; line-height:1.4; }
.message-tab.active { color:var(--ink); font-weight:600; }
.message-tab.active::after { content:''; position:absolute; bottom:0; left:24rpx; right:24rpx; height:5rpx; border-radius:4rpx; background:var(--brand); }
.toolbar-action,.filter-link,.notice-shortcut { margin:0; padding:0; border:0; background:transparent; color:var(--link); font-weight:400; line-height:1.5; }
.toolbar-action::after,.filter-link::after,.notice-shortcut::after { border:0; }
.toolbar-action { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:12rpx; font-size:26rpx; }
.search-action { width:88rpx; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); }
.search-glyph { position:relative; width:30rpx; height:30rpx; margin:-5rpx 5rpx 0 0; border:2rpx solid var(--link); border-radius:50%; }
.search-glyph::after { content:''; position:absolute; right:-10rpx; bottom:-6rpx; width:15rpx; height:2rpx; transform:rotate(45deg); background:var(--link); }
.read-all[disabled] { opacity:.45; }
.contact-search { margin:24rpx 0; }
.contact-filter { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; color:var(--muted); font-size:26rpx; }
.filter-link { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:16rpx 4rpx; font-size:26rpx; }
.message-row { display:flex; align-items:center; gap:22rpx; min-height:112rpx; padding:20rpx 0; border-bottom:1rpx solid var(--border); }
.message-icon { display:flex; flex-shrink:0; align-items:center; justify-content:center; width:80rpx; height:80rpx; border-radius:24rpx; background:var(--soft); }
.contact-row .message-icon { border-radius:50%; }
.message-icon image { display:block; width:38rpx; height:38rpx; }
.message-copy { flex:1; min-width:0; }
.message-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--ink); font-size:32rpx; font-weight:600; line-height:1.35; }
.message-preview { margin-top:10rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--muted); font-size:26rpx; line-height:1.4; }
.message-meta { display:flex; flex-shrink:0; flex-direction:column; align-items:flex-end; gap:12rpx; max-width:128rpx; }
.message-time,.message-status { color:var(--muted); font-size:24rpx; line-height:1.4; }
.tab-unread,.unread-dot,.pending-dot { display:inline-block; flex-shrink:0; width:12rpx; height:12rpx; border-radius:50%; background:var(--brand); }
.tab-unread { position:absolute; right:-4rpx; top:16rpx; }
.contact-detail { padding:24rpx; border-bottom:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); }
.contact-detail>.btn { margin-bottom:20rpx; }
.contact-detail .field-label { margin-top:20rpx; }
.contact-response { margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid var(--border); }
.contact-mode-note { padding:28rpx 0; color:var(--muted); font-size:24rpx; line-height:1.7; }
.notification-shortcuts { display:flex; gap:12rpx; flex-wrap:wrap; padding:24rpx 0 12rpx; }
.notice-shortcut { display:flex; align-items:center; justify-content:center; gap:10rpx; min-height:88rpx; padding:16rpx 20rpx; border:1rpx solid var(--border); border-radius:14rpx; color:var(--text); font-size:26rpx; }
.notice-shortcut image { width:28rpx; height:28rpx; }
.notice-shortcut.selected { background:var(--soft); color:var(--link); border-color:var(--brand); }
.notice-section-heading { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:24rpx 0 12rpx; }
.notice-section-heading .section-title { font-size:34rpx; }
.notice-name { display:flex; align-items:center; gap:12rpx; }
.notice-name>text:first-child { min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.notice-body { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; white-space:normal; }
.load-notices { width:100%; margin-top:16rpx; }
.state-panel { margin-top:28rpx; }
.state-panel>text { display:block; margin-top:16rpx; font-size:28rpx; color:var(--muted); line-height:1.7; }
.state-panel .btn { margin-top:24rpx; }
.large-text .message-tab { font-size:40rpx; }
.large-text .message-name { font-size:38rpx; }
.large-text .message-preview,.large-text .message-time,.large-text .message-status,.large-text .filter-link { font-size:30rpx; }
.large-text .message-row { gap:16rpx; }
.large-text .message-icon { width:72rpx; height:72rpx; }
.large-text .message-meta { max-width:120rpx; }
.large-text .notice-shortcut { font-size:30rpx; }
