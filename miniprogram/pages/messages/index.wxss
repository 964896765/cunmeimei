.messages-page{padding:24rpx 30rpx calc(36rpx + env(safe-area-inset-bottom))}
.message-toolbar{display:flex;align-items:center;justify-content:space-between;padding:0 4rpx 14rpx;border-bottom:1rpx solid var(--border);gap:16rpx}
.message-tabs{display:flex;align-items:center;gap:8rpx}
.message-tab{position:relative;min-width:108rpx;min-height:80rpx;display:flex;align-items:center;justify-content:center;border-radius:42rpx;padding:12rpx 24rpx;color:var(--muted);font-size:29rpx;line-height:1.4}
.message-tab.active{background:var(--soft);color:var(--link);font-weight:500}
.theme-prism .message-tab.active{background:linear-gradient(120deg,var(--glow-start),var(--soft-alt))}
.toolbar-action,.filter-link,.notice-shortcut{background:transparent;border:0;margin:0;padding:0;font-weight:400;line-height:1.5;color:var(--muted)}
.toolbar-action::after,.filter-link::after,.notice-shortcut::after{border:0}
.toolbar-action{min-height:88rpx;display:flex;align-items:center;justify-content:center}
.search-action{width:88rpx;flex-shrink:0}
.search-glyph{width:32rpx;height:32rpx;border:3rpx solid var(--muted);border-radius:50%;position:relative;margin:0 8rpx 7rpx 0}
.search-glyph::after{content:'';position:absolute;width:16rpx;height:3rpx;background:var(--muted);right:-12rpx;bottom:-6rpx;transform:rotate(47deg);border-radius:2rpx}
.read-all{font-size:25rpx;padding:0 8rpx}
.message-toolbar .read-all[disabled]{opacity:1;color:var(--muted);background:transparent}
.tab-unread,.unread-dot,.pending-dot{display:inline-block;flex-shrink:0;width:12rpx;height:12rpx;border-radius:50%;background:var(--brand)}
.tab-unread{position:absolute;right:13rpx;top:17rpx;width:9rpx;height:9rpx}
.contact-search{margin:22rpx 4rpx 6rpx;padding:0 22rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--surface)}
.contact-search input{height:88rpx;width:100%;font-size:27rpx;color:var(--ink)}
.contact-filter{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:82rpx;color:var(--muted);font-size:23rpx;padding:12rpx 4rpx 0}
.filter-link{font-size:24rpx;min-height:80rpx;display:flex;align-items:center;justify-content:center;color:var(--link);padding:12rpx 4rpx}
.message-row{display:flex;align-items:center;gap:24rpx;padding:24rpx 4rpx;border-bottom:1rpx solid var(--border);min-height:154rpx}
.contact-row{min-height:178rpx}
.message-icon{width:66rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.message-icon image{width:34rpx;height:34rpx;display:block}
.message-copy{flex:1;min-width:0}
.message-name{font-size:29rpx;color:var(--ink);font-weight:500;line-height:1.55;overflow-wrap:anywhere}
.message-preview{font-size:26rpx;color:var(--text);line-height:1.65;margin-top:9rpx;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;word-break:break-all}
.message-context{font-size:23rpx;line-height:1.6;color:var(--muted);margin-top:8rpx}
.message-meta{align-self:stretch;flex-shrink:0;display:flex;align-items:flex-end;justify-content:flex-start;flex-direction:column;gap:25rpx;padding-top:4rpx;max-width:120rpx}
.message-time{font-size:23rpx;line-height:1.6;color:var(--muted);text-align:right;overflow-wrap:anywhere}
.pending-dot{margin:0 8rpx}
.contact-detail{padding:0 4rpx 22rpx 94rpx;border-bottom:1rpx solid var(--border)}
.contact-detail .field-label{margin-top:18rpx}
.contact-response{background:var(--surface);border-radius:18rpx;padding:2rpx 20rpx 20rpx;margin-top:18rpx}
.contact-detail>.btn{margin-top:20rpx}
.block-contact{margin-top:12rpx}
.contact-mode-note{font-size:22rpx;line-height:1.7;color:var(--muted);padding:28rpx 12rpx;text-align:center}
.notification-shortcuts{display:flex;align-items:flex-start;justify-content:space-between;padding:16rpx 0 12rpx;gap:8rpx}
.notice-shortcut{flex:1;min-width:0;min-height:88rpx;padding:10rpx 4rpx;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:8rpx;font-size:24rpx;border-radius:20rpx;color:var(--ink)}
.notice-shortcut image{width:28rpx;height:28rpx;flex-shrink:0}
.notice-shortcut.selected{background:var(--soft);color:var(--link)}
.planned-label{display:block;font-size:18rpx;color:var(--muted);line-height:1.6}
.notice-section-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:76rpx;padding:6rpx 4rpx}
.notice-section-heading .section-title{font-size:28rpx;font-weight:500}
.notice-name{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap}
.notice-name>text:first-child{min-width:0;overflow-wrap:anywhere}
.notice-row .message-meta{align-self:center;justify-content:center;padding:0}
.message-loading{font-size:23rpx;color:var(--muted);padding:22rpx 4rpx;text-align:center}
.load-notices{width:100%;margin-top:16rpx}
.theme-clear .message-toolbar,.theme-clear .message-row,.theme-clear .contact-search{border-width:2rpx}
.large-text .message-tab,.large-text .notice-shortcut{font-size:33rpx}
.large-text .message-name{font-size:34rpx}
.large-text .message-preview{font-size:31rpx}
.large-text .message-context,.large-text .message-time,.large-text .filter-link,.large-text .read-all,.large-text .contact-filter{font-size:28rpx}
.large-text .message-row{gap:16rpx}
.large-text .message-meta{max-width:112rpx}
.large-text .message-icon{width:48rpx}
.large-text .contact-detail{padding-left:4rpx}
.large-text .contact-mode-note{font-size:27rpx}
.large-text .planned-label{font-size:23rpx}
