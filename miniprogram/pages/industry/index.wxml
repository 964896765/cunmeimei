<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header id="navigation-header" title="{{mode==='form'?workflow.projectName:mode==='public'?publicItem.projectName:'行业业务工作台'}}" back="{{true}}" bind:back="back" large-text="{{displayPreferences.largeText}}"/><view class="container">
 <view wx:if="{{privateLocked}}" id="account-access-gate" class="state-panel"><view class="section-title">登录后查看本人记录</view><view class="notice">登录已结束或尚未完成，原账号记录暂不展示。</view><view wx:if="{{error}}" class="notice" role="alert">{{error}}</view><button id="account-access-login" class="btn" bindtap="signin">微信登录并继续</button><button class="btn light" bindtap="back">返回浏览</button></view>
 <block wx:else><view wx:if="{{recoveryNotice}}" class="notice" role="status">{{recoveryNotice}}</view><view wx:if="{{recoveryError}}" class="notice" role="alert">{{recoveryError}}</view>
 <button class="center-link" bindtap="myWorkspace">我的业务、申请与核验记录</button>
 <feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取" bind:action="load" action-disabled="{{busy||loading}}"/><feedback-state wx:if="{{loading}}" kind="loading" description="正在读取业务记录…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/>
 <view wx:if="{{pending}}" class="section-card"><view class="body-copy">有一项提交结果待核对。</view><button class="btn" bindtap="resume" disabled="{{busy}}">核对上次提交</button><button class="center-link" bindtap="clearPending" disabled="{{busy}}">已核对，清除本机请求</button></view>
 <block wx:if="{{mode==='form'&&workflow}}"><view wx:if="{{previewing}}" class="section-card industry-preview"><view class="notice">仅预览 · 当前内容尚未发布</view><view class="section-title">{{form.title}}</view><view class="notice">{{cityLabel}} · {{districtLabel}} · {{form.district}}</view><view wx:if="{{form.price}}" class="body-copy">{{form.price}}</view><view class="preview-description">{{form.detail}}</view><view wx:for="{{previewFields}}" wx:key="key" class="public-field"><view class="field-label">{{item.label}}</view><view class="body-copy">{{item.value}}</view></view><image wx:for="{{previewImages}}" wx:key="id" class="industry-preview-image" src="{{item.path}}" mode="aspectFit" data-path="{{item.path}}" bindtap="previewPhoto"/><publication-confirmation id="publication-confirmation" revision="{{consentRevision}}" disabled="{{busy||pending}}" color="{{themeColor}}" large-text="{{displayPreferences.largeText}}" bind:change="publicationConsentChanged"/><button class="btn" id="industry-submit" data-action="submit" bindtap="save" disabled="{{busy||pending||!publicationConsent}}">确认并提交审核</button><button class="btn light" disabled="{{busy}}" bindtap="editForm">返回修改</button></view><block wx:else><view class="section-card"><view class="section-title">{{workflow.title}} · {{statusText||'新建'}}</view><view class="notice">{{workflow.notice}}</view><view wx:if="{{response}}" class="body-copy">审核答复：{{response}}</view></view>
 <disclosure-section wx:if="{{workflow.bookable&&entryStatus==='published'}}" title="预约意向入口" summary="{{serviceLink?serviceLink.statusText:'选择负责回应预约的商家'}}" open="{{!serviceLink||!serviceLink.eligible}}" large-text="{{displayPreferences.largeText}}"><view class="notice">由已核验商家负责时间和名额；服务内容另经审核后开放预约。修改原业务、资质失效或撤权后停止新预约，历史记录保留。</view><view wx:if="{{serviceLink}}" class="body-copy">当前服务：{{serviceLink.statusText}} · {{serviceLink.eligible?'来源与权限有效':'原内容或资格已变化，请核对并重新连接'}}</view><picker wx:if="{{managedMerchants.length}}" range="{{merchantNames}}" bindchange="chooseMerchant"><view class="field">{{selectedMerchant.name||'选择实际负责的商家'}} ⌄</view></picker><button wx:if="{{managedMerchants.length}}" id="industry-connect-service" class="btn light" bindtap="connectService" disabled="{{busy||pending}}">核对后连接服务目录</button><button wx:else class="btn light" bindtap="openServiceCenter">前往服务中心，完成商家入驻</button></disclosure-section>
 <disclosure-section wx:if="{{workflow.credential}}" title="本项目行业核验" summary="{{credential.status==='verified'?'已完成核验，提交时复核有效期':'核对主体与当前项目范围'}}" open="{{!credential||credential.status!=='verified'}}" large-text="{{displayPreferences.largeText}}"><view class="notice">{{credential?credential.status==='verified'?'已核验，提交和展示时仍会检查有效期':credential.status==='pending'?'申请待核验':'核验未通过或已撤销':'尚未提交核验申请'}}。仅适用于当前项目。</view><view wx:if="{{credential.response}}" class="notice">{{credential.response}}</view><input class="field" data-key="subject" bindinput="field" value="{{subject}}" placeholder="实际主体名称" maxlength="120" aria-label="项目主体名称"/><input class="field" data-key="evidenceReference" bindinput="field" value="{{evidenceReference}}" placeholder="实际材料工单引用，不填证件号" maxlength="300" aria-label="主体和专项资质材料引用"/><button class="btn light" disabled="{{busy||pending||credential.status==='pending'}}" bindtap="applyCredential">提交 / 补充主体核验</button></disclosure-section>
 <view class="section-card industry-form"><view class="field-label">标题 *</view><input class="field" value="{{form.title}}" bindinput="field" data-key="title" maxlength="100" aria-label="业务标题"/><view class="field-label">详细说明 *</view><textarea class="field-area" value="{{form.detail}}" bindinput="field" data-key="detail" maxlength="5000" placeholder="描述实际业务，不填写手机号、证件号或收费账号" aria-label="业务详细说明"/>
 <button class="btn light" bindtap="chooseCity">{{cityLabel}} · 选择城市</button><picker range="{{districtNames}}" bindchange="district"><view class="field">{{districtLabel||'选择区县或镇街'}} ⌄</view></picker><picker range="{{areas}}" bindchange="area"><view class="field">{{form.district||'选择已开放服务地区'}} ⌄</view></picker><view class="field-label">公开价格说明（选填）</view><input class="field" value="{{form.price}}" bindinput="field" data-key="price" maxlength="80" aria-label="公开价格说明"/>
 <view wx:for="{{formFields}}" wx:key="key" class="business-field"><view class="field-label">{{item.label}} {{item.required?'*':''}}</view>
 <switch wx:if="{{item.type==='confirm'}}" checked="{{item.value===true}}" color="{{themeColor}}" data-key="{{item.key}}" bindchange="businessField" aria-label="{{item.label}}"/>
 <picker wx:elif="{{item.type==='select'}}" range="{{item.options}}" data-key="{{item.key}}" bindchange="businessField"><view class="field">{{item.value||'请选择'}} ⌄</view></picker>
 <picker wx:elif="{{item.type==='date'}}" mode="date" value="{{item.value}}" data-key="{{item.key}}" bindchange="businessField"><view class="field">{{item.value||'选择日期'}} ⌄</view></picker>
 <view wx:elif="{{item.type==='datetime'}}" class="row"><picker mode="date" value="{{item.date}}" data-key="{{item.key}}" data-part="date" bindchange="businessField"><view class="field">{{item.date||'选择日期'}} ⌄</view></picker><picker mode="time" value="{{item.time}}" data-key="{{item.key}}" data-part="time" bindchange="businessField"><view class="field">{{item.time||'选择时间'}} ⌄</view></picker></view>
 <textarea wx:elif="{{item.type==='textarea'}}" class="field-area" value="{{item.value}}" data-key="{{item.key}}" bindinput="businessField" maxlength="4000" aria-label="{{item.label}}"/>
 <input wx:else class="field" type="{{item.type==='number'?'number':item.type==='decimal'?'digit':'text'}}" value="{{item.value}}" data-key="{{item.key}}" bindinput="businessField" maxlength="800" aria-label="{{item.label}}"/>
 </view><button class="btn light" bindtap="choosePhotos" disabled="{{busy||form.imageIds.length>=6}}">添加图片 {{form.imageIds.length}}/6</button><view wx:for="{{photos}}" wx:key="id" class="photo-row"><image src="{{item.path}}" mode="aspectFill"/><button class="center-link" data-id="{{item.id}}" bindtap="removePhoto">移除</button></view><view wx:if="{{form.imageIds.length&&!photos.length}}" class="notice">已有 {{form.imageIds.length}} 张原图，保存时保留；审核员会检查原图。</view>
 <button wx:if="{{entryStatus!=='closed'}}" class="btn light" id="industry-save-draft" data-action="draft" bindtap="save" disabled="{{busy||pending}}">明确保存草稿</button><button wx:if="{{entryStatus!=='closed'}}" class="btn" id="industry-preview" bindtap="previewForm" disabled="{{busy||pending||loading}}">下一步 · 预览</button><button wx:if="{{entryId&&entryStatus!=='closed'}}" class="btn light" bindtap="close" disabled="{{busy||pending}}">结束本条业务</button></view></block></block>
 <block wx:elif="{{mode==='public'&&publicItem}}"><swiper duration="{{displayPreferences.reduceMotion?0:250}}" wx:if="{{publicItem.images.length}}" class="gallery" indicator-dots="{{publicItem.images.length>1}}"><swiper-item wx:for="{{publicItem.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview"/></swiper-item></swiper><view class="section-card"><view class="section-title">{{publicItem.title}}</view><view class="body-copy">{{publicItem.detail}}</view><view class="notice">{{publicItem.district}} · {{publicItem.price}}</view><view class="notice">{{publicItem.notice}}</view><button wx:if="{{publicItem.editorial||publicItem.directory}}" class="btn light" bindtap="copySource">复制原始来源，核对官方信息</button><view wx:for="{{publicItem.fields}}" wx:key="key" class="public-field"><view class="field-label">{{item.label}}</view><view class="body-copy" selectable="true">{{item.value}}</view></view><view wx:if="{{publicItem.capacity}}" class="notice">{{publicItem.startText}} 至 {{publicItem.endText}} · 报名名额参考剩余 {{publicItem.remaining}}，以提交时为准。</view></view>
 <view wx:if="{{publicItem.bookableServiceId}}" class="section-card"><view class="section-title">预约该服务</view><view class="notice">选择当前可用时段，商家确认后成立；预约及后续处理可在服务中心回查。</view><button id="industry-book-service" class="btn" bindtap="bookService">查看时段并预约</button></view><view wx:if="{{publicItem.responseKind}}" class="section-card"><view class="section-title">{{publicItem.responseKind==='job'?'岗位申请':publicItem.responseKind==='event'?'免费活动报名':'业务咨询'}}</view><textarea class="field-area" data-key="applicationBody" value="{{applicationBody}}" bindinput="field" maxlength="800" placeholder="8字以上申请说明，不填手机号、证件号或银行卡" aria-label="申请说明"/><button class="btn" disabled="{{busy||pending}}" id="industry-apply" bindtap="apply">确认提交申请</button></view><disclosure-section title="内容纠错与举报" summary="发现信息问题时提交反馈" large-text="{{displayPreferences.largeText}}"><textarea class="field-area" data-key="reportReason" value="{{reportReason}}" bindinput="field" maxlength="500" placeholder="说明实际问题，8字以上" aria-label="举报原因"/><button class="btn light" disabled="{{busy||pending}}" bindtap="report">提交核查</button></disclosure-section></block>
 <block wx:else><scroll-view scroll-x="true" class="workspace-tabs"><button wx:for="{{['mine','sent','received','credentials','reports']}}" wx:key="*this" class="workspace-tab {{tab===item?'selected':''}}" data-tab="{{item}}" bindtap="tab" aria-pressed="{{tab===item}}">{{item==='mine'?'我的业务':item==='sent'?'我的申请':item==='received'?'收到的申请':item==='credentials'?'主体核验':'举报答复'}}</button></scroll-view><view class="section-card" wx:for="{{items}}" wx:key="id"><view class="row"><text class="section-title">{{item.title}}</text><status-badge   label="{{item.statusText}}" status="{{item.status}}"/></view><view class="notice">{{item.dateText}}</view><button wx:if="{{item.contact_id&&item.status==='accepted'}}" class="btn" id="industry-chat-{{item.id}}" data-id="{{item.contact_id}}" bindtap="openChat">进入已同意的站内会话</button><button wx:if="{{item.businessCaseId||item.status==='accepted'}}" class="btn light" data-id="{{item.id}}" bindtap="openBusiness">约定、完成与处理进度</button><view wx:if="{{item.body}}" class="body-copy">{{item.body}}</view><view wx:if="{{item.reason}}" class="body-copy">{{item.reason}}</view><view wx:if="{{item.response}}" class="notice">处理说明：{{item.response}}</view><button wx:if="{{tab==='mine'}}" class="btn light" data-id="{{item.id}}" bindtap="openOwn">读取、编辑与结束</button><button wx:if="{{item.entry_id}}" class="center-link" data-id="{{item.entry_id}}" bindtap="openPublic">查看原业务</button><block wx:if="{{(tab==='sent'||tab==='received')&&(item.status==='pending'||item.status==='accepted')}}"><textarea wx:if="{{tab==='received'}}" class="field-area" data-id="{{item.id}}" value="{{responseDrafts[item.id]}}" bindinput="responseInput" maxlength="800" placeholder="8字以上处理答复" aria-label="申请处理答复"/><button wx:if="{{tab==='sent'}}" class="btn light" disabled="{{busy||pending}}" data-id="{{item.id}}" id="industry-withdraw-{{item.id}}" data-status="withdrawn" bindtap="resolve">撤回申请 / 退出报名</button><block wx:else><button wx:if="{{item.status==='pending'}}" class="btn" disabled="{{busy||pending}}" data-id="{{item.id}}" data-status="accepted" bindtap="resolve">接受申请</button><button class="btn light" disabled="{{busy||pending}}" data-id="{{item.id}}" data-status="rejected" bindtap="resolve">拒绝 / 结束申请</button></block></block></view><view wx:if="{{!loading&&!items.length}}" class="state-panel">暂无本类业务记录。</view><button wx:if="{{hasMore}}" class="btn light" disabled="{{busy||loading}}" bindtap="more">继续加载</button></block>
</block>
</view></view>
