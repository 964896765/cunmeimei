page { height:100%; overflow:hidden; }
.theme-root.publish-root { display:flex; flex-direction:column; height:var(--page-viewport,100vh); min-height:0; padding-bottom:var(--page-bottom,calc(56px + env(safe-area-inset-bottom))); overflow:hidden; box-sizing:border-box; }
.publish-root>page-header { display:block; flex-shrink:0; }
.publish-root .publish-page.container { flex:1; display:flex; flex-direction:column; min-height:0; height:0; padding:16rpx 0 0; overflow:hidden; }
.publish-page>feedback-state,.publish-page>.notice { margin:0 28rpx; }
.publish-hero-slot { flex-shrink:0; max-height:224rpx; overflow:hidden; opacity:1; transition:max-height 160ms ease,opacity 140ms ease; }
.publish-hero-slot.is-collapsed { max-height:0; opacity:0; pointer-events:none; }
.reduce-motion .publish-hero-slot { transition:none; }
.publish-toolbar { position:relative; z-index:5; flex-shrink:0; }
.publish-toolbar.pinned-surface { border-bottom:1rpx solid var(--border); background:var(--background); box-shadow:0 4rpx 10rpx #45323f08; margin-bottom:12rpx; }
.publish-hero { position:relative; flex-shrink:0; height:164rpx; overflow:hidden; margin:0 28rpx 22rpx; border:1rpx solid #e8b2c7; border-radius:30rpx; background:linear-gradient(110deg,#a73360 0%,#c56a8c 52%,#f6c7dc 100%); box-shadow:0 12rpx 28rpx #a6506d22,inset 0 2rpx 3rpx #ffffff88; color:#fff; }
.publish-hero::after { content:''; position:absolute; left:16%; right:-10%; bottom:-86rpx; height:132rpx; border-radius:50%; background:#ffffff14; transform:rotate(-7deg); }
.publish-hero-copy { position:relative; z-index:1; padding:26rpx 30rpx; }
.publish-hero-copy>view { font-size:44rpx; font-weight:700; line-height:1.4; letter-spacing:1rpx; }
.publish-hero-copy>text { display:block; margin-top:10rpx; font-size:27rpx; }
.publish-hero>image { position:absolute; right:6rpx; bottom:-18rpx; width:186rpx; height:186rpx; }
.publish-search-row { display:flex; align-items:center; flex-shrink:0; gap:18rpx; margin:0 28rpx 28rpx; }
.publish-search-entry { display:flex; flex:1; align-items:center; gap:12rpx; min-width:0; min-height:88rpx; margin:0; padding:18rpx 24rpx; border:1rpx solid var(--surface); border-radius:50rpx; background:var(--surface); box-shadow:var(--elevation); color:var(--muted); text-align:left; font-size:25rpx; line-height:1.5; }
.publish-search-entry text { flex:1; min-width:0; }
.publish-search-entry .search-dot { flex-shrink:0; margin-right:0; width:28rpx; height:28rpx; }
.publish-tools-toggle { display:grid; grid-template-columns:repeat(2,15rpx); grid-template-rows:repeat(2,15rpx); align-content:center; justify-content:center; gap:7rpx; flex-shrink:0; width:84rpx; height:84rpx; margin:0; padding:0; border:2rpx solid #fff; border-radius:30rpx; background:var(--action); box-shadow:inset 0 2rpx 8rpx #ffffff99,0 8rpx 18rpx #a64a7133; }
.publish-tools-toggle>view { border:2rpx solid var(--on-action); border-radius:5rpx; }
.publish-tools-toggle.is-open { box-shadow:inset 0 2rpx 12rpx #00000022; }
.publish-search-entry::after,.publish-tools-toggle::after,.drafts-button::after,.project-search-clear::after,.project-search-cancel::after,.industry-more::after { border:0; }
.publish-tools { position:absolute; z-index:13; right:28rpx; top:calc(100% - 12rpx); display:flex; flex-direction:column; width:304rpx; padding:12rpx; border:1rpx solid var(--border); border-radius:24rpx; background:var(--surface); box-shadow:0 12rpx 32rpx #49303f20; }
.drafts-button { display:flex; flex-direction:row; align-items:center; justify-content:flex-start; gap:18rpx; width:100%; min-height:88rpx; margin:0; padding:14rpx 18rpx; border:0; border-radius:16rpx; background:transparent; color:var(--ink); font-size:28rpx; line-height:1.5; }
.drafts-button image { flex-shrink:0; width:36rpx; height:36rpx; }
.draft-label { display:flex; align-items:center; justify-content:center; gap:6rpx; }
.draft-count { min-width:28rpx; padding:0 6rpx; border-radius:20rpx; background:var(--action); color:var(--on-action); font-size:22rpx; line-height:1.4; }
.project-browser { flex:1; display:grid; grid-template-columns:minmax(0,29fr) minmax(0,71fr); gap:0; height:0; min-height:0; margin:0 20rpx 12rpx; border:1rpx solid var(--surface); border-radius:34rpx; overflow:hidden; background:var(--surface); box-shadow:var(--elevation); }
.industry-column,.project-column { display:flex; flex-direction:column; min-width:0; min-height:0; }
.industry-column { background:var(--soft); padding:18rpx 10rpx 12rpx; }
.industry-sidebar,.project-content { flex:1; height:0; min-height:0; width:100%; }
.industry-choice { position:relative; display:flex; align-items:center; gap:12rpx; min-height:80rpx; padding:16rpx 12rpx; border:2rpx solid transparent; color:var(--ink); font-size:27rpx; line-height:1.5; }
.industry-choice text { flex:1; min-width:0; }
.industry-icon { flex-shrink:0; width:32rpx; height:32rpx; }
.industry-choice.active { border-color:#ffffffcc; border-radius:40rpx; color:var(--on-action); background:var(--action); font-weight:650; box-shadow:inset 0 2rpx 7rpx #ffffff88,0 6rpx 14rpx #ac55752b; }
.industry-choice.active .industry-icon { filter:brightness(0) invert(1); }
.industry-more { display:flex; flex-shrink:0; align-items:center; justify-content:center; height:42rpx; min-height:42rpx; margin:10rpx 14rpx 0; padding:0; border:0; border-radius:30rpx; background:var(--surface); }
.industry-more>view { width:14rpx; height:14rpx; margin-top:-8rpx; border-right:3rpx solid var(--link); border-bottom:3rpx solid var(--link); transform:rotate(45deg); }
.industry-more[disabled] { opacity:.3; }
.project-column { background:var(--surface); overflow:hidden; }
.project-group-section { padding:0 20rpx; }
.project-group { display:flex; align-items:center; gap:10rpx; min-height:96rpx; padding:20rpx 0; border-bottom:1rpx solid var(--border); }
.group-icon { flex-shrink:0; width:34rpx; height:34rpx; }
.project-group-copy { flex:1; min-width:0; }
.project-group-title { display:block; color:var(--ink); font-size:29rpx; font-weight:650; line-height:1.5; }
.group-summary { display:block; margin-top:3rpx; color:var(--muted); font-size:22rpx; line-height:1.5; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.group-count { flex-shrink:0; color:var(--muted); font-size:22rpx; }
.group-chevron { flex-shrink:0; width:9rpx; height:9rpx; border-right:2rpx solid var(--link); border-bottom:2rpx solid var(--link); transform:rotate(-45deg); }
.group-chevron.expanded { transform:rotate(45deg); margin-top:-5rpx; }
.project-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; padding:22rpx 0 24rpx; }
.project-row { position:relative; display:flex; flex-direction:column; align-items:stretch; min-width:0; min-height:200rpx; padding:0 0 18rpx; border:1rpx solid transparent; border-radius:25rpx; overflow:hidden; background:var(--soft); }
.project-visual { display:flex; align-items:center; justify-content:center; height:96rpx; margin-bottom:4rpx; }
.project-visual.has-art { height:118rpx; background:linear-gradient(140deg,#fff6fb,#f3dfed); }
.project-art { display:block; width:100%; height:138rpx; }
.project-visual.has-resource { height:138rpx; background:radial-gradient(ellipse at 50% 44%,#fff9fc 0%,#f7eaf3 72%,var(--soft) 100%); }
.project-asset { --catalog-art-size:138rpx; display:block; width:100%; height:138rpx; }
.project-result-art { --catalog-art-size:88rpx; display:block; flex-shrink:0; width:88rpx; height:88rpx; border-radius:18rpx; overflow:hidden; background:var(--soft); }
.project-row-copy { min-width:0; width:100%; padding:0 22rpx 0 16rpx; }
.project-name { display:block; color:var(--ink); font-size:28rpx; font-weight:650; line-height:1.45; overflow-wrap:anywhere; }
.project-summary { display:block; margin-top:5rpx; color:var(--muted); font-size:22rpx; line-height:1.5; }
.project-status { display:block; margin-top:8rpx; color:var(--link); font-size:22rpx; line-height:1.5; }
.project-row-end { position:absolute; right:8rpx; bottom:34rpx; }
.project-arrow { color:var(--muted); font-size:30rpx; }
.project-focused { border-color:var(--brand); }
.project-focused .project-name { color:var(--link); }
.project-search-panel { gap:12rpx; }
.project-search-box { display:flex; align-items:center; flex:1; min-width:0; min-height:88rpx; gap:16rpx; padding:0 22rpx; border:1rpx solid var(--border); border-radius:44rpx; background:var(--surface); }
.project-search-box .search-dot { flex-shrink:0; margin-right:8rpx; }
.project-search-input { flex:1; min-width:0; height:88rpx; color:var(--ink); font-size:28rpx; }
.project-search-clear,.project-search-cancel { min-height:88rpx; padding:16rpx 0; margin:0; background:transparent; border:0; color:var(--link); font-size:28rpx; }
.project-search-clear { min-width:64rpx; font-size:36rpx; }
.project-search-results { flex:1; display:flex; flex-direction:column; height:0; min-height:0; padding:0 28rpx; }
.project-search-summary { padding:0 0 16rpx; color:var(--muted); font-size:26rpx; }
.project-results-scroll { flex:1; height:0; min-height:0; width:100%; }
.project-result-row { display:flex; align-items:center; gap:16rpx; min-height:112rpx; padding:24rpx 0; border-bottom:1rpx solid var(--border); }
.project-result-copy { flex:1; min-width:0; }
.project-result-name { color:var(--ink); font-size:32rpx; line-height:1.5; }
.project-result-path { color:var(--muted); font-size:24rpx; line-height:1.6; margin-top:10rpx; }
.large-text .publish-hero { height:180rpx; }
.large-text .publish-hero-copy>view { font-size:46rpx; }
.large-text .publish-search-entry,.large-text .drafts-button { font-size:29rpx; }
.large-text .industry-choice { flex-direction:column; gap:6rpx; font-size:30rpx; text-align:center; }
.large-text .project-grid { grid-template-columns:minmax(0,1fr); }
.large-text .project-name,.large-text .project-group-title { font-size:34rpx; }
.large-text .project-summary,.large-text .group-summary,.large-text .group-count { font-size:28rpx; }
.large-text .project-group { flex-wrap:wrap; }
.large-text .group-count { margin-left:auto; }
.theme-dark .publish-hero { background:var(--soft); color:var(--ink); border-color:var(--border); }
.theme-dark .project-visual.has-art,.theme-dark .project-visual.has-resource { background:var(--soft); }
@media (max-width:350px) { .project-grid { grid-template-columns:minmax(0,1fr); } .industry-choice { gap:8rpx; font-size:26rpx; } }

.memorial-access { margin-top:14rpx; border-top:1rpx solid #d9d9d5; color:#484844; background:#e9e9e5; border-radius:22rpx; }
.memorial-access-icon { flex:0!important; flex-shrink:0!important; min-width:32rpx!important; font-size:34rpx; color:#66665e; }

.publish-tools-backdrop { position:fixed; z-index:10; inset:0; background:transparent; }
.publish-search-row { position:relative; z-index:12; }
.drafts-button:active { background:var(--soft); }

.publish-toolbar.has-menu { z-index:80; }
