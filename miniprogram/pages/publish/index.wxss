}
.publish-root.theme-prism:not(.funeral-scope) .publish-hero {
 border-color:#fff; color:var(--publish-ink,var(--ink)); box-shadow:inset 0 2rpx 4rpx #fff,var(--jelly-shadow);
 background:linear-gradient(111deg,#fffefd 10%,#fff5fa 57%,#edf0ff 100%);
