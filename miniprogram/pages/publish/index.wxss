page { height:100%; overflow:hidden; }
.theme-root.publish-root { display:flex; flex-direction:column; height:100vh; min-height:0; padding-bottom:calc(56px + env(safe-area-inset-bottom)); overflow:hidden; box-sizing:border-box; }
.publish-root>page-header { display:block; flex-shrink:0; }
.publish-root .publish-page.container { flex:1; display:flex; flex-direction:column; min-height:0; height:0; padding:16rpx 0 0; overflow:hidden; }
.publish-heading { display:flex; align-items:center; justify-content:space-between; gap:24rpx; padding:0 32rpx; }
.publish-heading .section-title { font-size:38rpx; }
.directory-summary { display:block; margin-top:10rpx; color:var(--muted); font-size:26rpx; line-height:1.6; }
.project-search-button { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:88rpx; height:88rpx; padding:0; margin:0; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); }
.project-search-button::after,.drafts-button::after,.project-search-clear::after,.project-search-cancel::after { border:0; }
.project-search-button .search-dot { margin:0 8rpx 5rpx 0; }
.publish-tools { display:flex; align-items:center; flex-shrink:0; gap:0; margin:16rpx 32rpx 20rpx; padding:18rpx 0; border-radius:24rpx; background:var(--surface); box-shadow:var(--elevation); }
.drafts-button { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; min-height:100rpx; margin:0; padding:8rpx 0; border:0; border-right:1rpx solid var(--border); border-radius:0; background:transparent; color:var(--ink); font-size:25rpx; line-height:1.5; }
.drafts-button:last-child { border-right:0; }
.drafts-button image { width:40rpx; height:40rpx; }
.publish-page>feedback-state,.publish-page>.notice { margin:0 32rpx; }
.project-browser { flex:1; display:grid; grid-template-columns:minmax(0,32fr) minmax(0,68fr); gap:0; height:0; min-height:0; border-top:1rpx solid var(--border); }
.industry-column,.project-column { display:flex; flex-direction:column; min-width:0; min-height:0; }
.industry-column { background:var(--soft-alt); }
.project-column { padding:0 24rpx; background:var(--surface); }
.industry-sidebar,.project-content { flex:1; height:0; min-height:0; width:100%; }
.industry-choice { position:relative; display:flex; align-items:center; min-height:104rpx; padding:22rpx 18rpx 22rpx 24rpx; color:var(--text); font-size:28rpx; line-height:1.6; word-break:break-all; }
.industry-choice.active { color:var(--link); background:var(--surface); font-weight:600; }
.industry-choice.active::before { content:''; position:absolute; top:24rpx; bottom:24rpx; left:0; width:5rpx; border-radius:0 4rpx 4rpx 0; background:var(--brand); }
.project-group-section { padding-bottom:24rpx; }
.project-group { display:flex; align-items:center; gap:12rpx; min-height:112rpx; padding:24rpx 0; border-bottom:1rpx solid var(--border); }
.project-group-title { flex:1; min-width:0; color:var(--ink); font-size:34rpx; font-weight:600; line-height:1.5; }
.group-count { flex-shrink:0; color:var(--muted); font-size:24rpx; }
.group-chevron { flex-shrink:0; width:10rpx; height:10rpx; border-right:2rpx solid var(--muted); border-bottom:2rpx solid var(--muted); transform:rotate(-45deg); }
.group-chevron.expanded { transform:rotate(45deg); margin-top:-6rpx; }
.project-row { display:flex; align-items:center; gap:14rpx; min-height:104rpx; padding:22rpx 0; border-bottom:1rpx solid var(--border); }
.project-name { flex:1; min-width:0; color:var(--text); font-size:30rpx; line-height:1.5; overflow-wrap:anywhere; }
.project-row-end { display:flex; align-items:center; gap:8rpx; flex-shrink:0; }
.project-status { max-width:108rpx; color:var(--muted); font-size:24rpx; line-height:1.5; }
.project-status.available { color:var(--link); }
.project-arrow { color:var(--muted); font-size:30rpx; }
.project-focused { background:var(--soft); }
.project-focused .project-name { color:var(--link); font-weight:600; }
.project-search-panel { display:flex; align-items:center; gap:16rpx; padding:0 32rpx 24rpx; }
.project-search-box { display:flex; align-items:center; flex:1; min-width:0; min-height:96rpx; gap:16rpx; padding:0 20rpx; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); }
.project-search-box .search-dot { flex-shrink:0; margin-right:8rpx; }
.project-search-input { flex:1; min-width:0; height:96rpx; color:var(--ink); font-size:28rpx; }
.project-search-clear,.project-search-cancel { min-height:88rpx; padding:16rpx 0; margin:0; background:transparent; border:0; color:var(--link); font-size:28rpx; }
.project-search-clear { min-width:64rpx; font-size:36rpx; }
.project-search-results { flex:1; display:flex; flex-direction:column; height:0; min-height:0; padding:0 32rpx; }
.project-search-summary { padding:0 0 16rpx; color:var(--muted); font-size:26rpx; }
.project-results-scroll { flex:1; height:0; min-height:0; width:100%; }
.project-result-row { display:flex; align-items:center; gap:16rpx; min-height:112rpx; padding:24rpx 0; border-bottom:1rpx solid var(--border); }
.project-result-copy { flex:1; min-width:0; }
.project-result-name { color:var(--ink); font-size:32rpx; line-height:1.5; }
.project-result-path { color:var(--muted); font-size:24rpx; line-height:1.6; margin-top:10rpx; }
.large-text .industry-choice,.large-text .project-name { font-size:34rpx; }
.large-text .project-group-title { font-size:38rpx; }
.large-text .project-status,.large-text .drafts-button { font-size:30rpx; }
.large-text .project-row { min-height:128rpx; }

.publish-hero { position:relative; flex-shrink:0; height:152rpx; overflow:hidden; margin:0 32rpx 18rpx; border-radius:24rpx; background:linear-gradient(110deg,#9E4266,#CB8697); color:#FFFFFF; }
.publish-hero-copy { position:relative; z-index:1; padding:24rpx 30rpx; }
.publish-hero-copy>view { font-size:42rpx; font-weight:700; line-height:1.4; letter-spacing:1rpx; }
.publish-hero-copy>text { display:block; margin-top:8rpx; font-size:27rpx; }
.publish-hero>image { position:absolute; right:8rpx; bottom:-30rpx; width:190rpx; height:190rpx; }
.publish-search-entry { flex-shrink:0; display:flex; align-items:center; gap:14rpx; min-height:72rpx; margin:0 32rpx; padding:16rpx 26rpx; border:1rpx solid var(--border); border-radius:48rpx; background:var(--surface); color:var(--muted); text-align:left; font-size:24rpx; line-height:1.5; }
.publish-search-entry::after,.industry-tile::after,.industry-overview-heading button::after { border:0; }
.publish-search-entry .search-dot { flex-shrink:0; margin-right:0; }
.industry-overview { flex:1; height:0; min-height:0; width:100%; padding:0 32rpx 24rpx; box-sizing:border-box; }
.industry-overview-heading { display:flex; align-items:center; justify-content:space-between; margin:4rpx 0 18rpx; color:var(--ink); font-size:32rpx; font-weight:650; line-height:1.5; }
.industry-overview-heading>view { border-left:6rpx solid var(--link); padding-left:16rpx; }
.industry-overview-heading text { font-size:24rpx; font-weight:400; color:var(--muted); }
.industry-overview-heading button { min-height:44px; padding:12rpx 0 12rpx 8rpx; margin:0; border:0; background:transparent; color:var(--link); font-size:25rpx; line-height:1.5; }
.industry-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14rpx; padding-bottom:24rpx; }
.industry-tile { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; min-height:120rpx; width:100%; margin:0; padding:12rpx 4rpx; border:0; border-radius:20rpx; background:var(--soft); color:var(--ink); font-size:25rpx; font-weight:500; line-height:1.5; }
.industry-tile image { width:60rpx; height:60rpx; }
.industry-column { background:var(--background); }
.industry-choice { border-radius:0 18rpx 18rpx 0; }
.industry-choice.active::before { border-radius:6rpx; }
.project-group-section { margin:10rpx 0 18rpx; }
.large-text .publish-hero { height:180rpx; }
.large-text .publish-hero-copy>view { font-size:44rpx; }
.large-text .industry-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
.large-text .industry-tile { min-height:156rpx; font-size:30rpx; }
.large-text .publish-tools { flex-wrap:wrap; }
.large-text .drafts-button { flex-basis:50%; font-size:30rpx; }
.theme-dark .publish-hero { background:var(--soft); color:var(--ink); }
