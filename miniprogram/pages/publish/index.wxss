page { height:100%; overflow:hidden; }
.theme-root.publish-root { display:flex; flex-direction:column; height:var(--page-viewport,100vh); min-height:0; padding-bottom:var(--page-bottom,calc(69px + env(safe-area-inset-bottom))); overflow:hidden; box-sizing:border-box; }
