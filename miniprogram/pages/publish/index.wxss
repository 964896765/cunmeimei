.project-search-panel { gap:12rpx; }
.project-search-box { display:flex; align-items:center; flex:1; min-width:0; min-height:88rpx; gap:16rpx; padding:0 22rpx; border:1rpx solid var(--publish-border,var(--border)); border-radius:44rpx; background:var(--surface); }
