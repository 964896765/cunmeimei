.publish-root.theme-prism:not(.funeral-scope) .publish-hero>image { right:19rpx; bottom:-8rpx; width:176rpx; height:176rpx; filter:drop-shadow(0 8rpx 10rpx #7b5b8230); }
.publish-root.theme-prism:not(.funeral-scope) .publish-tools-toggle { background:#f5f1f8; color:var(--publish-muted); box-shadow:inset 0 1rpx 0 #fff,var(--jelly-shadow); }
.publish-root.theme-prism:not(.funeral-scope) .publish-tools-toggle>view { border-color:currentColor; }
.publish-root.theme-prism:not(.funeral-scope) .publish-tools-toggle.is-open { background:linear-gradient(150deg,#c36c94,#a33e6d); color:#fff; }
.publish-root.theme-prism:not(.funeral-scope) .publish-search-entry,
.publish-root.theme-prism:not(.funeral-scope) .publish-tools {
 border-color:#fff; background:#fff; box-shadow:var(--jelly-shadow);
