.project-summary { display:block; margin-top:5rpx; color:var(--publish-muted,var(--muted)); font-size:22rpx; line-height:1.4; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.project-card-arrow { position:absolute; top:16rpx; right:10rpx; color:var(--publish-link,var(--link)); font-size:24rpx; line-height:1.45; opacity:.75; }
.project-focused { border-color:var(--publish-brand,var(--brand)); }
