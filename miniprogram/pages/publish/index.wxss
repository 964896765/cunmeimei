.publish-root.theme-prism:not(.funeral-scope) .project-column { background:transparent; }
.publish-root.theme-prism:not(.funeral-scope) .project-group.is-expanded { border-radius:20rpx; background:linear-gradient(120deg,#fff5fa,#fff); }
.publish-root.theme-prism:not(.funeral-scope) .project-row {
