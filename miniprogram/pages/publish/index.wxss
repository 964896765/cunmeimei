.publish-hero-copy>text { display:block; margin-top:10rpx; font-size:27rpx; }
.publish-hero>image { position:absolute; right:6rpx; bottom:-18rpx; width:186rpx; height:186rpx; }
.publish-search-row { display:flex; align-items:center; flex-shrink:0; gap:18rpx; margin:0 28rpx 28rpx; }
.publish-search-entry { display:flex; flex:1; align-items:center; gap:12rpx; min-width:0; min-height:88rpx; margin:0; padding:18rpx 24rpx; border:1rpx solid var(--surface); border-radius:50rpx; background:var(--surface); box-shadow:var(--elevation); color:var(--publish-muted,var(--muted)); text-align:left; font-size:25rpx; line-height:1.5; }
