/* PRISM GLASS 4.0 · Pearl Jelly */
.theme-root.publish-root.theme-prism:not(.funeral-scope) {
 --publish-background:#f8faff;
 background-color:var(--publish-background);
 --publish-ink:#2b2430;
 --publish-text:#423747;
 --publish-muted:#695a6a;
 --publish-border:#92708724;
 --publish-brand:#b24c79;
