<view class="theme-root publish-root {{themeClass}}" style="{{themeStyle}}">
<page-header id="navigation-header" transparent="{{true}}" title="发布内容" back="{{directoryOpen}}" bind:back="closeDirectory" large-text="{{displayPreferences.largeText}}"/>
<view class="container publish-page">
 <feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取发布配置" bind:action="loadConfig"/><view wx:if="{{configLoading}}" class="notice" role="status">正在核对发布项目与开放状态…</view>

 <block><view class="publish-hero"><view class="publish-hero-copy"><view>发布本地信息</view><text>27个行业 · 418个细分类目</text></view><image src="/assets/publish-checklist.png" mode="aspectFit" aria-hidden="true"/></view>
 <button wx:if="{{!projectSearchOpen}}" class="publish-search-entry" bindtap="toggleProjectSearch"><view class="search-dot"></view><text>搜索418个分类，例如：二手手机、房屋出租</text></button>
 <view class="publish-tools"><button class="drafts-button" bindtap="showGuidance"><image src="/assets/icons/center-about-{{iconPalette||'prism'}}.png"/><text>发布须知</text></button><button class="drafts-button" bindtap="openDrafts"><image src="/assets/icons/center-draft-{{iconPalette||'prism'}}.png"/><text>草稿箱</text></button><button class="drafts-button" bindtap="openRecords"><image src="/assets/icons/center-history-{{iconPalette||'prism'}}.png"/><text>发布进度</text></button><button class="drafts-button" bindtap="showHelp"><image src="/assets/icons/center-help-{{iconPalette||'prism'}}.png"/><text>常见问题</text></button></view>
 <view wx:if="{{projectSearchOpen}}" class="project-search-panel">
  <view class="project-search-box"><view class="search-dot" aria-hidden="true"></view><input class="project-search-input" value="{{projectQuery}}" focus="{{projectSearchFocused}}" maxlength="80" placeholder="搜索项目名称或别名" bindinput="searchProjects" aria-label="搜索发布项目名称或别名"/><button wx:if="{{projectQuery}}" class="project-search-clear" bindtap="clearProjectSearch" aria-label="清空项目搜索">×</button></view>
  <button class="project-search-cancel" bindtap="closeProjectSearch">取消</button>
 </view>
 <view wx:if="{{searchHasQuery}}" class="project-search-results">
  <view class="project-search-summary" aria-live="polite">找到 {{projects.length}} 个相关项目</view>
  <scroll-view class="project-results-scroll" scroll-y="true" scroll-top="{{searchScrollTop}}" enhanced="true" show-scrollbar="{{false}}">
   <view wx:for="{{projects}}" wx:key="id" class="project-result-row" data-id="{{item.id}}" bindtap="chooseProject" role="button" aria-label="{{item.name}}，{{configReady?item.readiness.label:'待核对'}}"><view class="project-result-copy"><view class="project-result-name">{{item.name}}</view><view class="project-result-path">{{item.categoryName}} · {{item.group}}</view></view><text class="project-status {{configReady&&item.readiness.canStart?'available':''}}">{{configReady?(item.readiness.canStart?'填写':item.readiness.label):'待核对'}}</text><text class="project-arrow" aria-hidden="true">›</text></view>
   <feedback-state wx:if="{{!projects.length}}" kind="empty" description="没有匹配项目，试试其他名称或简称。" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/>
  </scroll-view>
 </view>
 <scroll-view wx:elif="{{!directoryOpen}}" class="industry-overview" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="industry-overview-heading"><view>选择发布分类 <text>（27个行业）</text></view><button bindtap="openDirectory">全部分类 ›</button></view><view class="industry-grid"><button wx:for="{{categories}}" wx:key="id" class="industry-tile" data-id="{{item.id}}" bindtap="chooseIndustry" aria-label="{{item.name}}，查看细分类目"><image src="/assets/icons/{{item.icon}}-{{displayPreferences.theme==='prism'?'pearl':iconPalette}}.png" mode="aspectFit"/><text>{{item.name}}</text></button></view></scroll-view>
 <view wx:else class="project-browser {{projectSearchOpen?'with-search':''}}">
  <view class="industry-column"><scroll-view class="industry-sidebar" scroll-y="true" scroll-top="{{industryScrollTop}}" scroll-into-view="{{industryAnchor}}" bindscroll="onIndustryScroll" enhanced="true" show-scrollbar="{{false}}"><view wx:for="{{categories}}" wx:key="id" id="industry-{{item.id}}" class="industry-choice {{selectedCategory===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory" role="button" aria-selected="{{selectedCategory===item.id}}">{{item.name}}</view></scroll-view></view>
  <view class="project-column"><scroll-view class="project-content" scroll-y="true" scroll-top="{{projectScrollTop}}" bindscroll="onProjectScroll" enhanced="true" show-scrollbar="{{false}}">
    <view wx:for="{{groups}}" wx:key="id" wx:for-item="group" class="project-group-section">
     <view class="project-group" data-id="{{group.id}}" bindtap="toggleGroup" role="button" aria-expanded="{{expandedGroupId===group.id}}" aria-label="{{group.name}}，共{{group.items.length}}项，{{group.availableCount}}项已接入发布"><text class="project-group-title">{{group.name}}</text><text class="group-count">{{group.items.length}}项</text><view class="group-chevron {{expandedGroupId===group.id?'expanded':''}}" aria-hidden="true"></view></view>
     <block wx:if="{{expandedGroupId===group.id}}"><view wx:for="{{group.items}}" wx:key="id" class="project-row {{focusedProjectId===item.id?'project-focused':''}}" id="publish-project-{{item.id}}" data-id="{{item.id}}" bindtap="chooseProject" role="button" aria-label="{{item.name}}，{{configReady?item.readiness.label:'待核对'}}"><text class="project-name">{{item.name}}</text><view class="project-row-end"><text class="project-status {{configReady&&item.readiness.canStart?'available':''}}">{{configReady?(item.readiness.canStart?'填写':item.readiness.label):'待核对'}}</text><text class="project-arrow" aria-hidden="true">›</text></view></view></block>
    </view>
    <view wx:if="{{!groups.length}}" class="notice">该分类暂无项目。</view>
   </scroll-view>
  </view>
 </view>
 </block>

</view>
</view>
