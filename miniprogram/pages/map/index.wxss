.map-page { display:flex; flex-direction:column; height:100vh; min-height:0; overflow:hidden; background:var(--background); background-image:none!important; color:var(--ink); }
.theme-root.map-page.theme-prism { --page-wash:none; }
.map-page button::after { border:0; }
.map-tab-bar { flex-shrink:0; --channel-fill:var(--surface); border-bottom:1rpx solid var(--border); }
.map-stage { position:relative; display:flex; flex:1; flex-direction:column; width:100%; min-height:0; overflow:hidden; }
.map-canvas { position:relative; flex:1; min-height:0; width:100%; }
.information-map { width:100%; height:100%; display:block; }
.map-view-controls { flex-shrink:0; display:flex; align-items:center; justify-content:space-between; gap:8rpx; padding:0 24rpx 10rpx; background:var(--surface); border-bottom:1rpx solid var(--border); }
.map-view-segment { display:flex; align-items:center; gap:3rpx; padding:4rpx; border-radius:20px; background:var(--soft); }
.map-view-segment button,.map-tools button { display:flex; align-items:center; justify-content:center; min-height:36px; margin:0; padding:0 20rpx; border:1rpx solid transparent; border-radius:20px; background:transparent; color:var(--text); font-size:25rpx; line-height:1.35; }
.map-view-segment button.selected { background:var(--surface); color:var(--link); box-shadow:0 2rpx 6rpx #3d335522; font-weight:650; }
.map-tools { display:flex; align-items:center; gap:8rpx; }
.map-tools button { border-color:var(--border); background:var(--surface); color:var(--link); }
.map-tools .map-center { display:flex; align-items:center; justify-content:center; width:38px; padding:0; }
.map-center[disabled] { opacity:.55; }
.map-scope-notice { flex-shrink:0; padding:8rpx 24rpx; color:var(--muted); font-size:22rpx; }
.center-glyph { position:relative; width:15px; height:15px; border:1.5px solid currentColor; border-radius:50%; }
.center-glyph::after { content:''; position:absolute; width:5px; height:5px; inset:0; margin:auto; background:currentColor; border-radius:50%; }
.map-drawer { z-index:2; display:flex; flex-shrink:0; flex-direction:column; box-sizing:border-box; padding-bottom:env(safe-area-inset-bottom); overflow:hidden; background:var(--surface); border:1rpx solid var(--border); border-bottom:0; border-radius:26rpx 26rpx 0 0; box-shadow:0 -3px 16px #38304e16; transition:height .22s ease; }
.drawer-collapsed { height:calc(72px + env(safe-area-inset-bottom)); }
.drawer-half { height:45%; min-height:150px; }
.drawer-expanded { position:absolute; inset:0; height:100%; border-radius:0; }
.list-mode .map-drawer { position:relative; height:100%; min-height:0; border-radius:0; border:0; box-shadow:none; }
.reduce-motion .map-drawer { transition:none; }
.drawer-header { flex-shrink:0; padding:0 28rpx; }
.drawer-handle { display:flex; align-items:center; justify-content:center; height:18px; }
.drawer-grip { width:36px; height:4px; border-radius:4px; background:var(--control-border,var(--border)); }
.drawer-heading { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:4rpx 0 12rpx; border-bottom:1rpx solid var(--border); }
.list-mode .drawer-heading { padding-top:28rpx; }
.drawer-heading-copy { flex:1; min-width:0; }
.drawer-title { font-size:34rpx; font-weight:650; line-height:1.35; }
.map-summary { color:var(--muted); font-size:23rpx; line-height:1.55; }
.map-control { box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:12rpx; min-height:40px; margin:0; padding:0 18rpx; border-radius:40rpx; background:var(--soft); color:var(--ink); font-size:25rpx; line-height:1.45; font-weight:500; }
.map-control text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.map-city { flex-shrink:0; max-width:35%; font-weight:650; }
.map-chevron { flex-shrink:0; width:10rpx; height:10rpx; border-right:2rpx solid currentColor; border-bottom:2rpx solid currentColor; transform:translateY(-3rpx) rotate(45deg); }
.map-browse-controls { flex-shrink:0; display:flex; gap:9rpx; padding:12rpx 24rpx; background:var(--surface); }
.map-search { flex:1; min-width:0; justify-content:flex-start; color:var(--muted); text-align:left; }
.map-magnifier { position:relative; flex-shrink:0; width:18rpx; height:18rpx; border:2rpx solid currentColor; border-radius:50%; margin-right:5rpx; }
.map-magnifier::after { content:''; position:absolute; right:-7rpx; bottom:-4rpx; width:9rpx; height:2rpx; background:currentColor; transform:rotate(45deg); }
.map-filter-button { flex-shrink:0; padding:0 20rpx; color:var(--link); }
.map-filter-button.chosen,.filter-option.selected { background:var(--action); color:var(--on-action); border-color:transparent; }
.map-results { flex:1; min-height:0; height:0; width:100%; box-sizing:border-box; padding:0 28rpx 14rpx; }
.map-inline-note { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:12rpx 0; color:var(--muted); font-size:24rpx; }
.update-drawer { flex-shrink:0; min-height:36px; margin:0; padding:0 18rpx; border-radius:36px; background:var(--soft); color:var(--link); font-size:24rpx; line-height:36px; }
.map-result { display:flex; align-items:center; gap:18rpx; padding:18rpx 0; border-bottom:1rpx solid var(--border); }
.map-result.selected { border-color:transparent; border-radius:20rpx; padding-inline:12rpx; background:var(--soft); }
.map-result-image,.map-result-placeholder { width:108rpx; height:108rpx; flex-shrink:0; border-radius:18rpx; overflow:hidden; background:var(--soft); }
.map-result-placeholder { display:flex; align-items:center; justify-content:center; }
.map-result-placeholder image { width:52rpx; height:52rpx; }
.map-result-copy { flex:1; min-width:0; }
.map-result-title { color:var(--ink); font-size:30rpx; font-weight:600; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.map-result-meta,.map-result-fact { margin-top:5rpx; color:var(--muted); font-size:24rpx; line-height:1.5; }
.map-result-fact { color:var(--link); font-weight:600; }
.map-result-arrow { flex-shrink:0; font-size:40rpx; color:var(--muted); }
.map-result-locate { display:grid; place-items:center; flex-shrink:0; width:44px; height:44px; margin:0; padding:0; border-radius:16rpx; background:var(--soft); }
.map-result-locate image { width:48rpx; height:48rpx; }
.map-load-more { min-height:44px; margin:10rpx 0; background:var(--soft); color:var(--link); font-size:26rpx; border-radius:40rpx; }
.filter-heading { display:flex; align-items:center; justify-content:space-between; padding-bottom:18rpx; border-bottom:1rpx solid var(--border); font-size:35rpx; font-weight:650; }
.filter-heading button { min-height:44px; margin:0; padding:0 16rpx; background:var(--soft); color:var(--muted); border-radius:44rpx; font-size:26rpx; }
.filter-body { padding-top:20rpx; }
.filter-group { margin:24rpx 0; }
.filter-group-title { margin-bottom:12rpx; font-size:29rpx; font-weight:600; }
.filter-options { display:flex; flex-wrap:wrap; gap:10rpx; }
.filter-option { min-height:38px; margin:0; padding:12rpx 20rpx; border:1rpx solid var(--border); border-radius:42rpx; background:var(--soft); color:var(--ink); font-size:26rpx; line-height:1.5; }
.filter-footer { display:flex; gap:14rpx; padding-top:18rpx; border-top:1rpx solid var(--border); }
.filter-footer button { flex:1; min-height:44px; margin:0; padding:0 18rpx; border-radius:44rpx; font-size:28rpx; line-height:44px; }
.filter-reset { background:var(--soft); color:var(--ink); }
.filter-footer .filter-apply { flex:2; background:var(--action); color:var(--on-action); }
.large-text .drawer-title,.large-text .map-result-title { font-size:36rpx; }
.large-text .drawer-collapsed { height:calc(90px + env(safe-area-inset-bottom)); }
.large-text .map-control,.large-text .map-summary,.large-text .map-result-meta,.large-text .map-result-fact,.large-text .filter-option { font-size:30rpx; }
.large-text .map-view-segment button,.large-text .map-tools button { font-size:29rpx; }
.filter-hint { display:block; margin:-4rpx 0 12rpx; color:var(--muted); font-size:24rpx; line-height:1.55; }
.filter-option[disabled] { opacity:.54; }
