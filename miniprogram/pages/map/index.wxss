.map-page{height:100vh;min-height:0;overflow:hidden;position:relative;background:var(--background)}
.information-map{width:100%;height:100%}
.map-page button::after{border:0}.map-page button{font-weight:400}
.map-top{position:absolute;left:0;right:0;top:0;padding:10px 12px 8px;z-index:8;background:var(--background)}
.map-search{display:flex;align-items:center;gap:12px;height:48px;min-height:48px;width:100%;margin:0;padding:0 16px;border:1rpx solid var(--border);border-radius:14px;background:var(--surface);line-height:1.4;text-align:left}
.search-placeholder{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;color:var(--muted)}
.map-filter-scroll{margin-top:8px;height:40px;white-space:nowrap}
