<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="员工与权限" continuous="{{true}}" large-text="{{displayPreferences.largeText}}" back="{{true}}" native-back="{{true}}"/>
<view class="container"><feedback-state wx:if="{{loading}}" kind="loading" compact="{{true}}" description="正在读取员工权限…"/><feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" action-text="重新读取" bind:action="load"/><view class="subtitle">只有店主可以增删员工。店员仅能处理预约。</view>
 <view class="section"><view wx:for="{{items}}" wx:key="id" class="card staff-item"><view class="row"><view><view class="list-title">{{item.role==='owner'?'店主':(item.role==='manager'?'经理':'店员')}}</view><view class="list-desc">{{item.userId}}</view></view><button wx:if="{{canManage&&item.role!=='owner' && item.status==='active'}}" class="btn light" disabled="{{busy||loading}}" data-user="{{item.userId}}" bindtap="remove">移除</button></view></view></view>
 <view wx:if="{{canManage}}" class="section"><view class="section-title">添加员工</view><text class="field-label">员工用户 ID</text><input class="field" value="{{targetUser}}" placeholder="请员工在个人中心复制用户 ID" bindinput="setUser"/><text class="field-label">角色权限</text><picker mode="selector" range="{{roleNames}}" value="{{roleIndex}}" bindchange="chooseRole"><view class="field picker">{{roleNames[roleIndex]}} ⌄</view></picker><button class="btn" disabled="{{busy||loading}}" bindtap="add">添加或更新员工</button></view>
 <view class="notice">添加前请与员工核对用户 ID 和角色。移除权限后，该账号将无法继续访问商家业务。</view></view>

</view>
