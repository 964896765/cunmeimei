<view class="theme-root home-page {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="青方睐村美美" logo-src="/assets/brand-butterfly.jpg" subtitle="本地生活信息展示与查询" align="start" large-text="{{displayPreferences.largeText}}"/>
 <view class="container portal-page">
  <view class="home-search-row"><button class="home-city" bindtap="showArea" aria-label="当前浏览区域 {{region}}，选择城市"><image class="city-location" src="/assets/icons/location-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/><text>{{region}}</text></button><search-bar id="home-search" readonly="{{true}}" placeholder="搜索本地信息、服务或商家" bind:search="goSearch"/></view>
  <feedback-state wx:if="{{error}}" kind="error" title="{{cached?'显示已加载内容':'首页暂未更新'}}" description="{{error}}" compact="{{true}}" action-text="重试" bind:action="load"/>
  <swiper wx:if="{{banners.length}}" class="home-banners" current="{{bannerIndex}}" bindchange="changeBanner" indicator-dots="{{banners.length>1}}" indicator-active-color="#FFFFFF" autoplay="{{banners.length>1&&!displayPreferences.reduceMotion}}" interval="6000" circular="{{banners.length>1}}" duration="{{displayPreferences.reduceMotion?0:250}}">
   <swiper-item wx:for="{{banners}}" wx:key="id"><view class="home-banner {{item.cover?'with-photo':''}}" data-id="{{item.id}}" bindtap="openBanner" role="button" aria-label="{{item.label}} {{item.title}}"><image wx:if="{{item.cover}}" class="banner-cover" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="bannerImageError"/><view class="banner-caption"><text class="banner-label">{{item.label}}</text><view class="banner-title">{{item.title}}</view><text class="banner-summary">{{item.summary}}</text></view></view></swiper-item>
  </swiper>
  <swiper wx:else class="home-guides" current="{{bannerIndex}}" bindchange="changeBanner" indicator-dots="{{true}}" indicator-active-color="{{themeColor}}" autoplay="{{!displayPreferences.reduceMotion}}" interval="6000" circular="{{true}}" duration="{{displayPreferences.reduceMotion?0:250}}">
   <swiper-item wx:for="{{guides}}" wx:key="id"><view class="guide-card guide-{{item.id}} {{item.id==='nearby'&&!guidePhotoFailed?'guide-photo':''}}" data-id="{{item.id}}" bindtap="openGuide" role="button" aria-label="平台介绍，{{item.title}}，{{item.action}}"><image wx:if="{{item.id==='nearby'&&!guidePhotoFailed}}" class="guide-scene" src="/assets/xiangyang-river.jpg" mode="aspectFill" binderror="guideImageError" aria-hidden="true"/><view class="guide-copy"><text class="guide-label">{{item.id==='nearby'?'平台介绍 · 城市风景（襄阳）':'平台介绍'}}</text><view class="guide-title">{{item.title}}</view><text class="guide-summary">{{item.summary}}</text><text class="guide-action">{{item.action}} ›</text></view><image wx:if="{{item.id!=='nearby'}}" class="guide-art" src="{{item.id==='share'?'/assets/publish-checklist.png':'/assets/icons/industry-C03-pearl.png'}}" mode="aspectFit" aria-hidden="true"/></view></swiper-item>
  </swiper>
  <view class="quick-section"><view class="quick-heading"><text>常用分类</text><button class="text-action" bindtap="editShortcuts" aria-label="编辑常用分类">编辑</button></view><swiper class="quick-pages" current="{{quickPage}}" indicator-dots="{{false}}" autoplay="{{false}}" circular="{{false}}" duration="{{displayPreferences.reduceMotion?0:250}}" bindchange="changeQuickPage"><swiper-item wx:for="{{quickPages}}" wx:key="id" wx:for-item="group"><view class="quick-grid"><view class="quick-slot" wx:for="{{group.items}}" wx:key="id"><view wx:if="{{!item.empty}}" class="quick-item" data-id="{{item.id}}" bindtap="openQuick" role="button" aria-label="{{item.id==='more'?'全部分类':'浏览'+item.name}}"><view class="quick-icon"><image src="/assets/icons/{{item.icon}}-{{displayPreferences.theme==='prism'?'pearl':iconPalette}}.png" mode="aspectFit"/></view><text>{{item.name}}</text></view></view></view></swiper-item></swiper></view>
  <button class="merchant-invitation" bindtap="openMerchant"><view class="invitation-copy"><view class="invitation-title">本地商家入驻</view><text class="invitation-summary">发布服务 · 展示经营信息</text></view><image class="invitation-store" src="/assets/merchant-storefront.png" mode="aspectFit" aria-hidden="true"/><text class="invitation-action">立即入驻 ›</text></button>
  <view class="feed-tabs" role="tablist"><button wx:for="{{feedTabs}}" wx:key="id" class="feed-tab {{feedTab===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="changeFeed" role="tab" aria-selected="{{feedTab===item.id}}">{{item.label}}</button></view>
  <view class="featured-section"><content-card wx:for="{{featured}}" wx:key="id" item="{{item}}" layout="stream" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" bind:open="openFeatured" bind:favorite="toggleSaved"/><feedback-state wx:if="{{loading}}" kind="loading" description="正在读取同城信息…"/><feedback-state wx:elif="{{!feed.length&&!error}}" kind="empty" title="当前地区暂无公开信息" description="可切换地区浏览，或提交实用信息等待审核。" compact="{{true}}" action-text="去发现" bind:action="goDiscover"/><button wx:if="{{feed.length}}" class="feed-more" bindtap="goDiscover">浏览更多本地信息 ›</button></view>
  <view class="news-strip"><image class="news-speaker" src="/assets/icons/home-news-{{iconPalette}}.png" mode="aspectFit" aria-hidden="true"/><text class="news-strip-label">同城资讯</text><view class="news-strip-content"><view wx:if="{{news.length}}" class="news-headline" data-id="{{news[0].id}}" bindtap="openNews" role="button" aria-label="{{news[0].title}}，来源 {{news[0].sourceName}}">{{news[0].title}}</view><text wx:else class="news-empty">{{loading?'正在读取资讯…':'当前地区暂无最新资讯'}}</text></view><button wx:if="{{news.length}}" class="news-strip-more" bindtap="moreNews" aria-label="查看全部同城资讯">›</button></view>
  <button wx:if="{{!banners.length}}" class="photo-credit" bindtap="showPhotoCredit">城市摄影 · 襄阳汉江 · Fxqf / CC BY-SA 4.0</button>
 </view>
</view>
