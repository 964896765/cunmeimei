<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><view class="container portal-page">
 <view class="top-row"><view class="location" bindtap="showArea" role="button" aria-label="当前浏览区域：{{region}}，选择城市" hover-class="location-pressed"><image class="location-icon" src="/assets/icons/location-{{iconPalette||displayPreferences.theme||'prism'}}.png" aria-hidden="true"/><text class="location-label">{{region}}</text><view class="location-chevron" aria-hidden="true"></view></view></view>
 <view class="search" bindtap="goSearch" role="button" aria-label="全局搜索"><view class="search-dot"></view><text class="search-placeholder">搜索物品、房屋、商家、服务</text></view>
 <view wx:if="{{error}}" class="state-panel home-error" role="alert"><text>{{error}}</text><button class="btn light" bindtap="load">重新加载首页</button></view>
 <swiper wx:if="{{banners.length}}" class="home-banners" current="{{bannerIndex}}" bindchange="changeBanner" indicator-dots="{{banners.length>1}}" indicator-color="{{themeBorderColor}}" indicator-active-color="{{themeColor}}" autoplay="{{banners.length>1&&!displayPreferences.reduceMotion}}" interval="6000" circular="{{banners.length>1}}" duration="{{displayPreferences.reduceMotion?0:300}}"><swiper-item wx:for="{{banners}}" wx:key="id"><view class="home-banner" bindtap="openBanner" data-id="{{item.id}}" role="button" aria-label="{{item.label}}：{{item.title}}，查看详情"><image wx:if="{{item.cover}}" class="banner-cover" src="{{item.cover}}" mode="aspectFill" binderror="bannerImageError" data-id="{{item.id}}"/><view class="banner-caption"><text class="banner-label">{{item.label}}</text><view class="banner-title">{{item.title}}</view><view class="banner-summary">{{item.summary}}</view></view></view></swiper-item></swiper>
 <swiper wx:else class="city-guides" indicator-dots="true" indicator-color="{{themeBorderColor}}" indicator-active-color="{{themeColor}}" autoplay="{{false}}" circular="true"><swiper-item wx:for="{{guides}}" wx:key="id"><view class="guide-card" bindtap="openGuide" data-id="{{item.id}}"><view class="page-kicker">{{item.label}}</view><view class="title">{{item.title}}</view><view class="subtitle">{{item.subtitle}}</view><view class="guide-action">{{item.action}} ↗</view></view></swiper-item></swiper>
 <swiper class="quick-pages" current="{{quickPage}}" indicator-dots="{{false}}" autoplay="{{false}}" circular="{{false}}" duration="{{displayPreferences.reduceMotion?0:250}}" bindchange="changeQuickPage"><swiper-item wx:for="{{quickPages}}" wx:key="id" wx:for-item="group"><view class="quick-grid"><view class="quick-slot" wx:for="{{group.items}}" wx:key="id"><view wx:if="{{!item.empty}}" class="quick-item" data-id="{{item.id}}" bindtap="openQuick" role="button" aria-label="{{item.id==='more'?'管理快捷入口':'发现'+item.name}}"><view class="quick-icon"><image src="/assets/icons/{{item.icon}}-{{iconPalette}}.png" aria-hidden="true"/></view><text>{{item.name}}</text></view></view></view></swiper-item></swiper>
 <view class="section"><view class="section-head"><view class="section-title">同城资讯</view><button wx:if="{{news.length}}" class="more-link" bindtap="moreNews">更多资讯 ›</button></view><view class="news-entry" wx:for="{{news}}" wx:key="id" bindtap="openNews" data-id="{{item.id}}" role="button" aria-label="{{item.title}}，来源{{item.sourceName}}"><view class="news-title">{{item.title}}</view><view class="news-summary">{{item.summary}}</view><view class="news-source">{{item.sourceName}} · {{item.dateText}}</view></view><view wx:if="{{loading}}" class="state-panel" role="status">正在读取本地资讯…</view><view wx:elif="{{!news.length&&!error}}" class="state-panel"><view class="section-title">{{region==='选择城市'?'先选择浏览城市':'暂无最新资讯'}}</view><text>有明确来源并完成审核的本地生活资讯将在这里展示。</text></view></view>
</view>
</view>
