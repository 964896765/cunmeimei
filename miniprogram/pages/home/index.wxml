<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="青方睐村美美" align="start" large-text="{{displayPreferences.largeText}}"/>
 <view class="container portal-page">
  <button class="home-city" bindtap="showArea" aria-label="当前浏览区域 {{region}}，选择城市"><text>{{region}}</text><view class="city-chevron"></view></button>
  <search-bar id="home-search" readonly="{{true}}" placeholder="搜索物品、房屋、商家、服务" bind:search="goSearch"/>
  <feedback-state wx:if="{{error}}" kind="error" title="{{cached?'显示已加载内容':'首页暂未更新'}}" description="{{error}}" compact="{{true}}" action-text="重试" bind:action="load"/>
  <swiper wx:if="{{banners.length}}" class="home-banners" current="{{bannerIndex}}" bindchange="changeBanner" indicator-dots="{{banners.length>1}}" indicator-active-color="{{themeColor}}" autoplay="{{banners.length>1&&!displayPreferences.reduceMotion}}" interval="6000" circular="{{banners.length>1}}" duration="{{displayPreferences.reduceMotion?0:250}}">
   <swiper-item wx:for="{{banners}}" wx:key="id"><view class="home-banner" data-id="{{item.id}}" bindtap="openBanner" role="button" aria-label="{{item.label}} {{item.title}}"><image wx:if="{{item.cover}}" class="banner-cover" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="bannerImageError"/><view class="banner-caption"><text class="banner-label">{{item.label}}</text><view class="banner-title">{{item.title}}</view><text class="banner-summary">{{item.summary}}</text></view></view></swiper-item>
  </swiper>
  <view wx:elif="{{hero}}" class="featured-hero" data-id="{{hero.id}}" bindtap="openFeatured" role="button" aria-label="{{hero.title}}，查看详情">
   <image class="hero-image" src="{{hero.cover}}" mode="aspectFill" binderror="heroImageError"/>
   <view class="hero-copy"><text class="hero-category">{{hero.category}} · {{hero.district}}</text><view class="hero-title">{{hero.title}}</view><text wx:if="{{hero.priceText}}" class="hero-price">{{hero.priceText}}</text></view>
  </view>
  <view class="quick-section">
   <view class="quick-heading"><text class="section-title">常用分类</text><button class="text-action" bindtap="editShortcuts">管理</button></view>
   <swiper class="quick-pages" current="{{quickPage}}" indicator-dots="{{false}}" autoplay="{{false}}" circular="{{false}}" duration="{{displayPreferences.reduceMotion?0:250}}" bindchange="changeQuickPage"><swiper-item wx:for="{{quickPages}}" wx:key="id" wx:for-item="group"><view class="quick-grid"><view class="quick-slot" wx:for="{{group.items}}" wx:key="id"><view wx:if="{{!item.empty}}" class="quick-item" data-id="{{item.id}}" bindtap="openQuick" role="button" aria-label="{{item.id==='more'?'全部分类':'浏览'+item.name}}"><view class="quick-icon"><image src="/assets/icons/{{item.icon}}-{{iconPalette}}.png"/></view><text>{{item.name}}</text></view></view></view></swiper-item></swiper>
  </view>
  <view wx:if="{{featured.length||loading||(!feed.length&&!error)}}" class="section featured-section"><view class="section-head"><text class="section-title">精选信息</text><button class="text-action" bindtap="goDiscover">查看全部 ›</button></view>
   <content-card wx:for="{{featured}}" wx:key="id" item="{{item}}" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" bind:open="openFeatured"/>
   <feedback-state wx:if="{{loading}}" kind="loading" description="正在读取同城信息…"/>
   <feedback-state wx:elif="{{!feed.length&&!error}}" kind="empty" title="当前地区暂无公开信息" description="可以选择其他城市，或前往发现页浏览。" compact="{{true}}" action-text="去发现" bind:action="goDiscover"/>
  </view>
  <view class="section news-section"><view class="section-head"><text class="section-title">同城资讯</text><button wx:if="{{news.length}}" class="text-action" bindtap="moreNews">更多资讯 ›</button></view>
   <view class="news-entry" wx:for="{{news}}" wx:key="id" data-id="{{item.id}}" bindtap="openNews" role="button" aria-label="{{item.title}}，来源 {{item.sourceName}}"><view class="news-title">{{item.title}}</view><view class="news-summary">{{item.summary}}</view><view class="news-source">{{item.sourceName}} · {{item.dateText}}</view></view>
   <view wx:if="{{!loading&&!news.length&&!error}}" class="news-empty">当前地区暂无最新资讯</view>
  </view>
 </view>
</view>
