.portal-page{padding-top:8rpx}.portal-page .location{display:inline-flex;align-items:center;gap:12rpx;min-height:88rpx;max-width:100%;padding:10rpx 8rpx 10rpx 0;color:var(--ink)}.portal-page .top-row{min-height:88rpx}.location-icon{width:36rpx;height:36rpx;flex-shrink:0}.location-label{font-size:34rpx;font-weight:600;line-height:1.4;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.location-chevron{width:12rpx;height:12rpx;border-right:2rpx solid var(--muted);border-bottom:2rpx solid var(--muted);transform:translateY(-3rpx) rotate(45deg);flex-shrink:0;margin:0 6rpx 0 3rpx}.location-pressed{opacity:.72}.large-text .location-label{font-size:40rpx}.large-text .location-icon{width:40rpx;height:40rpx}.portal-page .search{margin-top:12rpx}.city-guides{height:252rpx;margin-top:18rpx}.guide-card{height:224rpx;padding:24rpx;border-radius:22rpx;border:1rpx solid var(--border);background:linear-gradient(120deg,var(--glow-rose),var(--glow-start),var(--glow));box-sizing:border-box}.guide-card .page-kicker{font-size:20rpx;letter-spacing:1rpx}.guide-card .title{font-size:32rpx;margin-top:10rpx}.guide-card .subtitle{font-size:23rpx}.guide-action{margin-top:12rpx;font-size:24rpx;color:var(--link)}.quick-scroll{width:100%;height:270rpx}.quick-item{text-align:center;min-width:0;font-size:23rpx;color:var(--text)}.quick-icon{height:72rpx;width:72rpx;margin:0 auto 10rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:linear-gradient(140deg,var(--soft),var(--soft-alt));border:1rpx solid var(--surface)}.quick-icon image{height:36rpx;width:36rpx}.quick-icon .search-dot{margin:0;width:22rpx;height:22rpx}.portal-page .section{margin-top:12rpx}.portal-page .state-panel{padding:28rpx 20rpx}.portal-page .state-panel .section-title{font-size:28rpx}.portal-page .state-panel>text{font-size:24rpx}.portal-page .state-panel .btn{max-width:310rpx;min-height:74rpx;margin:20rpx auto 0}.theme-clear .guide-card{background:var(--surface)}.large-text .guide-card .title{font-size:40rpx}.large-text .quick-scroll{height:320rpx}.large-text .quick-item{font-size:29rpx}


.quick-item>text{display:block;line-height:1.4;padding:0 6rpx;white-space:normal}

.quick-heading{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 4rpx;font-size:25rpx;color:var(--muted)}
.quick-edit{margin:0;padding:8rpx 2rpx 8rpx 16rpx;min-height:64rpx;background:transparent;color:var(--link);font-size:25rpx;line-height:1.5;font-weight:400}.quick-edit::after{border:0}
.quick-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:112rpx;gap:8rpx 0;width:100%;padding-top:8rpx}.quick-icon image{width:48rpx;height:48rpx}.quick-empty{padding:30rpx 0;color:var(--muted);font-size:25rpx;text-align:center}
.large-text .quick-grid{grid-auto-rows:150rpx}.large-text .quick-edit{font-size:29rpx}
.quick-pages{width:100%;height:246rpx}.large-text .quick-pages{height:322rpx}
.home-banners{height:320rpx;margin:18rpx 0 10rpx}.home-banner{height:292rpx;position:relative;overflow:hidden;border-radius:28rpx;background:linear-gradient(120deg,var(--glow-start),var(--soft-alt))}.banner-cover{width:100%;height:100%}.banner-caption{position:absolute;bottom:0;left:0;right:0;background:var(--surface);padding:16rpx 22rpx}.banner-label{font-size:22rpx;line-height:1.5;color:var(--link);border:1rpx solid var(--control-border);border-radius:8rpx;padding:2rpx 10rpx}.banner-title{font-size:var(--card-title);font-weight:600;line-height:1.5;color:var(--ink);margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.banner-summary{font-size:var(--card-meta);line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted)}.more-link{margin:0;padding:12rpx 0 12rpx 16rpx;background:transparent;color:var(--link);font-size:var(--card-meta);line-height:1.5}.more-link::after{border:0}.large-text .home-banners{height:420rpx}.large-text .home-banner{height:390rpx}
.large-text .city-guides{height:370rpx}.large-text .guide-card{height:338rpx}.large-text .guide-card .subtitle{font-size:30rpx}.large-text .guide-action{font-size:30rpx}

/* PRISM GLASS 3.0 page composition. */
.portal-page{padding-top:16rpx}.portal-page search-bar{margin:6rpx 0 24rpx}.guide-card{border-radius:30rpx;padding:30rpx;background:linear-gradient(120deg,var(--glow-start),var(--surface) 65%,var(--glow));border:1rpx solid var(--glass-line);box-shadow:var(--elevation)}.city-guides{height:280rpx}.guide-card{height:252rpx}.guide-card .title{font-size:36rpx;letter-spacing:-.5rpx}.quick-pages{margin:12rpx 0 20rpx}.quick-icon{border-radius:24rpx;background:var(--surface);border:1rpx solid var(--glass-line);box-shadow:0 8rpx 20rpx rgba(74,54,65,.045)}.home-banner{border-radius:30rpx}.news-entry{padding:28rpx 0}.large-text .guide-card .title{font-size:42rpx}
