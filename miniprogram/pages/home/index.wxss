.home-page { --header-logo-width:54rpx; --header-logo-height:72rpx; --header-logo-image-width:104rpx; --header-logo-image-height:156rpx; --header-logo-offset-x:-20rpx; --header-logo-offset-y:-34rpx; }
.portal-page { padding-top:12rpx; }
.home-search-row { display:flex; align-items:center; gap:20rpx; margin-bottom:20rpx; }
.home-search-row search-bar { flex:1; min-width:0; --search-height:40px; --search-font:24rpx; }
.home-city { display:flex; align-items:center; gap:10rpx; max-width:42%; min-height:88rpx; margin:0; padding:0; border:0; background:transparent; color:var(--ink); text-align:left; font-size:26rpx; font-weight:600; line-height:1.4; }
.home-city text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.city-location { flex-shrink:0; width:28rpx; height:34rpx; }
.home-city::after,.text-action::after,.merchant-invitation::after,.feed-tab::after,.feed-more::after,.photo-credit::after { border:0; }
.home-banners,.home-guides { height:238rpx; }
.home-banner,.guide-card { position:relative; height:238rpx; overflow:hidden; border-radius:24rpx; background:var(--soft); }
.banner-cover,.guide-scene { position:absolute; top:0; left:0; display:block; width:100%; height:100%; }
.banner-caption,.guide-copy { position:relative; z-index:1; padding:24rpx 30rpx; }
.with-photo .banner-caption,.guide-photo .guide-copy { height:100%; color:#FFFFFF; background:linear-gradient(90deg,rgba(25,27,37,.58),rgba(25,27,37,.03)); }
.banner-label,.guide-label { display:block; font-size:20rpx; line-height:1.4; opacity:.85; }
.banner-title,.guide-title { margin-top:8rpx; color:var(--ink); font-size:38rpx; font-weight:700; line-height:1.35; letter-spacing:1rpx; }
.banner-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.with-photo .banner-title,.guide-photo .guide-title { color:#FFFFFF; }
.banner-summary,.guide-summary { display:block; margin-top:10rpx; font-size:24rpx; line-height:1.5; }
.guide-action { display:block; margin-top:14rpx; color:var(--link); font-size:22rpx; font-weight:600; }
.guide-photo .guide-action { color:#FFFFFF; }
.guide-service .guide-copy,.guide-share .guide-copy { width:76%; }
.guide-service .guide-title,.guide-share .guide-title { font-size:34rpx; }
.guide-art { position:absolute; right:-2rpx; bottom:12rpx; width:180rpx; height:180rpx; }
.guide-service .guide-art { right:20rpx; bottom:36rpx; width:110rpx; height:110rpx; }
.quick-section { margin:20rpx -10rpx 16rpx; padding:0 8rpx 16rpx; border-radius:30rpx; background:var(--surface); box-shadow:var(--elevation); }
.quick-heading { display:flex; align-items:center; justify-content:space-between; height:52rpx; padding:0 18rpx; color:var(--muted); font-size:22rpx; }
.text-action { min-height:44px; margin:0; padding:12rpx 0 12rpx 24rpx; background:transparent; color:var(--link); font-size:24rpx; line-height:1.5; }
.quick-pages { height:248rpx; }
.quick-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12rpx 0; }
.quick-item { min-height:116rpx; text-align:center; color:var(--ink); font-size:23rpx; line-height:1.5; }
.quick-icon { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; margin:0 auto 8rpx; border-radius:22rpx; background:var(--soft); }
.quick-icon image { width:54rpx; height:54rpx; }
.quick-item text { display:block; padding:0 2rpx; white-space:nowrap; }
.merchant-invitation { display:flex; align-items:center; gap:12rpx; width:100%; min-height:64rpx; margin:0 0 20rpx; padding:12rpx 18rpx; border:0; border-radius:40rpx; background:var(--soft); color:var(--text); text-align:left; font-size:22rpx; line-height:1.6; }
.merchant-invitation image { width:28rpx; height:28rpx; flex-shrink:0; }
.merchant-invitation>text:first-of-type { flex:1; }
.invitation-action { flex-shrink:0; color:var(--link); font-weight:600; }
.feed-tabs { display:flex; align-items:center; gap:16rpx; margin-bottom:8rpx; }
.feed-tab { position:relative; flex:1; min-height:88rpx; margin:0; padding:18rpx 0; border:0; border-radius:0; background:transparent; color:var(--muted); font-size:25rpx; white-space:nowrap; line-height:1.5; }
.feed-tab.selected { color:var(--ink); font-weight:700; }
.feed-tab.selected::before { content:''; position:absolute; left:16%; right:16%; bottom:4rpx; height:5rpx; border-radius:5rpx; background:var(--link); }
.feed-more { width:100%; min-height:88rpx; margin:0; padding:20rpx; border:0; background:transparent; color:var(--link); font-size:26rpx; }
.news-section { margin-top:28rpx; padding:24rpx; border-radius:24rpx; background:var(--surface); }
.news-empty { color:var(--muted); font-size:26rpx; padding-top:12rpx; }
.photo-credit { margin:24rpx 0 0; padding:12rpx 0; min-height:44px; border:0; background:transparent; color:var(--muted); font-size:20rpx; }
.large-text .home-search-row { flex-wrap:wrap; }
.large-text .home-city { max-width:100%; font-size:32rpx; }
.large-text .home-search-row search-bar { flex-basis:100%; --search-font:30rpx; }
.large-text .home-guides,.large-text .home-banners,.large-text .home-banner,.large-text .guide-card { height:330rpx; }
.large-text .guide-title { font-size:42rpx; }
.large-text .guide-summary,.large-text .banner-summary { font-size:30rpx; }
.large-text .quick-pages { height:310rpx; }
.large-text .quick-item { min-height:146rpx; font-size:27rpx; }
.large-text .quick-item text { white-space:normal; }
.large-text .feed-tabs { flex-wrap:wrap; }
.large-text .feed-tab { flex-basis:40%; font-size:30rpx; }
.large-text .merchant-invitation { flex-wrap:wrap; font-size:28rpx; }
