.portal-page { padding-top:24rpx; }
.home-city { display:flex; align-items:center; gap:20rpx; max-width:100%; min-height:96rpx; margin:0 0 16rpx; padding:0; border:0; background:transparent; color:var(--ink); text-align:left; font-size:46rpx; font-weight:650; line-height:1.35; }
.home-city::after,.text-action::after { border:0; }
.home-city text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.city-chevron { flex-shrink:0; width:14rpx; height:14rpx; border-right:2rpx solid var(--muted); border-bottom:2rpx solid var(--muted); transform:rotate(45deg); margin-top:-6rpx; }
.portal-page search-bar { margin-bottom:28rpx; }
.featured-hero,.home-banner { overflow:hidden; border-radius:24rpx; border:1rpx solid var(--border); background:var(--surface); }
.hero-image,.banner-cover { display:block; width:100%; height:320rpx; }
.hero-copy,.banner-caption { padding:24rpx 26rpx; }
.hero-category,.banner-label { color:var(--muted); font-size:24rpx; line-height:1.5; }
.hero-title,.banner-title { margin-top:12rpx; color:var(--ink); font-size:36rpx; font-weight:600; line-height:1.45; }
.hero-price { display:block; margin-top:16rpx; color:var(--price); font-size:32rpx; font-weight:600; }
.home-banners { height:570rpx; margin-bottom:0; }
.banner-summary { display:block; margin-top:8rpx; color:var(--muted); font-size:26rpx; }
.quick-section { margin-top:40rpx; }
.quick-heading,.section-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.text-action { flex-shrink:0; min-height:88rpx; padding:16rpx 0 16rpx 16rpx; margin:0; background:transparent; border:0; color:var(--link); font-size:26rpx; line-height:1.5; }
.quick-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18rpx 0; padding-top:12rpx; }
.quick-pages { height:280rpx; }
.quick-item { min-height:112rpx; text-align:center; color:var(--text); font-size:24rpx; line-height:1.5; }
.quick-icon { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin:0 auto 12rpx; border-radius:18rpx; background:var(--surface); }
.quick-icon image { width:44rpx; height:44rpx; }
.quick-item text { display:block; padding:0 6rpx; }
.news-section { padding-top:36rpx; border-top:1rpx solid var(--border); }
.news-entry { padding:24rpx 0; border-bottom:1rpx solid var(--border); }
.news-title { color:var(--ink); font-size:32rpx; font-weight:600; line-height:1.5; }
.news-summary { color:var(--text); font-size:28rpx; line-height:1.7; margin-top:12rpx; }
.news-source,.news-empty { color:var(--muted); font-size:26rpx; line-height:1.7; margin-top:16rpx; }
.large-text .home-city { font-size:52rpx; }
.large-text .hero-image,.large-text .banner-cover { height:360rpx; }
.large-text .hero-title,.large-text .banner-title { font-size:40rpx; }
.large-text .quick-pages { height:340rpx; }
.large-text .quick-item { font-size:30rpx; }
.large-text .text-action { font-size:30rpx; }

.hero-title,.banner-title { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.banner-summary { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.large-text .home-banners { height:660rpx; }
