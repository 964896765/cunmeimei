<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
<view class="container detail-page">
 <view wx:if="{{loading}}" class="state-panel"><view class="skeleton"></view><text>正在加载详情…</text></view>
 <view wx:elif="{{error}}" class="state-panel"><view class="section-title">这条信息暂不可查看</view><text>{{error}}</text><button class="btn light" bindtap="refresh">重新加载</button></view>
 <block wx:elif="{{item}}">
 <swiper wx:if="{{item.images.length}}" class="gallery" indicator-dots="true"><swiper-item wx:for="{{item.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"/></swiper-item></swiper>
 <view class="section-card"><view class="row"><text class="badge">{{item.category}}</text><button class="share" open-type="share">分享 ↗</button></view><view class="detail-title">{{item.title}}</view><view wx:if="{{item.priceText}}" class="detail-price">{{item.priceText}}</view><view class="section-caption">{{item.locationText}}<text wx:if="{{item.dateText}}"> · {{item.dateText}}发布</text></view><view wx:if="{{item.categoryPath}}" class="metadata">{{item.categoryPath}}</view><view wx:if="{{item.meta}}" class="metadata">{{item.meta}}</view></view>
 <view wx:if="{{item.displayFieldCount>0}}" class="section-card"><view wx:for="{{item.displayFields}}" wx:key="key" class="detail-attribute"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
 <view class="section-card"><view class="section-title">{{item.kind==='merchant'?'商家资料':'详细说明'}}</view><view class="body-copy">{{item.detail}}</view><view wx:if="{{item.expiresAt}}" class="notice">信息有效期有限，请联系发布者确认当前情况。</view></view>
 <view wx:if="{{item.kind==='merchant'}}" class="section-card"><view class="section-title">可预约服务</view><view wx:for="{{item.services}}" wx:key="id" class="service-link" data-id="{{item.id}}" bindtap="openService"><text>{{item.title}}</text><text>查看 ›</text></view><view wx:if="{{!item.services.length}}" class="notice">暂未上架可预约服务。</view></view>
 <view wx:if="{{item.type==='community'}}" class="section-card">
  <view class="row"><view class="section-title">街坊交流</view><text class="link" role="button" aria-disabled="{{likeBusy}}" bindtap="like">{{likeBusy?'处理中…':liked?'已赞':'点赞'}} · {{likes}}</text></view>
  <view wx:if="{{interactionError}}" class="inline-feedback"><text>{{interactionError}}</text><button class="btn light" bindtap="loadInteractions">重新加载交流</button></view>
  <view wx:elif="{{interactionLoading}}" class="notice">正在同步交流内容…</view>
  <view wx:for="{{comments}}" wx:key="id" class="comment"><text class="badge">街坊留言</text><view wx:if="{{item.parentId}}" class="notice">回复街坊留言</view><view class="body-copy">{{item.body}}</view><view class="row"><text class="link" data-id="{{item.id}}" bindtap="reply">回复</text><text wx:if="{{item.mine}}" class="link danger-text" data-id="{{item.id}}" bindtap="deleteComment">删除我的留言</text></view></view>
  <view wx:if="{{!comments.length&&!interactionLoading&&!interactionError}}" class="notice">还没有公开留言，分享你的想法吧。</view>
  <view wx:if="{{commentPageError}}" class="inline-feedback" role="alert"><text>{{commentPageError}}</text><button class="btn light" bindtap="moreComments" disabled="{{commentsLoading||interactionLoading}}">重试加载留言</button></view>
  <button wx:elif="{{commentHasMore}}" class="btn light" bindtap="moreComments" loading="{{commentsLoading}}" disabled="{{commentsLoading||interactionLoading}}">查看更多留言</button>
  <view wx:if="{{replyTo}}" class="row"><text class="badge">正在回复留言</text><text class="link" bindtap="cancelReply">取消回复</text></view>
  <textarea class="field-area" value="{{comment}}" maxlength="500" placeholder="友善交流，请勿发布联系方式或隐私" bindinput="setComment"/>
  <view wx:if="{{commentError}}" class="inline-feedback comment-error" role="alert">{{commentError}} 输入内容已保留，可重试提交。</view>
  <view wx:if="{{commentNotice}}" class="notice comment-notice" role="status">{{commentNotice}}</view>
  <button class="btn light" loading="{{commenting}}" disabled="{{commenting}}" bindtap="sendComment">提交留言审核</button>
 </view>
 <view wx:if="{{item.publisher}}" class="section-card"><view class="section-title">{{item.publisher.name}}</view><view class="trust-badges"><text wx:if="{{item.publisher.phoneVerified}}" class="badge">手机号已验证</text><text wx:if="{{item.publisher.qualificationVerified}}" class="badge">{{item.type==='housing'?'房源材料已核验':'业务材料已核验'}}</text><text class="badge">内容审核通过</text></view><view wx:if="{{item.contact.phoneAvailable}}" class="body-copy">发布者已授权查看电话，点击拨打时验证权限</view><view class="notice">各项核验分别进行，不代表平台保证信息完全真实。</view></view>
 <view class="section-card trust-note"><view>请核实信息后再作决定，不提前转账。</view><view class="row"><text class="link" bindtap="warn">信息与交易提示</text><text wx:if="{{item.kind!=='merchant'}}" class="link" bindtap="report">举报此内容</text></view></view>
 <view wx:if="{{favoriteError}}" class="inline-feedback"><text>{{favoriteError}}</text><button class="btn light" bindtap="retryFavorite">重试收藏状态</button></view>
 <view wx:if="{{historyNotice}}" class="notice">{{historyNotice}}</view>
 <view wx:if="{{contactError}}" id="contact-feedback" class="inline-feedback contact-error" role="alert"><text>{{contactError}} 联系申请内容已保留。</text><button class="btn light" bindtap="talk" disabled="{{contactBusy}}">重新申请联系</button></view>
 <view wx:if="{{reportError}}" id="report-feedback" class="inline-feedback report-error" role="alert"><text>{{reportError}} 举报描述已保留。</text><button class="btn light" bindtap="report" disabled="{{reportBusy}}">重新提交举报</button></view>
 <view class="detail-buttons"><button class="btn light favorite" loading="{{saving||favoriteLoading}}" disabled="{{saving||!favoriteReady}}" bindtap="toggleFavorite">{{faved?'已收藏':'收藏'}}</button><button wx:if="{{canBook}}" class="btn primary" bindtap="book">选择时段 · 预约</button><block wx:elif="{{item.kind!=='merchant'}}"><button wx:if="{{item.contact.phoneAvailable}}" class="btn light" bindtap="callPublisher" loading="{{phoneBusy}}" disabled="{{phoneBusy}}">拨打电话</button><button wx:if="{{!item.contact||item.contact.allowMessages}}" class="btn primary" bindtap="talk" loading="{{contactBusy}}" disabled="{{contactBusy}}">私信发布者</button><text wx:else class="notice">发布者已关闭陌生人私信</text></block></view>
 </block>
</view>

</view>
