<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="{{item.kind==='merchant'?'商家详情':item.kind==='service'?'服务详情':'信息详情'}}" continuous="{{true}}" large-text="{{displayPreferences.largeText}}" back="{{true}}" native-back="{{true}}"/>
<view class="container detail-page">
 <feedback-state wx:if="{{loading}}" kind="loading" description="正在加载详情…" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/>
 <feedback-state wx:elif="{{error}}" kind="error" title="这条信息暂不可查看" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新加载" bind:action="refresh"/>
 <block wx:elif="{{item}}">
 <swiper duration="{{displayPreferences.reduceMotion?0:250}}" wx:if="{{item.images.length}}" class="gallery" indicator-dots="{{item.images.length>1}}"><swiper-item wx:for="{{item.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"/></swiper-item></swiper>
 <view class="section-card detail-summary"><view class="row"><status-badge   label="{{item.category}}"/><button class="share" open-type="share">分享 ↗</button></view><view class="detail-title">{{item.title}}</view><view wx:if="{{item.priceText}}" class="detail-price">{{item.priceText}}</view><view class="section-caption">{{item.locationText}}<text wx:if="{{item.dateText}}"> · {{item.dateText}}发布</text></view><view wx:if="{{item.categoryPath}}" class="metadata">{{item.categoryPath}}</view><view wx:if="{{item.meta&&!item.displayFieldCount}}" class="metadata">{{item.meta}}</view></view>
 <view wx:if="{{item.displayFieldCount>0}}" class="section-card detail-facts"><view wx:for="{{item.displayFields}}" wx:key="key" class="detail-attribute"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
 <view class="section-card detail-description"><view class="section-title">{{item.kind==='merchant'?'商家资料':'详细说明'}}</view><view class="body-copy">{{item.detail}}</view><view wx:if="{{item.expiresAt}}" class="notice">信息有效期有限，请联系发布者确认当前情况。</view></view>
 <view wx:if="{{item.kind==='merchant'}}" class="section-card"><view class="section-title">可预约服务</view><view wx:for="{{item.services}}" wx:key="id" class="service-link" data-id="{{item.id}}" bindtap="openService"><text>{{item.title}}</text><text>查看 ›</text></view><view wx:if="{{!item.services.length}}" class="notice">暂未上架可预约服务。</view></view>
 <view wx:if="{{item.publisher}}" class="section-card"><view class="section-title">{{item.publisher.name}}</view><view class="trust-badges"><status-badge  wx:if="{{item.publisher.phoneVerified}}"  label="手机号已验证"/><status-badge  wx:if="{{item.publisher.qualificationVerified}}"  label="{{item.type==='housing'?'房源材料已核验':'业务材料已核验'}}"/><status-badge   label="内容审核通过"/></view><view wx:if="{{item.contact.phoneAvailable}}" class="body-copy">发布者已授权查看电话，点击拨打时验证权限</view><view class="notice">各项核验分别进行，不代表平台保证信息完全真实。</view></view>
 <view class="section-card trust-note"><view>请核实信息后再作决定，不提前转账。</view><view class="row"><text class="link" bindtap="warn">信息与交易提示</text><text wx:if="{{item.kind!=='merchant'}}" class="link" bindtap="report">举报此内容</text></view></view>
 <feedback-state wx:if="{{favoriteError}}" kind="error" description="{{favoriteError}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重试收藏状态" bind:action="retryFavorite"/>
 <view wx:if="{{historyNotice}}" class="notice">{{historyNotice}}</view>
 <feedback-state wx:if="{{contactError}}" id="contact-feedback" kind="error" description="{{contactError}} 联系申请内容已保留。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新申请联系" bind:action="talk" action-disabled="{{contactBusy}}"/>
 <feedback-state wx:if="{{reportError}}" id="report-feedback" kind="error" description="{{reportError}} 举报描述已保留。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新提交举报" bind:action="report" action-disabled="{{reportBusy}}"/>
 <view class="detail-buttons"><button class="btn light favorite" loading="{{saving||favoriteLoading}}" disabled="{{saving||!favoriteReady}}" bindtap="toggleFavorite">{{faved?'已收藏':'收藏'}}</button><button wx:if="{{canBook}}" class="btn primary" bindtap="book">选择时段 · 预约</button><block wx:elif="{{item.kind!=='merchant'}}"><button wx:if="{{item.contact.phoneAvailable}}" class="btn light" bindtap="callPublisher" loading="{{phoneBusy}}" disabled="{{phoneBusy}}">拨打电话</button><button wx:if="{{!item.contact||item.contact.allowMessages}}" class="btn primary" bindtap="talk" loading="{{contactBusy}}" disabled="{{contactBusy}}">私信发布者</button><text wx:else class="notice">发布者已关闭陌生人私信</text></block></view>
 </block>
</view>

</view>
