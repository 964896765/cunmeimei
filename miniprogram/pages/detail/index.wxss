.gallery{height:480rpx;border-radius:24rpx;overflow:hidden}.gallery image{width:100%;height:100%}.detail-title{font-size:38rpx;font-weight:600;line-height:1.45;margin:16rpx 0}.detail-price{font-size:42rpx;color:var(--price);font-weight:600}.metadata{margin-top:18rpx;background:var(--soft);border-radius:20rpx;padding:18rpx;font-size:25rpx;color:var(--ink)}.section-card .body-copy{margin-top:20rpx}.detail-buttons{display:flex;gap:16rpx;position:sticky;bottom:0;padding:18rpx 0 calc(18rpx + env(safe-area-inset-bottom));background:var(--background)}.detail-buttons .favorite{flex:0 0 180rpx}.detail-buttons .primary{flex:1}.trust-note{font-size:24rpx;color:var(--muted)}.share{background:transparent;font-size:23rpx;color:var(--link);margin:0;padding:8rpx;line-height:1.6}.share::after{border:0}.service-link{display:flex;justify-content:space-between;border-bottom:1rpx solid var(--border);padding:24rpx 0;font-size:26rpx}
.large-text .detail-title{font-size:44rpx}.large-text .metadata,.large-text .trust-note{font-size:29rpx}
.large-text .detail-buttons{flex-wrap:wrap}.large-text .detail-buttons .favorite,.large-text .detail-buttons .primary{flex:1 1 240rpx}

.detail-attribute{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0;font-size:28rpx;line-height:1.6}.detail-attribute text:first-child{color:var(--muted);flex-shrink:0}.detail-attribute text:last-child{text-align:right;overflow-wrap:anywhere}

.trust-badges{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}

/* PRISM GLASS 3.0 page composition. */
.detail-page{padding-top:24rpx}.detail-title{line-height:1.45;letter-spacing:-.5rpx}.detail-price{color:var(--price)}.gallery{border-radius:30rpx;overflow:hidden}.detail-page .section-card{margin:24rpx 0}

/* VM page composition. */
.detail-page .detail-summary { margin:0; padding:28rpx 0; border:0; border-radius:0; background:transparent; }
.detail-title { font-size:44rpx; font-weight:650; line-height:1.35; }
.detail-price { font-size:44rpx; }
.detail-page .detail-facts { padding:24rpx 0; border-width:1rpx 0; border-radius:0; }
.detail-page .detail-description { padding:12rpx 0 28rpx; border:0; border-radius:0; background:transparent; }
.detail-attribute { min-height:96rpx; align-items:center; font-size:30rpx; }
.metadata { padding:14rpx 0; border-radius:0; background:transparent; color:var(--muted); font-size:26rpx; }
.gallery { border-radius:20rpx; }
.share { min-height:88rpx; font-size:26rpx; }
.detail-buttons .btn { min-height:96rpx; }
