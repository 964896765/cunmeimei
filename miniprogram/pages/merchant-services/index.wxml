<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="服务管理" continuous="{{true}}" large-text="{{displayPreferences.largeText}}" back="{{true}}" native-back="{{true}}"/>
<view class="container"><view class="title">服务项目</view><view class="subtitle">服务由店主或经理提交，平台审核后公开。</view>
 <feedback-state wx:if="{{loading}}" kind="loading" description="正在读取服务项目…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/>
 <feedback-state wx:if="{{loadError}}" kind="error" description="{{loadError}}下方保留上次读取的记录，重新读取成功后可继续编辑。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取服务项目" bind:action="load" action-disabled="{{loading}}"/>
 <view class="section"><view class="section-title">当前项目</view><view wx:for="{{items}}" wx:key="id" class="card list-row"><view class="list-title">{{item.title}}</view><view class="list-desc">{{item.imageIds.length}} 张照片 · {{item.price}} · {{item.status==='pending_review'?'待审核':(item.status==='published'?'已上架':(item.status==='draft'?'商家已暂停':'平台已下架'))}}</view>
  <button wx:if="{{canEdit && item.status!=='disabled'}}" size="mini" class="btn light" data-id="{{item.id}}" catchtap="editService">编辑并重新审核</button>
  <view wx:if="{{canEdit && (item.status==='published' || item.status==='draft')}}" class="service-actions">
   <button size="mini" plain="true" data-id="{{item.id}}" data-action="{{item.status==='published'?'pause':'resubmit'}}" catchtap="serviceAction">{{item.status==='published'?'暂停服务':'重新提交审核'}}</button>
  </view>
 </view><feedback-state wx:if="{{!items.length&&!loading&&!loadError}}" kind="empty" description="还没有服务项目" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/></view>
 <view class="section" wx:if="{{canEdit}}"><view class="row"><view class="section-title">{{editingId?'编辑服务（需重审）':'新增服务'}}</view><text wx:if="{{editingId}}" class="link" bindtap="cancelEdit">取消编辑</text></view><text class="field-label">服务名称</text><input class="field" maxlength="100" value="{{title}}" placeholder="例如：家电上门维修" data-field="title" bindinput="input"/><text class="field-label">服务说明</text><textarea class="field-area" maxlength="1200" value="{{description}}" placeholder="服务内容、适用范围与注意事项" data-field="description" bindinput="input"/><text class="field-label">参考价格</text><input class="field" maxlength="80" value="{{price}}" data-field="price" bindinput="input"/><text class="field-label">服务实拍（最多6张，单张2MB）</text><view class="notice">仅上传有权使用的真实服务照片，不要包含客户隐私。修改图片后仍需平台审核。</view><view class="service-photos"><view wx:for="{{photos}}" wx:key="id" class="service-photo"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewPhoto"/><view wx:else class="photo-placeholder">图片已保存</view><text class="remove-photo" data-index="{{index}}" bindtap="removePhoto">移除</text></view><button wx:if="{{photos.length<6}}" class="add-photo" bindtap="choosePhotos" disabled="{{uploading||saving}}">{{uploading?'上传中…':'＋ 添加照片'}}</button></view><feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/><button class="btn" bindtap="submit" loading="{{saving}}" disabled="{{saving||uploading}}">提交审核</button></view>
</view>

</view>
