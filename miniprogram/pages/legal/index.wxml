<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header id="navigation-header" title="{{title}}" back="{{true}}" bind:back="back" large-text="{{displayPreferences.largeText}}"/><view class="container"><feedback-state wx:if="{{loading}}" kind="loading" description="正在读取…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/><feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取" bind:action="load"/><view wx:if="{{!configured&&!loading}}" class="notice">运营信息尚待配置，正式登录暂不可用。</view><view class="legal-copy"><text wx:for="{{blocks}}" wx:key="id" class="legal-block {{item.kind}}" selectable="true">{{item.kind==='bullet'?'• ':''}}{{item.text}}</text></view><button wx:if="{{title==='隐私政策'}}" class="btn light" bindtap="openPlatformPrivacy">查看微信隐私保护指引</button></view></view>
