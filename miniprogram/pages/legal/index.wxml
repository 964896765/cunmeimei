<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header title="{{title}}" back="{{true}}" bind:back="back" large-text="{{displayPreferences.largeText}}"/><view class="container"><view wx:if="{{loading}}" class="state-panel">正在读取…</view><view wx:if="{{error}}" class="state-panel" role="alert">{{error}}<button class="btn light" bindtap="load">重新读取</button></view><view wx:if="{{!configured&&!loading}}" class="notice">运营信息尚待配置，正式登录暂不可用。</view><view class="legal-copy" selectable="true">{{body}}</view><button wx:if="{{title==='隐私政策'}}" class="btn light" bindtap="openPlatformPrivacy">查看微信隐私保护指引</button></view></view>
