<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header id="navigation-header" title="沟通进度" back="{{true}}" large-text="{{displayPreferences.largeText}}" bind:back="back"/><view class="container business-page">
 <view wx:if="{{privateLocked}}" id="account-access-gate" class="state-panel"><view class="section-title">登录后查看本人沟通记录</view><view class="notice">双方约定与处理说明默认不公开。</view><button class="btn" id="account-access-login" bindtap="signin">微信登录并继续</button></view>
 <block wx:else><feedback-state wx:if="{{error}}" kind="error" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取" bind:action="load"/><feedback-state wx:if="{{loading}}" kind="loading" description="正在读取业务记录…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/>
 <view wx:if="{{pending}}" class="section-card"><view>有一项操作结果待核对。</view><button class="btn" bindtap="resume" disabled="{{busy}}">核对原操作</button><button class="center-link" bindtap="clearPending" disabled="{{busy}}">已核对，清除本机请求</button></view>
 <view wx:if="{{createSource}}" class="section-card"><view class="section-title">连接原联系或预约</view><view class="body-copy">仅已接受的联系或已确认预约可以建立双方沟通记录。原内容会保留快照，约定时间、完成和取消均需双方核对。</view><view class="notice">说明仅向参与人开放，请围绕原信息沟通。</view><button id="business-create" class="btn" bindtap="create" disabled="{{busy||pending}}">核对后建立沟通记录</button></view>
 <block wx:elif="{{item}}"><view class="section-card"><view class="case-heading"><view class="section-title">{{item.snapshot.title}}</view><status-badge   label="{{item.statusText}}" status="{{item.status}}"/></view><view class="notice">{{item.snapshot.projectName||'原服务预约'}} · {{item.is_owner?'发布方记录':'申请方记录'}}</view><view wx:if="{{item.scheduledText}}" class="body-copy">双方约定时间：{{item.scheduledText}}</view><view wx:if="{{item.proposedText}}" class="notice">待核对的时间提议：{{item.proposedText}}</view><view wx:if="{{item.resolution}}" class="body-copy">处理结论：{{item.resolutionText}}。{{item.resolution}}</view><button class="center-link" bindtap="original">查看原信息记录</button></view>
 <disclosure-section id="original-communication" title="原信息与约定" summary="{{item.snapshot.projectName||'预约意向'}}" large-text="{{displayPreferences.largeText}}"><view class="body-copy" selectable="true">{{item.snapshot.detail}}</view><view wx:for="{{item.snapshotFields}}" wx:key="key" class="snapshot-field"><view class="field-label">{{item.label}}</view><view class="body-copy" selectable="true">{{item.value}}</view></view><view wx:if="{{item.snapshot.price}}" class="notice">原价格说明：{{item.snapshot.price}}</view><view wx:if="{{item.snapshot.request}}" class="notice" selectable="true">原联系：{{item.snapshot.request}}</view><view wx:if="{{item.snapshot.acceptedResponse}}" class="notice" selectable="true">原答复：{{item.snapshot.acceptedResponse}}</view><view class="notice">原信息与双方说明用于核对本次联系意向。</view></disclosure-section>
 <view wx:if="{{actionRows.length}}" class="section-card"><view class="section-title">处理本次沟通</view><view wx:if="{{item.source_kind!=='booking'&&item.kind!=='event'&&(item.status==='open'||item.status==='scheduled')}}" class="schedule-fields"><picker mode="date" value="{{date}}" data-key="date" bindchange="input"><view class="field">{{date||'约定日期'}} ⌄</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="input"><view class="field">{{time||'约定整点或半点'}} ⌄</view></picker></view><textarea class="field-area case-note" value="{{body}}" data-key="body" bindinput="input" maxlength="800" placeholder="至少8字说明，请先核对原约定；不填手机号或证件号" aria-label="本次沟通处理说明"/><button wx:if="{{primaryAction}}" class="btn case-primary" id="business-action-{{primaryAction.id}}" data-action="{{primaryAction.id}}" bindtap="act" disabled="{{busy||pending}}">{{primaryAction.name}}</button><disclosure-section wx:if="{{secondaryActions.length}}" id="more-communication-actions" title="其他沟通操作" summary="{{secondarySummary}}" large-text="{{displayPreferences.largeText}}"><view class="case-actions"><button wx:for="{{secondaryActions}}" wx:key="id" class="btn light" id="business-action-{{item.id}}" data-action="{{item.id}}" bindtap="act" disabled="{{busy||pending}}">{{item.name}}</button></view></disclosure-section></view>
 <view class="section-card"><view class="section-title">处理历史</view><view wx:for="{{historyExpanded?item.events:item.recentEvents}}" wx:key="id" class="case-event"><view class="field-label">{{item.title}} · {{item.mine?'本人':'对方或运营'}}</view><view class="body-copy" selectable="true">{{item.body}}</view><view wx:if="{{item.timeText}}" class="notice">{{item.timeText}}</view><view class="notice">{{item.dateText}}</view></view><button wx:if="{{item.events.length>3}}" class="center-link" bindtap="toggleHistory">{{historyExpanded?'收起历史':'查看全部处理历史（'+item.events.length+'）'}}</button></view></block>
 <block wx:else><view class="case-filters"><button wx:for="{{filters}}" wx:key="id" class="{{filter===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="filter" aria-pressed="{{filter===item.id}}">{{item.name}}</button></view><view wx:for="{{items}}" wx:key="id" class="section-card" data-id="{{item.id}}" bindtap="open" role="button"><view class="case-heading"><view class="section-title">{{item.snapshot.title}}</view><status-badge   label="{{item.statusText}}" status="{{item.status}}"/></view><view wx:if="{{item.scheduledText}}" class="notice">约定：{{item.scheduledText}}</view><view class="notice">更新：{{item.dateText}}</view></view><view wx:if="{{!loading&&!items.length}}" class="state-panel">暂无本类沟通进度。接受联系或确认预约后，可从原记录建立双方处理进度。</view><button wx:if="{{hasMore}}" class="btn light" bindtap="more" disabled="{{loading}}">继续加载</button></block>
 </block></view></view>
