.business-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.case-heading{display:flex;justify-content:space-between;gap:18rpx;align-items:flex-start}.case-heading .section-title{min-width:0;flex:1;overflow-wrap:anywhere}.case-heading .badge{flex-shrink:0}.case-filters{display:flex;gap:12rpx;margin-bottom:24rpx}.case-filters button{flex:1;margin:0;padding:16rpx 8rpx;min-height:76rpx;border:1rpx solid var(--border);border-radius:18rpx;background:var(--surface);color:var(--muted);font-size:26rpx;line-height:1.5}.case-filters button::after{border:0}.case-filters .selected{color:var(--link);background:var(--soft);border-color:var(--link);font-weight:600}.schedule-fields{display:flex;gap:14rpx}.schedule-fields picker{flex:1;min-width:0}.case-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:20rpx}.case-actions .btn{margin:0;min-width:0;font-size:27rpx}.case-event{padding:22rpx 0;border-bottom:1rpx solid var(--border)}.case-event:last-child{border-bottom:0}.large-text .case-actions{grid-template-columns:1fr}.large-text .case-filters button,.large-text .case-actions .btn{font-size:31rpx}

.center-link{background:transparent;color:var(--link);font-size:var(--card-meta,25rpx);line-height:1.5;min-height:88rpx;padding:16rpx;margin:8rpx 0}.center-link::after{border:0}.snapshot-field{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid var(--border)}.snapshot-field .body-copy{overflow-wrap:anywhere}.business-page .field-area{box-sizing:border-box}

.case-primary{margin-top:20rpx}.business-page .case-note{height:176rpx;min-height:176rpx}.large-text .business-page .case-note{height:220rpx;min-height:220rpx}
