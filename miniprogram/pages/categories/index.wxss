.shortcuts-page{padding-bottom:170rpx}.count{font-size:24rpx;color:var(--muted);font-weight:400}.shortcut-option::after{border:0}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:24rpx 0}.shortcut-option{display:flex;align-items:center;justify-content:space-between;background:var(--surface);color:var(--text);font-size:26rpx;line-height:1.5;border:1rpx solid var(--border);border-radius:20rpx;margin:0;padding:24rpx 20rpx;text-align:left}.shortcut-option.chosen{background:var(--soft);color:var(--link)}.shortcut-save{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--surface);border-top:1rpx solid var(--border);z-index:5}.shortcut-option>text:first-child{min-width:0;flex:1;overflow-wrap:anywhere}.shortcut-state{flex-shrink:0;width:24rpx;margin-left:12rpx;text-align:center;font-size:30rpx;line-height:1}.large-text .shortcut-option{font-size:31rpx}.large-text .row{flex-wrap:wrap;gap:12rpx}.large-text .count{font-size:27rpx}.shortcut-icon{width:48rpx;height:48rpx;flex-shrink:0;margin-right:14rpx}.shortcut-name{flex:1;min-width:0;overflow-wrap:anywhere}
.category-action{min-height:44px;margin:0;padding:8px 0 8px 12px;border:0;background:transparent;color:var(--link);font-size:26rpx;line-height:1.5}.category-action::after{border:0}.large-text .category-action{font-size:31rpx}
