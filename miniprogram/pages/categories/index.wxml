<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header id="navigation-header" title="{{editing?'编辑常用分类':'全部分类'}}" back="{{true}}" large-text="{{displayPreferences.largeText}}" bind:back="back"/><view class="container shortcuts-page">
 <view class="row"><view class="section-title">{{editing?'选择首页常用入口':'按行业浏览'}} <text wx:if="{{editing}}" class="count">已选 {{selectedIds.length}} / {{max}}</text></view><button wx:if="{{editing}}" class="category-action" bindtap="reset">恢复默认</button></view>
 <view class="section-caption">{{editing?'点击 ＋ 添加，点击 − 移除；保存后更新首页常用入口。':'选择行业查看公开信息，进入后可继续筛选项目、频道和地区。'}}</view>
 <view class="option-grid"><button class="shortcut-option {{editing&&item.selected?'chosen':''}}" wx:for="{{options}}" wx:key="id" data-id="{{item.id}}" bindtap="open" aria-pressed="{{editing&&item.selected}}" aria-label="{{editing?(item.selected?'移除':'添加'):'浏览'}}{{item.name}}"><image class="shortcut-icon" src="/assets/icons/{{item.icon}}-{{iconPalette}}.png" aria-hidden="true"/><text class="shortcut-name">{{item.name}}</text><text class="shortcut-state" aria-hidden="true">{{editing?(item.selected?'−':'＋'):'›'}}</text></button></view>
 <view wx:if="{{editing}}" class="shortcut-save"><button class="btn" bindtap="save">保存常用分类</button></view>
</view></view>
