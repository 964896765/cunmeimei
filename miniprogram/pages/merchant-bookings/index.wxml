<view class="theme-root {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="商家预约" continuous="{{true}}" large-text="{{displayPreferences.largeText}}" back="{{true}}" native-back="{{true}}"/>
<view class="container"><view class="title">预约处理</view><view class="subtitle">待确认 → 已确认 → 已完成，不能跳过前置状态。</view>
 <feedback-state wx:if="{{loading}}" kind="loading" description="正在读取商家预约…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/>
 <feedback-state wx:if="{{error}}" kind="error" description="{{error}}保留上次记录，读取成功后可继续处理。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新读取预约" bind:action="load" action-disabled="{{loading||busyId}}"/>
 <feedback-state wx:if="{{actionError}}" kind="error" description="{{actionError}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="核对预约状态" bind:action="load" action-disabled="{{loading||busyId}}"/>
 <view wx:if="{{actionNotice}}" class="notice" role="status">{{actionNotice}}</view>
 <view wx:for="{{items}}" wx:key="id" class="section card"><view class="row"><view class="list-title">{{item.serviceTitle}}</view><view class="status">{{item.statusText}}</view></view><view class="list-desc">期望服务时间：{{item.requestedLabel}}</view><view wx:if="{{item.cancellationText}}" class="notice booking-cancellation-reason">{{item.cancellationText}}</view><view class="list-desc">客户备注：{{item.remark||'无'}}</view>
  <view wx:if="{{item.canConfirm}}" class="row booking-actions"><button class="btn light" disabled="{{!canAct||loading||busyId||actionError}}" data-id="{{item.id}}" data-action="decline" bindtap="action">拒绝</button><button class="btn" loading="{{busyId===item.id}}" disabled="{{!canAct||loading||busyId||actionError}}" data-id="{{item.id}}" data-action="confirm" bindtap="action">确认预约</button></view>
  <button wx:if="{{item.businessCaseId||item.businessEligible}}" class="btn light" data-id="{{item.id}}" bindtap="openBusiness">双方业务进度</button><button wx:if="{{item.canComplete}}" class="btn" disabled="{{!canAct||loading||busyId||actionError}}" data-id="{{item.id}}" data-action="complete" bindtap="action">标记服务已完成</button>
 </view><feedback-state wx:if="{{!items.length&&!loading&&!error}}" kind="empty" description="暂无预约" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/><view class="notice">请按实际服务进度处理预约。已结束记录可用于核对原申请与取消原因。</view></view>

</view>
