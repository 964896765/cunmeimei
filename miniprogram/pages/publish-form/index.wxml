<view class="theme-root publish-form {{themeClass}}" style="{{themeStyle}}">
 <page-header id="navigation-header" title="{{preview?'预览信息':'发布'+projectName}}" back="{{true}}" back-label="{{preview?'返回修改':fromDraft?'返回草稿箱':'返回分类选择'}}" large-text="{{displayPreferences.largeText}}" action-text="取消" action-disabled="{{submitting||uploading||saving}}" bind:action="cancelPublish" bind:back="goBack"/>
 <view class="form-content {{preview?'preview-content':''}}">
  <feedback-state wx:if="{{loading}}" kind="loading" description="正在准备表单…" compact="{{true}}" large-text="{{displayPreferences.largeText}}"/>
  <view wx:if="{{error}}" class="form-error" role="alert">{{error}}</view>
  <button wx:if="{{loadFailed}}" class="secondary" bindtap="initialize">重新加载</button>
  <block wx:if="{{showForm&&!loading}}">
   <view wx:if="{{preview}}" class="publication-preview">
    <view class="preview-notice">仅预览 · 当前内容尚未发布</view>
    <swiper duration="{{displayPreferences.reduceMotion?0:250}}" wx:if="{{photoCount>0}}" class="preview-gallery" indicator-dots="{{photoCount>1}}"><swiper-item wx:for="{{photos}}" wx:key="id"><image class="preview-image" src="{{item.path}}" mode="aspectFit" data-path="{{item.path}}" bindtap="previewPhoto" aria-label="查看信息照片"/></swiper-item></swiper>
    <view class="preview-summary"><view wx:if="{{kind!=='community'}}" class="preview-price">{{previewPrice}}</view><view class="preview-title">{{title}}</view><view class="preview-path">{{breadcrumb}}</view></view>
    <view wx:if="{{previewFieldCount>0}}" class="preview-section"><view class="preview-heading">{{kind==='used'?'商品信息':kind==='housing'?'房源信息':'补充信息'}}</view><view wx:for="{{previewFields}}" wx:key="key" class="preview-attribute"><text class="attribute-label">{{item.label}}</text><text class="attribute-value">{{item.value}}</text></view></view>
    <view class="preview-section"><view class="preview-heading">详细描述</view><view class="preview-description">{{detail}}</view></view>
    <view class="preview-section"><view class="preview-heading">{{kind==='used'?'交易地区':kind==='housing'?'房源地区':'信息所属地区'}}</view><view class="preview-location"><view class="location-line-icon" aria-hidden="true"></view>{{previewLocation}}</view><view class="form-hint">仅展示公开区域，不公开个人详细住址。</view></view>
    <view wx:if="{{publisherName}}" class="publisher-row"><view class="person-line-icon" aria-hidden="true"></view><text>{{publisherName}}</text></view>
    <view class="form-hint">电话{{contactSettings.publicPhone?'已单独授权公开':'不公开'}} · {{contactSettings.allowMessages?'可发起私信申请':'不接收新的陌生人申请'}}</view>
   </view>
   <view wx:else class="form-fields">
    <view class="context-row"><view class="category-path">{{breadcrumb}}</view></view>
    <view class="field-group photos-group"><upload-progress busy="{{uploading}}" count="{{photoCount}}" limit="{{6}}"/><view class="label-row"><text class="form-label">{{kind==='used'?'商品照片 *':'真实照片'}}</text><text class="form-hint">最多6张</text></view>
     <view class="photo-grid"><view class="photo-item" wx:for="{{photos}}" wx:key="id"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewPhoto"/><button wx:else class="photo-retry" bindtap="retryPhotos">重试读取</button><button class="photo-remove" data-index="{{index}}" bindtap="removePhoto" aria-label="移除第{{index+1}}张照片" disabled="{{submitting||uploading||saving}}">×</button></view><button wx:if="{{canAddPhoto}}" class="photo-add" bindtap="choosePhotos" disabled="{{uploading||submitting||saving}}"><view class="camera-line-icon" aria-hidden="true"></view><text>{{uploading?'上传中…':'添加照片'}}</text></button></view>
    </view>
    <view class="field-group content-group"><text class="form-label">标题 *</text><input class="quiet-input {{focusedField==='title'?'is-focused':''}}" value="{{title}}" maxlength="100" placeholder="{{attributes.categoryId==='C04G01S01'?'例如：iPhone 15 Pro 256G':'用一句话说明这条信息'}}" data-field="title" bindinput="setField" bindfocus="focusField" bindblur="blurField" disabled="{{submitting||saving}}" aria-label="信息标题，必填"/>
     <block wx:if="{{kind!=='community'}}"><text class="form-label spaced">{{kind==='housing'?'月租 / 预算':kind==='service'?'服务预算':'价格'}} *</text><view class="price-row"><view class="amount-box {{focusedField==='amount'?'is-focused':''}}"><text>¥</text><input type="digit" value="{{attributes.priceMode==='negotiable'?'':amount}}" maxlength="12" placeholder="{{attributes.priceMode==='negotiable'?'已选择面议':'输入金额，如2800'}}" data-field="amount" bindinput="changeAmount" bindfocus="focusField" bindblur="blurField" disabled="{{attributes.priceMode==='negotiable'||submitting||saving}}" aria-label="金额，元"/></view><button class="negotiable {{attributes.priceMode==='negotiable'?'selected':''}}" bindtap="toggleNegotiable" aria-pressed="{{attributes.priceMode==='negotiable'}}" disabled="{{submitting||saving}}">面议</button></view></block>
     <publication-fields id="publication-fields" kind="{{kind}}" attributes="{{attributes}}" appearance="quiet" disabled="{{submitting||saving}}" bind:change="templateFieldChange"/>
     <text class="form-label spaced">详细描述 *</text><textarea class="quiet-input description {{focusedField==='detail'?'is-focused':''}}" value="{{detail}}" maxlength="5000" placeholder="{{kind==='used'?'描述使用情况、配件及瑕疵等':kind==='housing'?'补充房屋情况、租住要求等':'说明具体情况与需求，请勿填写敏感个人信息'}}" data-field="detail" bindinput="setField" bindfocus="focusField" bindblur="blurField" disabled="{{submitting||saving}}" cursor-spacing="100" auto-height="{{true}}" aria-label="详细描述，必填"/>
    </view>
    <view class="field-group location-group"><text class="form-label">{{kind==='used'?'交易地区':kind==='housing'?'房源地区':kind==='service'?'需求地区':'信息所属地区'}} *</text><view class="location-row"><picker class="location-picker" range="{{publishCities}}" range-key="name" bindchange="choosePublishCity" disabled="{{submitting||saving}}"><view class="quiet-input location-control">{{publishCityName||'选择城市'}}<text class="chevron">⌄</text></view></picker><picker class="location-picker" range="{{administrativeDistricts}}" range-key="name" bindchange="chooseAdministrativeDistrict" disabled="{{!publishCityName||submitting||saving}}"><view class="quiet-input location-control">{{publishDistrictName||'区县 / 镇街'}}<text class="chevron">⌄</text></view></picker></view><view class="form-hint">只展示公开交易区域，不展示个人详细住址。</view>
     <view wx:if="{{scopeRequired}}" class="legacy-scope"><text class="form-label small-label">平台发布范围 *</text><picker range="{{districts}}" bindchange="changeDistrict" disabled="{{submitting||saving}}"><view class="quiet-input location-control">{{district||'选择已开放范围'}}<text class="chevron">⌄</text></view></picker><view class="form-hint">此地区尚需确认平台开放范围。</view></view>
    </view>
    <view class="field-group contact-settings"><privacy-mask label="联系方式由你逐条授权" description="手机号默认隐藏，可随时撤回本条授权。"/><text class="form-label">联系设置</text><view class="contact-setting-row"><view><text>公开联系电话</text><view class="form-hint">{{trust.phoneVerified?trust.maskedPhone+' · 仅本条授权':'需先验证手机号，默认不公开'}}</view></view><button class="contact-toggle" bindtap="togglePublicPhone" aria-pressed="{{contactSettings.publicPhone}}">{{contactSettings.publicPhone?'已开启':'未开启'}}</button></view><view class="contact-setting-row"><text>陌生人可以私信我</text><switch color="{{themeColor}}" checked="{{contactSettings.allowMessages}}" bindchange="changeAllowMessages"/></view><button class="verification-link" bindtap="openVerification">查看手机号与认证状态</button></view>
    <view class="form-hint safety-note">请确认发布内容真实、准确，不包含敏感个人信息。</view>
   </view>
   <view wx:if="{{preview}}"><publication-confirmation id="publication-confirmation" revision="{{consentRevision}}" disabled="{{submitting||saving||uploading}}" color="{{themeColor}}" large-text="{{displayPreferences.largeText}}" bind:change="publicationConsentChanged"><view class="form-actions preview-actions"><button class="primary" loading="{{submitting}}" disabled="{{submitting||!publicationConsent}}" bindtap="confirmSubmit">确认并提交审核</button><button class="secondary" disabled="{{submitting}}" bindtap="editPost">返回修改</button></view></publication-confirmation></view>
   <view wx:else class="form-actions"><button class="primary" disabled="{{submitting||uploading||saving}}" bindtap="previewPost">下一步 · 预览</button></view>
  </block>
 </view>
 <confirm-dialog open="{{showExitDialog}}" title="保存当前内容？" description="未保存的修改将在退出后丢失" error="{{draftError}}" confirm-text="保存并返回" secondary-text="不保存并返回" cancel-text="继续填写" busy="{{saving}}" bind:confirm="saveAndExit" bind:secondary="discardAndExit" bind:cancel="continueEditing"/>
</view>
