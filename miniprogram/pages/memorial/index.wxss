.memorial-page {
  min-height: 100vh;
  background: var(--background);
  color: var(--ink);
}
.memorial-content {
  padding: 24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}
.memorial-card {
  padding: 28rpx;
  margin-bottom: 26rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}
.memorial-intro {
  position: relative;
  min-height: 420rpx;
  padding: 48rpx 46rpx 96rpx;
  overflow: hidden;
  background: var(--soft);
}
.memorial-portal {
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
}
.memorial-intro-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.theme-dark .memorial-intro-art {
  opacity: .34;
}
.memorial-intro-copy {
  position: relative;
  max-width: 62%;
}
.memorial-intro .memorial-heading {
  margin: 0;
  font-family: 'Songti SC', 'Noto Serif CJK SC', SimSun, serif;
  font-size: 66rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
  line-height: 1.21;
}
.memorial-intro .memorial-heading text {
  display: block;
}
.memorial-intro .memorial-rule {
  width: 54rpx;
  margin: 23rpx 0 16rpx;
  background: var(--muted);
}
.memorial-intro-description {
  color: var(--text);
  font-size: 24rpx;
  line-height: 1.65;
}
.memorial-portal-actions {
  position: relative;
  margin: -48rpx 28rpx 0;
}
.memorial-portal-actions .memorial-entry {
  min-height: 146rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--elevation);
}
.memorial-portal-actions .memorial-title {
  line-height: 1.4;
}
.memorial-portal-actions .memorial-muted {
  line-height: 1.45;
}
.memorial-icon-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--soft);
  color: var(--link);
}
.memorial-portal-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 16rpx;
}
.memorial-portal-actions .memorial-tile {
  min-width: 0;
  min-height: 210rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 12rpx 20rpx;
  text-align: center;
  background: linear-gradient(165deg,var(--surface) 55%,var(--soft));
}
.memorial-tile .memorial-title { font-size: 31rpx; }
.memorial-tile .memorial-muted { font-size: 23rpx; margin-top: 0; }
.memorial-search-icon,.memorial-picture-icon,.memorial-book {
  display: block;
  position: relative;
  flex-shrink: 0;
  color: var(--link);
  margin-bottom: 8rpx;
}
.memorial-search-icon { width: 38rpx; height: 38rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.memorial-search-icon::after { content: ""; position: absolute; width: 21rpx; height: 3rpx; right: -15rpx; bottom: -5rpx; border-radius: 4rpx; background: currentColor; transform: rotate(48deg); }
.memorial-picture-icon { width: 48rpx; height: 38rpx; overflow: hidden; border: 3rpx solid currentColor; border-radius: 7rpx; }
.memorial-picture-icon::before { content: ""; position: absolute; width: 30rpx; height: 28rpx; bottom: -15rpx; left: 0; border: 3rpx solid currentColor; transform: rotate(45deg); }
.memorial-picture-icon::after { content: ""; position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; top: 6rpx; right: 7rpx; background: currentColor; }
.memorial-portal-actions .memorial-create-entry {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 18rpx;
  margin: 8rpx 0 0;
  background: linear-gradient(146deg,#686868,#404040);
  border-color: #6e6e6e;
  color: #fff;
  text-align: center;
}
.memorial-create-title { display: flex; align-items: center; justify-content: center; gap: 14rpx; font-size: 33rpx; font-weight: 650; }
.memorial-plus { display: flex; align-items: center; justify-content: center; width: 41rpx; height: 41rpx; border: 2rpx solid currentColor; border-radius: 50%; font-size: 31rpx; font-weight: 400; }
.memorial-create-subtitle { color: #f0f0f0; font-size: 23rpx; }
.memorial-story { margin-top: 20rpx; }
.large-text .memorial-intro .memorial-heading { font-size: 70rpx; }
.large-text .memorial-intro-description,.large-text .memorial-tile .memorial-muted,.large-text .memorial-create-subtitle { font-size: 28rpx; }
.large-text .memorial-tile .memorial-title,.large-text .memorial-create-title { font-size: 36rpx; }
@media (max-width: 350px) {
  .memorial-portal-actions { margin-right: 20rpx; margin-left: 20rpx; }
  .memorial-manage-entry { gap: 15rpx; }
}
.memorial-heading {
  margin: 24rpx 0 12rpx;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.5;
}
.memorial-rule {
  height: 1rpx;
  margin: 30rpx auto;
  width: 84%;
  background: var(--border);
}
.memorial-title {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
}
.memorial-muted {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.memorial-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 132rpx;
  padding: 26rpx;
  margin: 0 0 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  line-height: 1.5;
}
.memorial-entry-copy {
  flex: 1;
  min-width: 0;
}
.memorial-entry .memorial-muted {
  margin-top: 4rpx;
}
.memorial-entry::after,
.memorial-button::after,
.memorial-link::after,
.blessing-choice::after {
  border: 0;
}
.memorial-book {
  width: 44rpx;
  height: 38rpx;
  margin: 0;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}
.memorial-book::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 45%;
  border-left: 2rpx solid currentColor;
}
.memorial-arrow {
  color: var(--muted);
  font-size: 36rpx;
}
.memorial-status {
  margin: 0 0 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.8;
}
.memorial-footer {
  margin: 36rpx 0 10rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  letter-spacing: 3rpx;
  line-height: 1.8;
}
.memorial-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}
.memorial-input {
  min-height: 88rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-textarea {
  width: 100%;
  min-height: 210rpx;
  height: 240rpx;
  box-sizing: border-box;
  margin: 12rpx 0 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-date-row {
  display: flex;
  gap: 18rpx;
}
.memorial-date-row > view {
  flex: 1;
  min-width: 0;
}
.memorial-button {
  margin: 24rpx 0 0;
  padding: 22rpx;
  min-height: 92rpx;
  border: 1rpx solid var(--action);
  border-radius: 20rpx;
  background: var(--action);
  color: var(--on-action);
  font-size: 29rpx;
  line-height: 1.6;
}
.memorial-button.secondary {
  color: var(--link);
  background: var(--soft);
  border-color: var(--border);
}
.memorial-button[disabled],
.memorial-entry[disabled] {
  opacity: 0.55;
}
.memorial-link {
  margin: 10rpx 0 0;
  padding: 18rpx 6rpx;
  min-height: 76rpx;
  border: 0;
  background: transparent;
  color: var(--link);
  font-size: 27rpx;
  line-height: 1.6;
}
.portrait-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}
.memorial-portrait {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border: 6rpx solid var(--surface);
  border-radius: 50%;
  object-fit: cover;
  filter: grayscale(1);
}
.memorial-person {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--soft);
}
.memorial-person::before {
  content: "";
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  top: 42rpx;
  left: 70rpx;
  border: 4rpx solid var(--muted);
  border-radius: 50%;
}
.memorial-person::after {
  content: "";
  position: absolute;
  width: 62rpx;
  height: 40rpx;
  top: 94rpx;
  left: 55rpx;
  border: 4rpx solid var(--muted);
  border-bottom: 0;
  border-radius: 42rpx 42rpx 0 0;
}
.memorial-public-choice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  color: var(--text);
  font-size: 28rpx;
}
.memorial-public-choice > view {
  flex: 1;
}
.memorial-consent {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 26rpx;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.8;
}
.memorial-consent checkbox {
  flex-shrink: 0;
  transform: scale(0.8);
  transform-origin: left top;
  width: 46rpx;
  margin-top: 8rpx;
}
.memorial-management {
  display: flex;
  justify-content: space-around;
}
.remembrance {
  text-align: center;
  padding-top: 42rpx;
}
.remembrance .memorial-portrait {
  margin: 0 auto;
}
.memorial-name {
  margin: 16rpx 0 8rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 500;
}
.memorial-biography {
  display: block;
  white-space: pre-wrap;
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.95;
  text-align: left;
  overflow-wrap: anywhere;
}
.memorial-motto {
  padding: 6rpx 0 30rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.8;
  letter-spacing: 2rpx;
}
.tribute-actions {
  display: flex;
  gap: 22rpx;
}
.tribute-actions .memorial-entry {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  gap: 14rpx;
  font-size: 30rpx;
}
.tribute-symbol {
  font-size: 56rpx;
  line-height: 1;
  color: var(--link);
}
.memorial-candle {
  position: relative;
  width: 26rpx;
  height: 36rpx;
  margin-top: 18rpx;
  border: 3rpx solid var(--link);
  border-radius: 5rpx;
}
.memorial-candle::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 20rpx;
  left: 3rpx;
  top: -28rpx;
  border: 3rpx solid var(--link);
  border-radius: 70% 20% 70% 70%;
  transform: rotate(-20deg);
}
.blessing-choice {
  margin: 14rpx 0 0;
  min-height: 84rpx;
  padding: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--text);
  text-align: left;
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-request {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text);
}
.large-text .memorial-heading {
  font-size: 54rpx;
}
.large-text .memorial-title {
  font-size: 40rpx;
}
.large-text .memorial-biography,
.large-text .memorial-input,
.large-text .memorial-textarea,
.large-text .memorial-button,
.large-text .memorial-consent {
  font-size: 34rpx;
}
.large-text .memorial-muted,
.large-text .memorial-link,
.large-text .memorial-label,
.large-text .blessing-choice {
  font-size: 30rpx;
}
@media (max-width: 350px) {
  .memorial-date-row {
    flex-direction: column;
    gap: 0;
  }
  .tribute-actions {
    gap: 14rpx;
  }
}
