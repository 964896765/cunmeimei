.memorial-page {
  min-height: 100vh;
  background: var(--background);
  color: var(--ink);
}
.memorial-content {
  padding: 24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}
.memorial-card {
  padding: 28rpx;
  margin-bottom: 26rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}
.memorial-intro {
  padding: 26rpx 24rpx 46rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-flower {
  font-size: 80rpx;
  color: var(--link);
  line-height: 1.4;
}
.memorial-heading {
  margin: 24rpx 0 12rpx;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.5;
}
.memorial-subtitle {
  color: var(--text);
  font-size: 30rpx;
  letter-spacing: 4rpx;
}
.memorial-rule {
  height: 1rpx;
  margin: 30rpx auto;
  width: 84%;
  background: var(--border);
}
.memorial-title {
  display: block;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
}
.memorial-muted {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.memorial-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 132rpx;
  padding: 26rpx;
  margin: 0 0 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  line-height: 1.5;
}
.memorial-entry > view:nth-child(2) {
  flex: 1;
  min-width: 0;
}
.memorial-entry .memorial-muted {
  margin-top: 4rpx;
}
.memorial-entry::after,
.memorial-button::after,
.memorial-link::after,
.blessing-choice::after {
  border: 0;
}
.memorial-entry-icon {
  flex-shrink: 0;
  width: 42rpx;
  height: 46rpx;
  color: var(--link);
}
.memorial-book {
  position: relative;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}
.memorial-book::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 45%;
  border-left: 2rpx solid currentColor;
}
.memorial-heart {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  line-height: 1;
}
.memorial-arrow {
  color: var(--muted);
  font-size: 36rpx;
}
.memorial-status {
  margin: 0 0 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.8;
}
.memorial-footer {
  margin: 36rpx 0 10rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  letter-spacing: 3rpx;
  line-height: 1.8;
}
.memorial-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}
.memorial-input {
  min-height: 88rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-textarea {
  width: 100%;
  min-height: 210rpx;
  height: 240rpx;
  box-sizing: border-box;
  margin: 12rpx 0 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-date-row {
  display: flex;
  gap: 18rpx;
}
.memorial-date-row > view {
  flex: 1;
  min-width: 0;
}
.memorial-button {
  margin: 24rpx 0 0;
  padding: 22rpx;
  min-height: 92rpx;
  border: 1rpx solid var(--action);
  border-radius: 20rpx;
  background: var(--action);
  color: var(--on-action);
  font-size: 29rpx;
  line-height: 1.6;
}
.memorial-button.secondary {
  color: var(--link);
  background: var(--soft);
  border-color: var(--border);
}
.memorial-button[disabled],
.memorial-entry[disabled] {
  opacity: 0.55;
}
.memorial-link {
  margin: 10rpx 0 0;
  padding: 18rpx 6rpx;
  min-height: 76rpx;
  border: 0;
  background: transparent;
  color: var(--link);
  font-size: 27rpx;
  line-height: 1.6;
}
.portrait-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 24rpx;
}
.memorial-portrait {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border: 6rpx solid var(--surface);
  border-radius: 50%;
  object-fit: cover;
  filter: grayscale(1);
}
.memorial-person {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--soft);
}
.memorial-person::before {
  content: "";
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  top: 42rpx;
  left: 70rpx;
  border: 4rpx solid var(--muted);
  border-radius: 50%;
}
.memorial-person::after {
  content: "";
  position: absolute;
  width: 62rpx;
  height: 40rpx;
  top: 94rpx;
  left: 55rpx;
  border: 4rpx solid var(--muted);
  border-bottom: 0;
  border-radius: 42rpx 42rpx 0 0;
}
.memorial-public-choice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  color: var(--text);
  font-size: 28rpx;
}
.memorial-public-choice > view {
  flex: 1;
}
.memorial-consent {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 26rpx;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.8;
}
.memorial-consent checkbox {
  flex-shrink: 0;
  transform: scale(0.8);
  transform-origin: left top;
  width: 46rpx;
  margin-top: 8rpx;
}
.memorial-management {
  display: flex;
  justify-content: space-around;
}
.remembrance {
  text-align: center;
  padding-top: 42rpx;
}
.remembrance .memorial-portrait {
  margin: 0 auto;
}
.memorial-name {
  margin: 16rpx 0 8rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 500;
}
.memorial-biography {
  display: block;
  white-space: pre-wrap;
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.95;
  text-align: left;
  overflow-wrap: anywhere;
}
.memorial-motto {
  padding: 6rpx 0 30rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.8;
  letter-spacing: 2rpx;
}
.tribute-actions {
  display: flex;
  gap: 22rpx;
}
.tribute-actions .memorial-entry {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  gap: 14rpx;
  font-size: 30rpx;
}
.tribute-symbol {
  font-size: 56rpx;
  line-height: 1;
  color: var(--link);
}
.memorial-candle {
  position: relative;
  width: 26rpx;
  height: 36rpx;
  margin-top: 18rpx;
  border: 3rpx solid var(--link);
  border-radius: 5rpx;
}
.memorial-candle::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 20rpx;
  left: 3rpx;
  top: -28rpx;
  border: 3rpx solid var(--link);
  border-radius: 70% 20% 70% 70%;
  transform: rotate(-20deg);
}
.blessing-choice {
  margin: 14rpx 0 0;
  min-height: 84rpx;
  padding: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--background);
  color: var(--text);
  text-align: left;
  font-size: 28rpx;
  line-height: 1.8;
}
.memorial-request {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border);
  font-size: 28rpx;
  color: var(--text);
}
.large-text .memorial-heading {
  font-size: 54rpx;
}
.large-text .memorial-title {
  font-size: 40rpx;
}
.large-text .memorial-biography,
.large-text .memorial-input,
.large-text .memorial-textarea,
.large-text .memorial-button,
.large-text .memorial-consent {
  font-size: 34rpx;
}
.large-text .memorial-muted,
.large-text .memorial-link,
.large-text .memorial-label,
.large-text .blessing-choice {
  font-size: 30rpx;
}
@media (max-width: 350px) {
  .memorial-date-row {
    flex-direction: column;
    gap: 0;
  }
  .tribute-actions {
    gap: 14rpx;
  }
}
