.drafts-page{min-height:100vh;background:var(--background);color:var(--ink)}
.drafts-content{padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.draft-row{padding:28rpx;margin-bottom:16rpx;border-radius:20rpx;background:var(--surface)}
.draft-main{display:flex;align-items:center;gap:24rpx;min-height:140rpx}.draft-cover{width:112rpx;height:112rpx;flex-shrink:0;background:var(--soft);border-radius:16rpx;display:flex;align-items:center;justify-content:center;overflow:hidden}.draft-cover image{width:100%;height:100%}
.draft-edit-icon{position:relative;width:42rpx;height:42rpx;color:var(--muted)}
.draft-edit-icon::before{content:"";position:absolute;left:2rpx;top:7rpx;width:29rpx;height:30rpx;border:3rpx solid currentColor;border-top-color:transparent;border-right-color:transparent;border-radius:8rpx}
.draft-edit-pen{position:absolute;left:19rpx;top:0;width:8rpx;height:30rpx;border:3rpx solid currentColor;border-radius:4rpx;transform:rotate(40deg)}
.draft-edit-pen::after{content:"";position:absolute;left:0;bottom:-7rpx;width:0;height:0;border-left:4rpx solid transparent;border-right:4rpx solid transparent;border-top:6rpx solid currentColor}
.draft-copy{flex:1;min-width:0}.draft-title{font-size:30rpx;font-weight:400;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.draft-category{font-size:25rpx;color:var(--muted);line-height:1.5;margin-top:5rpx}.draft-time,.draft-source{font-size:23rpx;color:var(--muted);line-height:1.5}.draft-source{font-size:21rpx;margin-top:4rpx}
.draft-chevron{width:13rpx;height:13rpx;border-top:3rpx solid var(--muted);border-right:3rpx solid var(--muted);transform:rotate(45deg);margin:0 7rpx;flex-shrink:0}
.draft-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:28rpx;padding-top:16rpx;border-top:1rpx solid var(--border)}
.draft-hint{font-size:25rpx;color:var(--muted);line-height:1.5}
.draft-delete{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;flex-shrink:0;min-width:64px;min-height:44px;padding:0;margin:0;background:transparent;border:0;color:var(--muted);font-size:28rpx;font-weight:400;line-height:1.5}
.trash-icon{position:relative;box-sizing:border-box;display:flex;justify-content:center;gap:4rpx;width:20rpx;height:22rpx;margin:6rpx 3rpx 0;border:2rpx solid currentColor;border-radius:0 0 4rpx 4rpx}
.trash-icon::before{content:"";position:absolute;left:-5rpx;right:-5rpx;top:-6rpx;border-top:2rpx solid currentColor}.trash-icon::after{content:"";position:absolute;left:4rpx;right:4rpx;top:-11rpx;height:5rpx;border:2rpx solid currentColor;border-bottom:0;border-radius:3rpx 3rpx 0 0}.trash-icon view{height:12rpx;margin-top:3rpx;border-left:2rpx solid currentColor}
.draft-delete::after,.retry::after,.empty-return::after{border:0}
.draft-state,.draft-empty{text-align:center;color:var(--muted);padding:100rpx 20rpx;font-size:27rpx;line-height:1.7}.empty-title{color:var(--ink);font-size:32rpx;font-weight:600;margin-bottom:12rpx}.empty-return{margin-top:28rpx;background:transparent;color:var(--ink);font-size:28rpx;min-height:44px}.draft-feedback{padding:20rpx;margin-bottom:16rpx;font-size:26rpx;line-height:1.6;background:var(--surface);color:var(--danger);border-radius:12rpx}.retry{background:transparent;color:var(--ink);font-size:26rpx;margin:10rpx 0 0;padding:0;min-height:44px}
.large-text .draft-row{padding:24rpx 18rpx}.large-text .draft-main{gap:16rpx}.large-text .draft-hint{font-size:28rpx}.large-text .draft-delete{font-size:32rpx}.large-text .draft-title{font-size:36rpx;white-space:normal}.large-text .draft-category{font-size:30rpx}.large-text .draft-time,.large-text .draft-source{font-size:27rpx}.large-text .draft-cover{width:96rpx;height:116rpx}

/* VM page composition. */
.drafts-content { padding:28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.draft-row { border:1rpx solid var(--border); margin-bottom:28rpx; }
.draft-title { font-size:32rpx; font-weight:600; }
.draft-category,.draft-time { font-size:24rpx; line-height:1.6; }
