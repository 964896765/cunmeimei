.city-page { display:flex; flex-direction:column; height:100vh; min-height:0; overflow:hidden; }
.city-page>page-header { display:block; flex-shrink:0; }
.city-search { flex-shrink:0; padding:24rpx 64rpx 20rpx 32rpx; background:var(--surface); border-bottom:1rpx solid var(--border); }
.city-scroll,.large-text .city-scroll { flex:1; height:0; min-height:0; }
.city-section { padding:28rpx 64rpx 24rpx 32rpx; }
.city-section .section-caption { font-size:26rpx; }
.current-city { margin:20rpx 0 12rpx; color:var(--ink); font-size:38rpx; font-weight:600; }
.city-chips { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; margin-top:24rpx; }
.city-chips>view { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:16rpx 8rpx; border:1rpx solid var(--border); border-radius:14rpx; background:var(--surface); text-align:center; font-size:26rpx; line-height:1.5; }
.all-cities-label { padding:24rpx 32rpx; color:var(--ink); font-size:34rpx; font-weight:600; }
.letter-heading { padding:12rpx 32rpx; background:var(--soft); color:var(--link); font-size:26rpx; }
.city-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:104rpx; margin:0 64rpx 0 32rpx; padding:18rpx 0; border-bottom:1rpx solid var(--border); color:var(--ink); font-size:30rpx; line-height:1.5; }
.district-entry { flex-shrink:0; padding:20rpx 0; font-size:24rpx; }
.alphabet { position:fixed; right:6rpx; top:calc(var(--city-header-height) + 144rpx); bottom:calc(40rpx + env(safe-area-inset-bottom)); width:40rpx; display:flex; flex-direction:column; justify-content:center; z-index:5; }
.alphabet text { font-size:24rpx; line-height:1.5; text-align:center; color:var(--link); }
.city-source { padding:32rpx 64rpx calc(40rpx + env(safe-area-inset-bottom)) 32rpx; color:var(--muted); font-size:24rpx; line-height:1.7; }
.city-source text { display:block; }
.district-heading { display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.district-close { min-height:88rpx; padding:16rpx; margin:0; border:0; background:transparent; color:var(--link); font-size:28rpx; }
.district-close::after { border:0; }
.district-list .city-row { margin:0; }
.large-text .city-row { font-size:34rpx; }
.large-text .city-chips>view { font-size:30rpx; }
