.city-page{height:100vh;overflow:hidden}.city-search{padding:18rpx 54rpx 16rpx 28rpx}.city-scroll{height:calc(100vh - 136rpx)}.city-section{padding:26rpx 66rpx 18rpx 28rpx}.city-chips{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin-top:20rpx}.city-chips>view{padding:18rpx 8rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:18rpx;text-align:center;font-size:25rpx}.current-city{font-size:32rpx;color:var(--link);margin:20rpx 0 8rpx}.all-cities-label{padding:26rpx 28rpx 14rpx;font-size:27rpx;font-weight:600}.letter-heading{padding:10rpx 28rpx;background:var(--soft);font-size:25rpx;color:var(--link)}.city-row{display:flex;justify-content:space-between;align-items:center;min-height:94rpx;margin:0 62rpx 0 28rpx;border-bottom:1rpx solid var(--border);font-size:28rpx;gap:16rpx}.district-entry{font-size:22rpx;flex-shrink:0;padding:20rpx 0}.alphabet{position:fixed;right:8rpx;top:170rpx;bottom:70rpx;width:40rpx;display:flex;flex-direction:column;justify-content:center;z-index:5}.alphabet text{font-size:21rpx;line-height:1.8;text-align:center;color:var(--link)}.city-source{padding:28rpx 60rpx 90rpx 28rpx;font-size:21rpx;line-height:1.6;color:var(--muted)}.city-source text{display:block}.district-overlay{position:fixed;inset:0;background:var(--background);z-index:20;display:flex;align-items:flex-end}.district-sheet{width:100%;max-height:82vh;background:var(--surface);border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--border)}.district-sheet scroll-view{height:65vh}.large-text .city-row{font-size:34rpx}.large-text .city-chips>view{font-size:30rpx}.large-text .city-scroll{height:calc(100vh - 160rpx)}
