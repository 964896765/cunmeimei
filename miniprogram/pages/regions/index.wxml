<view class="theme-root {{themeClass}} city-page" style="{{themeStyle}}">
 <view class="city-search"><view class="search"><view class="search-dot"></view><input class="search-placeholder" value="{{q}}" bindinput="input" placeholder="城市名称、拼音或首字母" maxlength="40" aria-label="搜索城市"/></view></view>
 <scroll-view scroll-y="true" enhanced="true" show-scrollbar="{{false}}" class="city-scroll" scroll-into-view="{{anchor}}">
 <block wx:if="{{!q}}"><view class="city-section"><view class="row"><text class="section-caption">当前选择 / 历史访问</text><text class="link" bindtap="locate">{{locating?'定位中…':'重新定位'}}</text></view><view class="current-city">{{currentLabel}}</view><view class="section-caption">{{gpsLabel}}</view><view wx:if="{{error}}" class="notice">{{error}}</view><view class="city-chips"><view wx:for="{{history}}" wx:key="code" data-code="{{item.code}}" bindtap="chooseCity">{{item.name}}</view></view></view>
 <view class="city-section"><view class="row"><text class="section-caption">附近城市</text><text wx:if="{{nearby.length}}" class="link" bindtap="expandNearby">{{nearbyExpanded?'收起':'展开'}}</text></view><view class="city-chips"><view wx:for="{{nearby}}" wx:key="code" wx:if="{{nearbyExpanded||index<4}}" data-code="{{item.code}}" bindtap="chooseCity">{{item.name}}</view></view><view wx:if="{{!nearby.length}}" class="section-caption">主动定位后显示附近城市；也可以直接手动选择。</view></view>
 <view class="city-section"><text class="section-caption">热门城市</text><view class="city-chips"><view wx:for="{{hot}}" wx:key="code" data-code="{{item.code}}" bindtap="chooseCity">{{item.name}}</view></view></view></block>
 <view class="all-cities-label">{{q?'搜索结果':'全部城市'}}</view><view wx:for="{{groups}}" wx:key="letter" id="letter-{{item.letter}}" class="city-group"><view class="letter-heading">{{item.letter}}</view><view class="city-row" wx:for="{{item.cities}}" wx:key="code" data-code="{{item.code}}" bindtap="chooseCity"><text>{{item.name}}</text><text wx:if="{{item.districts.length}}" class="link district-entry" data-code="{{item.code}}" catchtap="expandDistrict">区县 / 镇街 ›</text></view></view>
 <view wx:if="{{!groups.length}}" class="state-panel">没有找到匹配的城市</view><view class="city-source">中国大陆行政区划快照 · {{sourceVersion}}<text>港澳台目录及最新区划变更待补充核验。</text></view>
 </scroll-view><view class="alphabet"><text wx:for="{{letters}}" wx:key="*this" data-letter="{{item}}" bindtap="jump">{{item}}</text></view>
 <view wx:if="{{districtCity}}" class="district-overlay"><view class="district-sheet"><view class="row"><text class="section-title">{{districtCity.name}}</text><text class="link" bindtap="closeDistricts">关闭</text></view><scroll-view scroll-y="true"><view class="city-row" data-code="{{districtCity.code}}" bindtap="chooseCity">全市</view><view class="city-row" wx:for="{{districts}}" wx:key="code" data-code="{{item.code}}" bindtap="chooseDistrict">{{item.name}}</view></scroll-view></view></view>
</view>
