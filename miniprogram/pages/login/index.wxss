.login-main { position:relative; z-index:1; max-width:710rpx; margin:0 auto; padding:0 24rpx; }
.login-landscape { position:relative; height:300rpx; margin-top:20rpx; overflow:hidden; }
.login-landscape>image { width:100%; height:100%; display:block; }
.landscape-veil { position:absolute; top:0; left:0; right:0; height:70%; background:linear-gradient(var(--background),rgba(251,248,250,0)); }
.landscape-wave { position:absolute; bottom:-100rpx; right:-20%; width:140%; height:160rpx; border-radius:50%; background:var(--soft); transform:rotate(-6deg); }
.login-photo-credit { position:relative; padding:12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); color:var(--muted); background:var(--soft); text-align:center; font-size:20rpx; }
