.booking-item{display:flex;gap:22rpx;align-items:center;margin-top:48rpx}.picker{display:flex;align-items:center;justify-content:space-between;line-height:88rpx}
.booking-recovery-error,.booking-pending-check,.booking-success,.booking-rejected{margin:24rpx 28rpx}

/* VM page composition. */
.service-summary { margin:28rpx 0 36rpx; padding:28rpx; gap:24rpx; }
.service-summary .list-title { font-size:34rpx; line-height:1.5; }
.service-summary .list-price { margin-top:12rpx; font-size:32rpx; font-weight:600; }
.service-summary .list-art { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; flex-shrink:0; border-radius:18rpx; background:var(--soft); }
.container .field-label { margin-top:28rpx; }
.picker { min-height:96rpx; line-height:1.6; }
