<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header title="{{reportId?'纠错处理答复':'同城资讯'}}" back="{{true}}" large-text="{{displayPreferences.largeText}}" bind:back="goBack"/><view class="container information-page">
 <view wx:if="{{error}}" class="state-panel" role="alert">{{error}}<button class="btn light" bindtap="retry">重新读取</button></view><view wx:if="{{loading}}" class="notice" role="status">正在读取…</view>
 <view wx:if="{{item}}" class="article"><view class="article-title">{{item.title}}</view><view class="article-source">来源：{{item.sourceName}}</view><view class="article-summary">{{item.summary}}</view><view class="article-body" selectable="true">{{item.body}}</view><button class="btn light" bindtap="copySource">复制原始来源链接</button><view class="notice">资讯仅作信息参考，请以原始来源的最新说明为准。</view><button class="center-link" bindtap="report" disabled="{{busy}}" loading="{{busy}}">纠错或举报</button><view wx:if="{{feedback}}" class="state-panel" role="status">{{feedback}}</view></view>
 <view wx:if="{{report}}" class="section-card"><view class="section-title">{{report.status==='pending'?'待处理':report.status==='resolved'?'已处理':'已有答复'}}</view><view class="body-copy">{{report.response||'运营人员正在核查。'}}</view><view class="notice">本人提交：{{report.reason}}</view></view>
 <block wx:if="{{!id&&!reportId}}"><view class="news-entry" wx:for="{{items}}" wx:key="id" bindtap="open" data-id="{{item.id}}" role="button"><view class="news-title">{{item.title}}</view><view class="news-summary">{{item.summary}}</view><view class="news-source">{{item.sourceName}}</view></view><view wx:if="{{!loading&&!error&&!items.length}}" class="state-panel">当前地区暂无经过审核的资讯。</view><button wx:if="{{hasMore}}" class="btn light" bindtap="more" disabled="{{loading}}">继续加载</button></block>
</view></view>
