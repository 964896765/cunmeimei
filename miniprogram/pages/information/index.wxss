.article-title{font-size:38rpx;font-weight:600;color:var(--ink);line-height:1.5}.article-source{font-size:var(--card-meta);color:var(--muted);margin:18rpx 0}.article-summary{font-size:var(--card-title);line-height:1.8;color:var(--text);padding:20rpx 0;border-bottom:1rpx solid var(--border)}.article-body{font-size:var(--card-title);line-height:1.95;white-space:pre-wrap;overflow-wrap:anywhere;padding:28rpx 0 44rpx}.large-text .article-title{font-size:44rpx}

/* VM page composition. */
.article-title { font-size:40rpx; font-weight:650; line-height:1.4; }
.article-summary { padding:28rpx 0; border-bottom:1rpx solid var(--border); font-size:30rpx; line-height:1.8; }
.article-body { margin:32rpx 0; font-size:30rpx; line-height:1.9; }
