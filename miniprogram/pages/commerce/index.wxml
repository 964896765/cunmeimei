<view class="theme-root {{themeClass}}" style="{{themeStyle}}"><page-header title="权益与推广" back="{{true}}" bind:back="back" large-text="{{displayPreferences.largeText}}"/><view class="container">
 <view wx:if="{{privateLocked}}" id="account-access-gate" class="state-panel"><view class="section-title">登录后查看本人记录</view><view class="notice">登录已结束或尚未完成，原账号记录暂不展示。</view><view wx:if="{{error}}" class="notice" role="alert">{{error}}</view><button id="account-access-login" class="btn" bindtap="signin">微信登录并继续</button><button class="btn light" bindtap="back">返回浏览</button></view>
 <block wx:else>
 <view class="row"><button wx:for="{{['offers','orders','promotion']}}" wx:key="*this" id="commerce-tab-{{item}}" class="workspace-tab {{tab===item?'selected':''}}" data-tab="{{item}}" bindtap="tab" aria-pressed="{{tab===item}}">{{item==='offers'?'积分兑换':item==='orders'?'兑换记录':'自助推广'}}</button></view>
 <view wx:if="{{account}}" class="notice">可用 {{account.available}} 分 · 冻结 {{account.held}} 分。积分不能充值、提现或转让。</view>
 <view wx:if="{{error}}" class="state-panel" role="alert">{{error}}<button class="btn light" bindtap="load" disabled="{{busy||loading}}">刷新核对记录</button></view>
 <view wx:if="{{pending}}" class="section-card"><view class="body-copy">有一项提交结果尚待核对。</view><button class="btn" disabled="{{busy}}" bindtap="resume">核对上次提交</button><button class="center-link" disabled="{{busy}}" bindtap="clearPending">已核对记录，清除本机请求</button></view>
 <view wx:if="{{loading}}" class="notice">正在读取…</view>
 <block wx:if="{{tab==='offers'}}"><view class="section-card" wx:for="{{offers}}" wx:key="id"><view class="section-title">{{item.title}}</view><view class="body-copy">{{item.description}}</view><view class="notice">{{item.terms}}</view><view class="body-copy">{{item.points_cost}} 分 · 剩余 {{item.stock}}</view><button class="btn" data-id="{{item.id}}" disabled="{{busy||loading||!item.stock||pending}}" id="benefit-redeem-{{item.id}}" bindtap="redeem">确认兑换</button></view><view wx:if="{{!loading&&!offers.length}}" class="state-panel">暂无可兑换权益。运营发布真实权益和库存后在此展示。</view></block>
 <block wx:elif="{{tab==='orders'}}"><view class="section-card {{focusId===item.id?'focused-record':''}}" wx:for="{{orders}}" wx:key="id"><view class="row"><text class="section-title">{{item.snapshot.title}}</text><text class="badge">{{item.statusText}}</text></view><view class="notice">{{item.snapshot.pointsCost}} 分 · 核销期限 {{item.deadline}}</view><view class="body-copy">{{item.snapshot.terms}}</view><view wx:if="{{item.response}}" class="notice">处理说明：{{item.response}}</view><view wx:if="{{item.fulfilment}}" class="fulfilment" selectable="true">本人核销凭据：{{item.fulfilment}}</view><button wx:if="{{item.status==='pending'}}" class="btn light" data-id="{{item.id}}" disabled="{{busy||pending}}" id="benefit-cancel-{{item.id}}" bindtap="cancelOrder">取消并退还积分</button></view><view wx:if="{{!loading&&!orders.length}}" class="state-panel">暂无兑换记录。</view></block>
 <block wx:else><disclosure-section title="推广主体核验" summary="{{advertiserNames.length?'已核验主体可直接选用':'提交推广前核验实际主体'}}" open="{{!advertisers.length}}" large-text="{{displayPreferences.largeText}}"><view class="notice">先核验主体，再提交本人已审核信息及原图。素材通过后选择排期，最终确认积分价格。</view><input class="field" data-field="subject" value="{{subject}}" bindinput="field" maxlength="100" placeholder="实际主体名称" aria-label="广告主体名称"/><input class="field" data-field="reference" value="{{reference}}" bindinput="field" maxlength="200" placeholder="实际材料工单引用，不填写证件号" aria-label="主体材料引用"/><button class="btn light" disabled="{{busy||pending}}" bindtap="applyAdvertiser">提交主体核验</button><view class="notice" wx:for="{{advertisers}}" wx:key="id">{{item.name}} · {{item.status==='verified'?'已核验':item.status==='pending'?'待核验':'已撤销'}}</view></disclosure-section>
 <view class="section-card"><view class="section-title">提交推广素材</view><picker range="{{targetNames}}" value="{{targetIndex}}" data-key="targetIndex" bindchange="pick"><view class="field">{{targetNames[targetIndex]||'选择本人已审核信息'}} ⌄</view></picker><picker range="{{imageNames}}" value="{{imageIndex}}" data-key="imageIndex" bindchange="pick"><view class="field">{{imageNames[imageIndex]||'选择已审核图片'}} ⌄</view></picker><image wx:if="{{images[imageIndex]}}" class="material-preview" src="{{apiBase}}/api/v1/media/{{images[imageIndex]}}" mode="aspectFill"/><picker range="{{advertiserNames}}" value="{{advertiserIndex}}" data-key="advertiserIndex" bindchange="pick"><view class="field">{{advertiserNames[advertiserIndex]||'选择已核验广告主体'}} ⌄</view></picker><input class="field" data-field="title" value="{{title}}" bindinput="field" maxlength="80" placeholder="本条推广标题" aria-label="推广标题"/><button class="btn" disabled="{{busy||pending||!targets.length||!advertiserNames.length}}" id="promotion-submit" bindtap="submitPromotion">提交素材审核（暂不扣分）</button></view>
 <view class="section-card"><view class="section-title">选择推广排期</view><picker range="{{slotNames}}" value="{{slotIndex}}" data-key="slotIndex" bindchange="pick"><view class="field">{{slotNames[slotIndex]||'暂无开放排期'}} ⌄</view></picker><view class="notice">排期限定信息所属城市、地区、素材有效期及广告主体有效期；价格与库存以最终确认时为准。展示标注广告，不承诺浏览量。</view></view>
 <view class="section-card {{focusId===item.id?'focused-record':''}}" wx:for="{{campaigns}}" wx:key="id"><view class="row"><text class="section-title">{{item.title}}</text><text class="badge">{{item.statusText}}</text></view><view wx:if="{{item.slot_id}}" class="notice">{{item.startText}} 至 {{item.endText}} · {{item.price_snapshot}} 分{{item.cancelled_at?' · 已取消排期':''}}{{item.refund_entry_id?' · 积分已退还':''}}</view><button wx:if="{{item.status==='approved'}}" class="btn" data-id="{{item.id}}" disabled="{{busy||pending||!slots.length}}" id="promotion-purchase-{{item.id}}" bindtap="purchase">确认所选排期与积分价格</button><button wx:if="{{item.status==='scheduled'||item.status==='paused'}}" class="btn light" data-id="{{item.id}}" data-status="{{item.status==='scheduled'?'paused':'scheduled'}}" disabled="{{busy||pending}}" bindtap="displayStatus">{{item.status==='scheduled'?'停止展示':'恢复原排期展示'}}</button><button wx:if="{{item.canCancel}}" class="btn light" data-id="{{item.id}}" disabled="{{busy||pending}}" id="promotion-cancel-{{item.id}}" bindtap="cancelPromotion">取消申请 / 退还积分</button></view></block>
 <button wx:if="{{hasMore&&tab!=='offers'}}" class="btn light" disabled="{{loading||busy}}" bindtap="more">加载更早记录</button>
</block>
</view></view>
