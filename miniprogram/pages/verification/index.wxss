.verify-title{font-size:38rpx;font-weight:600;color:var(--ink);margin-top:20rpx}.verify-copy{font-size:29rpx;color:var(--text);line-height:1.8;margin-bottom:28rpx}.verify-state{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid var(--border);font-size:28rpx}.verify-state text:last-child{color:var(--muted)}.verify-number{font-size:34rpx;color:var(--ink);margin-bottom:22rpx}.appeal-row{padding:22rpx 0;border-bottom:1rpx solid var(--border);font-size:27rpx}.appeal-row .btn{margin-top:16rpx}.large-text .verify-copy,.large-text .verify-state{font-size:33rpx}

/* VM page composition. */
.verify-title { margin-top:8rpx; font-size:40rpx; line-height:1.4; }
.verify-copy { font-size:30rpx; line-height:1.8; margin:16rpx 0 28rpx; }
.verify-state { min-height:104rpx; align-items:center; padding:24rpx 0; font-size:30rpx; }
