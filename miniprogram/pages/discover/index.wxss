.discover-root { --channel-row-height:50px; }
.discover-root.theme-prism { background:var(--background); background-image:none; }
.discover-toolbar { position:sticky; z-index:20; top:var(--channel-header-height,88px); height:var(--channel-row-height); border-bottom:1rpx solid var(--border); background:var(--surface); }
.discover-root .discover-page { padding:0 32rpx calc(48rpx + 56px + env(safe-area-inset-bottom)); }
.discover-controls { position:sticky; z-index:19; top:calc(var(--channel-header-height,88px) + var(--channel-row-height)); margin:0 0 28rpx; padding:12rpx 0 16rpx; border-bottom:1rpx solid var(--border); background:var(--surface); }
.result-header { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:88rpx; }
.browse-city,.sort-trigger { display:flex; align-items:center; gap:12rpx; min-height:88rpx; padding:14rpx 0; margin:0; border:0; border-radius:0; background:transparent; color:var(--ink); font-size:28rpx; line-height:1.5; }
.browse-city { min-width:0; max-width:65%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-weight:600; }
.sort-trigger { color:var(--muted); font-size:26rpx; }
.browse-city::after,.sort-trigger::after,.browse-chip::after { border:0; }
.sort-chevron { width:12rpx; height:12rpx; border-right:2rpx solid var(--muted); border-bottom:2rpx solid var(--muted); transform:rotate(45deg); margin-top:-6rpx; }
.sort-chevron.expanded { transform:rotate(225deg); margin-top:6rpx; }
.browse-filter-row { display:flex; align-items:center; }
.browse-scope,.browse-secondary { width:50%; min-width:0; }
.browse-secondary { display:flex; align-items:center; gap:6rpx; }
.browse-secondary picker,.browse-secondary button { flex:1; min-width:0; }
.browse-chip { display:flex; align-items:center; justify-content:center; min-height:88rpx; margin:0; padding:12rpx 8rpx; border:0; border-radius:12rpx; background:transparent; color:var(--muted); font-size:26rpx; line-height:1.5; white-space:nowrap; }
.browse-chip.selected { color:var(--link); background:var(--soft); font-weight:600; }
.result-list { padding-top:0; }
.list-end { padding:24rpx 0 32rpx; color:var(--muted); text-align:center; font-size:26rpx; line-height:1.7; }
.load-next { width:100%; min-height:96rpx; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); color:var(--link); font-size:28rpx; }
.distance-note { padding:16rpx 0; }
.discover-floats { position:fixed; z-index:25; right:24rpx; bottom:calc(32rpx + 56px + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:16rpx; }
.float-action { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; margin:0; padding:0; border:1rpx solid var(--border); border-radius:22rpx; background:var(--surface); box-shadow:var(--elevation); }
.float-action::after { border:0; }
.float-search { position:relative; width:32rpx; height:32rpx; border:2rpx solid var(--link); border-radius:50%; margin:-5rpx 5rpx 0 0; }
.float-search::after { content:''; position:absolute; right:-11rpx; bottom:-6rpx; width:16rpx; height:2rpx; transform:rotate(45deg); background:var(--link); }
.float-globe { position:relative; width:38rpx; height:38rpx; border:2rpx solid var(--link); border-radius:50%; }
.float-globe::before { content:''; position:absolute; top:1rpx; bottom:1rpx; left:8rpx; right:8rpx; border-left:2rpx solid var(--link); border-right:2rpx solid var(--link); border-radius:50%; }
.float-globe view { position:absolute; top:16rpx; left:0; right:0; height:2rpx; background:var(--link); }
.immersed { opacity:0; pointer-events:none; }
.sort-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.sort-close { display:flex; align-items:center; justify-content:center; min-height:88rpx; padding:12rpx; margin:0; border:0; background:transparent; color:var(--link); font-size:28rpx; }
.sort-close::after,.sort-option::after { border:0; }
.sort-option { display:flex; align-items:center; width:100%; gap:16rpx; min-height:112rpx; margin:0; padding:20rpx 16rpx; border:0; border-bottom:1rpx solid var(--border); border-radius:0; background:var(--surface); text-align:left; }
.sort-option.selected { background:var(--soft); border-radius:14rpx; }
.sort-option-copy { flex:1; min-width:0; }
.sort-option-name { color:var(--ink); font-size:30rpx; font-weight:500; line-height:1.5; }
.sort-option-hint,.sort-condition { color:var(--muted); font-size:24rpx; line-height:1.7; }
.sort-check { color:var(--link); font-size:34rpx; }
.sort-option[disabled] { opacity:.5; }
.sort-feedback { padding:20rpx 0; color:var(--danger); font-size:26rpx; }
.large-text .browse-filter-row { flex-wrap:wrap; }
.large-text .browse-scope,.large-text .browse-secondary { width:100%; }
.large-text .browse-city,.large-text .sort-trigger,.large-text .browse-chip { font-size:30rpx; }
