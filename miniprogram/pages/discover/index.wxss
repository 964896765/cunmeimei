.discover-root { --channel-row-height:56px; }
.discovery-hero { position:relative; margin:14rpx 24rpx 12rpx; min-height:168rpx; border-radius:22rpx; overflow:hidden; background:linear-gradient(110deg,#A33E63,#C78298); color:#FFFFFF; }
.discovery-hero-copy { position:relative; z-index:1; padding:28rpx 30rpx; }
.discovery-hero-copy>view { font-size:40rpx; font-weight:650; line-height:1.4; letter-spacing:1rpx; }
.discovery-hero-copy>text { display:block; max-width:86%; margin-top:6rpx; font-size:22rpx; line-height:1.5; }
.discovery-hero>image { position:absolute; right:12rpx; bottom:-6rpx; width:190rpx; height:164rpx; }
.discover-sticky { position:sticky; z-index:20; top:var(--page-header,var(--channel-header-height,88px)); background:var(--background); }
.discover-toolbar { background:var(--background); }
.discover-root .discover-page { padding:0 24rpx calc(48rpx + 56px + env(safe-area-inset-bottom)); }
.discover-controls { margin:0 24rpx 12rpx; padding:8rpx 12rpx; border:0; border-radius:24rpx; background:var(--soft); box-shadow:none; }
.result-header { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:40px; margin:0; }
.browse-city { display:flex; align-items:center; gap:10rpx; min-width:0; flex:1; min-height:36px; padding:6rpx 0; margin:0; border:0; background:transparent; color:var(--ink); font-size:28rpx; font-weight:650; line-height:1.5; }
.browse-city>text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.browse-location-icon { width:28rpx; height:34rpx; flex-shrink:0; }
.city-chevron,.pill-chevron { flex-shrink:0; width:10rpx; height:10rpx; margin:-6rpx 4rpx 0; border-right:2rpx solid currentColor; border-bottom:2rpx solid currentColor; transform:rotate(45deg); }
.refine-trigger { display:flex; align-items:center; justify-content:center; gap:6rpx; flex-shrink:0; min-height:36px; margin:0; padding:0 12px; border:0; border-radius:18px; background:var(--soft-alt); color:var(--text); font-size:24rpx; line-height:1.5; }
.browse-city::after,.refine-trigger::after,.browse-chip::after { border:0; }
.filter-funnel { display:block; flex-shrink:0; width:26rpx; height:28rpx; }
.discovery-filter-pills { display:inline-flex; gap:8px; align-items:center; min-width:100%; height:44px; }
.browse-chip { flex:1; display:flex; align-items:center; justify-content:center; gap:6rpx; min-width:0; min-height:36px; margin:0; padding:0 12px; border:0; border-radius:18px; background:var(--soft); color:var(--text); font-size:24rpx; line-height:1.5; white-space:nowrap; }
.browse-chip.selected { color:var(--on-action); background:var(--action); font-weight:600; }
.browse-chip[disabled] { opacity:.45; }
.pill-location { width:24rpx; height:28rpx; flex-shrink:0; }
.pill-clock { position:relative; width:22rpx; height:22rpx; flex-shrink:0; border:2rpx solid currentColor; border-radius:50%; }
.pill-clock::after { content:''; position:absolute; top:4rpx; left:9rpx; width:6rpx; height:7rpx; border-left:2rpx solid currentColor; border-bottom:2rpx solid currentColor; }
.result-list { padding:0; }
.list-end { padding:24rpx 0 32rpx; color:var(--muted); text-align:center; font-size:26rpx; line-height:1.7; }
.load-next { width:100%; min-height:96rpx; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); color:var(--link); font-size:28rpx; }
.distance-note { padding:16rpx 0; }
.discover-floats { position:fixed; z-index:25; right:24rpx; bottom:calc(32rpx + 56px + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:16rpx; }
.float-action { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; margin:0; padding:0; border:1rpx solid var(--border); border-radius:22rpx; background:var(--surface); box-shadow:var(--elevation); }
.float-action::after { border:0; }
.float-search { position:relative; width:32rpx; height:32rpx; border:2rpx solid var(--link); border-radius:50%; margin:-5rpx 5rpx 0 0; }
.float-search::after { content:''; position:absolute; right:-11rpx; bottom:-6rpx; width:16rpx; height:2rpx; transform:rotate(45deg); background:var(--link); }
.float-globe { position:relative; width:38rpx; height:38rpx; border:2rpx solid var(--link); border-radius:50%; }
.float-globe::before { content:''; position:absolute; top:1rpx; bottom:1rpx; left:8rpx; right:8rpx; border-left:2rpx solid var(--link); border-right:2rpx solid var(--link); border-radius:50%; }
.float-globe view { position:absolute; top:16rpx; left:0; right:0; height:2rpx; background:var(--link); }
.immersed { opacity:0; pointer-events:none; }
.sort-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.sort-close { display:flex; align-items:center; justify-content:center; min-height:76rpx; padding:12rpx; margin:0; border:0; background:transparent; color:var(--link); font-size:28rpx; }
.sort-close::after,.sort-option::after,.refinement-option::after { border:0; }
.sort-option { display:flex; align-items:center; width:100%; gap:16rpx; min-height:112rpx; margin:0; padding:20rpx 16rpx; border:0; border-bottom:1rpx solid var(--border); border-radius:0; background:var(--surface); text-align:left; }
.sort-option.selected { background:var(--soft); border-radius:14rpx; }
.sort-option-copy { flex:1; min-width:0; }
.sort-option-name { color:var(--ink); font-size:30rpx; font-weight:500; line-height:1.5; }
.sort-option-hint,.sort-condition { color:var(--muted); font-size:24rpx; line-height:1.7; }
.sort-check { color:var(--link); font-size:34rpx; }
.sort-option[disabled] { opacity:.5; }
.sort-feedback { padding:20rpx 0; color:var(--danger); font-size:26rpx; }

.large-text .discovery-hero-copy>view { font-size:42rpx; }
.large-text .discovery-hero-copy>text { max-width:100%; font-size:30rpx; }
.large-text .discovery-hero>image { display:none; }

.large-text .browse-chip { font-size:30rpx; }
.large-text .browse-city { font-size:32rpx; }
.theme-dark .discovery-hero { background:var(--soft); color:var(--ink); }

.refinement-scroll { width:100%; height:44px; white-space:nowrap; }
.refinement-scroll .browse-chip { flex:1 0 auto; min-width:0; padding:10rpx 8rpx; }
.quick-category-picker { display:flex; flex:1 0 auto; min-width:0; }
.quick-category-picker .browse-chip { width:100%; }
.refinement-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:20rpx 0; }
.refinement-option { display:flex; align-items:center; justify-content:center; min-height:36px; margin:0; padding:6px 12px; border:0; border-radius:18px; background:var(--soft); color:var(--text); font-size:26rpx; line-height:1.5; }
.refinement-option.selected { background:var(--action); color:var(--on-action); font-weight:600; }
.refinement-option[disabled] { opacity:.5; }
.large-text .refinement-option { font-size:32rpx; }

.panel-refinement { padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid var(--border); }
.refinement-hint { margin:8rpx 0 0; color:var(--muted); font-size:24rpx; line-height:1.6; }
.large-text .refinement-hint { font-size:29rpx; }
.discovery-guidance { display:flex; align-items:center; gap:14rpx; min-height:76rpx; width:100%; margin:24rpx 0 0; padding:16rpx 22rpx; border:0; border-radius:28rpx; background:var(--soft); color:var(--text); font-size:24rpx; line-height:1.6; text-align:left; }
.discovery-guidance image { width:32rpx; height:32rpx; flex-shrink:0; }
.discovery-guidance text { flex:1; }
.discovery-guidance .guidance-arrow { flex:0; color:var(--link); font-size:34rpx; }
.large-text .discovery-guidance { font-size:29rpx; }

.compact-sort { display:flex; align-items:center; justify-content:center; gap:10rpx; flex-shrink:0; min-height:36px; max-width:38%; margin:0; padding:0 10px; border:0; border-radius:18px; background:var(--surface); color:var(--text); font-size:24rpx; line-height:1.5; }
.compact-sort text { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.compact-sort.is-active,.refine-trigger.is-active { background:var(--action); color:var(--on-action); }
.refine-trigger.is-active .filter-funnel { display:none; }
.filter-count { display:flex; align-items:center; justify-content:center; min-width:30rpx; height:30rpx; padding:0 6rpx; border-radius:50%; background:var(--on-action); color:var(--action); font-size:20rpx; }
.condition-scroll { width:100%; height:76rpx; }
.condition-strip { display:flex; align-items:center; gap:12rpx; width:max-content; min-width:100%; padding:0 24rpx 12rpx; }
.condition-tag,.condition-clear { display:flex; align-items:center; gap:12rpx; flex-shrink:0; max-width:380rpx; min-height:60rpx; margin:0; padding:10rpx 18rpx; border:1rpx solid var(--border); border-radius:30rpx; background:var(--surface); color:var(--link); font-size:23rpx; line-height:1.5; }
.condition-tag text:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.condition-clear { border-color:transparent; background:transparent; color:var(--muted); }
.filter-panel-heading { display:flex; flex-shrink:0; align-items:center; justify-content:space-between; gap:20rpx; padding-bottom:24rpx; border-bottom:1rpx solid var(--border); }
.filter-panel-heading .section-title { font-size:36rpx; }
.filter-panel-subtitle { display:block; margin-top:6rpx; color:var(--muted); font-size:24rpx; }
.panel-close { display:flex; align-items:center; justify-content:center; width:44px; height:44px; margin:0; padding:0; border:0; border-radius:50%; background:var(--soft); color:var(--muted); font-size:42rpx; line-height:1; }
.filter-panel-footer { position:relative; z-index:1; flex-shrink:0; padding-top:16rpx; border-top:1rpx solid var(--border); background:var(--surface); }
.filter-status { display:flex; align-items:center; justify-content:center; gap:12rpx; min-height:40rpx; padding:4rpx 0 12rpx; color:var(--muted); font-size:24rpx; text-align:center; line-height:1.5; }
.filter-status button { flex-shrink:0; margin:0; padding:8rpx 12rpx; border:0; background:var(--soft); color:var(--link); font-size:24rpx; }
.filter-footer-actions { display:flex; gap:20rpx; }
.filter-reset,.filter-apply { display:flex; align-items:center; justify-content:center; min-height:88rpx; margin:0; padding:16rpx 28rpx; border:0; border-radius:44rpx; font-size:28rpx; line-height:1.5; }
.filter-reset { flex:1; background:var(--soft); color:var(--text); }
.filter-apply { flex:2; background:var(--action); color:var(--on-action); }
.filter-apply[disabled],.filter-reset[disabled] { opacity:.5; }
.large-text .compact-sort,.large-text .refine-trigger { font-size:28rpx; }
.large-text .condition-scroll { height:88rpx; }
.large-text .condition-tag,.large-text .condition-clear,.large-text .filter-panel-subtitle,.large-text .filter-status { font-size:29rpx; }
.compact-sort::after { border:0; }
.discover-compact .discover-sticky { background:var(--surface); border-bottom:1rpx solid var(--border); box-shadow:0 4rpx 10rpx #45323f08; }
.discover-compact .discover-controls { margin-bottom:8rpx; }
.discover-compact .condition-scroll { display:none; }
.filter-city-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; min-height:88rpx; margin:12rpx 0; padding:16rpx 20rpx; border:0; border-radius:18rpx; background:var(--soft); color:var(--ink); font-size:28rpx; line-height:1.5; }
.filter-city-row text:first-child { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-align:left; }
.filter-city-row text:last-child { flex-shrink:0; color:var(--link); font-size:24rpx; }
.panel-conditions { display:flex; flex-wrap:wrap; gap:12rpx; padding:12rpx 0; }
.panel-conditions .condition-tag { max-width:100%; }
.discover-root .discover-floats { bottom:calc(32rpx + var(--page-bottom,90px)); }
.discover-root .discover-page { padding-bottom:calc(24rpx + var(--page-bottom,90px)); }
.refinement-scroll { margin-bottom:16rpx; }
@media (max-width:350px) { .refine-trigger { padding:0 8px; } .compact-sort { padding:0 8px; } .browse-city { font-size:25rpx; } }

.discover-root .discover-page { min-height:calc(var(--page-viewport) - var(--page-header) - var(--page-dock)); }
