<view class="theme-root discover-root {{themeClass}}" style="{{themeStyle}};--channel-header-height:{{headerHeight}}px">
 <page-header id="navigation-header" title="青方睐村美美" subtitle="本地生活信息展示与查询" logo-src="/assets/brand-butterfly.jpg" align="start" transparent="{{true}}" large-text="{{displayPreferences.largeText}}" bind:measure="headerMeasured"/>
 <view class="discovery-intro"><view>发现同城</view><text>看看身边的热门信息、商家和活动</text></view>
 <view class="discover-toolbar"><channel-tabs id="business-channels" value="{{type}}" theme="{{displayPreferences.theme}}" large-text="{{displayPreferences.largeText}}" reduce-motion="{{displayPreferences.reduceMotion}}" bind:change="changeType"/></view>
 <view class="container discover-page"><view class="discover-controls">
 <view class="row result-header"><button class="browse-city" bindtap="chooseCity" aria-label="选择浏览地区"><image class="browse-location-icon" src="/assets/icons/location-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text>{{cityCode?cityLabel:'选择地区'}}{{area&&area!=='全部地区'&&area!=='全市范围'?' · '+area:''}}</text></button><button class="refine-trigger" bindtap="openFilters">筛选{{categoryId||days?' · 已选':''}} ›</button></view>
 <view class="discovery-filter-pills"><button class="browse-chip" bindtap="openSort" aria-label="排序方式，当前{{sortLabel}}">排序方式⌄</button><button class="browse-chip {{sortCode==='latest'?'selected':''}}" data-code="latest" bindtap="selectSort">最新发布</button><button class="browse-chip {{sortCode==='distance'?'selected':''}}" bindtap="chooseNearby" disabled="{{type!=='all'&&type!=='merchant'&&type!=='service'}}">附近最近</button><button class="browse-chip {{images==='with'?'selected':''}}" bindtap="toggleImages" aria-pressed="{{images==='with'}}">▧ 仅看图片</button></view>
 <active-conditions wx:if="{{categoryId||days||images==='with'||q||radiusKm}}" id="active-conditions" keyword="{{q}}" category-id="{{categoryId}}" district-code="{{districtCode}}" days="{{days}}" images="{{images}}" radius-km="{{radiusKm}}" hide="days,images" large-text="{{displayPreferences.largeText}}" bind:remove="removeCondition" bind:reset="clearFilters"/>
 </view>
 <view wx:if="{{filterNotice}}" class="notice" role="status">{{filterNotice}}</view>
 <view wx:if="{{sortCode==='distance'}}" class="notice distance-note">仅显示有已核验公开位置的商家与可预约服务，近似位置按公开精度计算。</view>
 <view class="result-list"><content-card id="discover-result-{{item.id}}" layout="{{item.type==='merchant'?'merchant':item.type==='service'?'service':type==='event'||type==='public'?'article':'stream'}}" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" wx:for="{{filtered}}" wx:key="id" item="{{item}}" bind:open="goDetail" bind:favorite="toggleSaved"/></view>
 <feedback-state wx:if="{{error}}" kind="error" title="{{filtered.length?'已保留当前内容':'暂时未能加载'}}" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新尝试" bind:action="retry"/><feedback-state wx:elif="{{loading}}" kind="loading" description="正在加载…" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/><feedback-state wx:elif="{{!filtered.length}}" kind="empty" title="暂时没有找到" description="当前条件下暂无公开信息，可调整上方频道、行业和筛选。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="浏览当前城市全部信息" bind:action="browseAll"/>
 <button wx:elif="{{hasMore}}" class="load-next" bindtap="loadMore">继续加载</button><view wx:else class="list-end">{{limitReached?'结果较多，请缩小地区或筛选条件继续查找。':'已看到当前条件下的全部信息'}}</view>
 <view class="discover-floats {{immersed?'immersed':''}}"><button class="float-action" bindtap="openSearch" aria-label="搜索信息" hover-class="float-pressed"><view class="float-search" aria-hidden="true"></view></button><button class="float-action" bindtap="openMap" aria-label="地图找信息" hover-class="float-pressed"><view class="float-globe" aria-hidden="true"><view></view></view></button></view>
 <bottom-sheet open="{{filterOpen}}" label="筛选信息" dismissible="{{true}}" bind:close="closeFilters"><view class="sort-heading"><text class="section-title">筛选信息</text><button class="sort-close" bindtap="closeFilters">完成</button></view><view class="field-label">行业与地区</view><browse-filters id="browse-refinements" category-id="{{categoryId}}" city-code="{{cityCode}}" district-code="{{districtCode}}" large-text="{{displayPreferences.largeText}}" bind:category="categoryChanged" bind:district="districtChanged"/><view class="field-label">发布时间</view><picker range="{{dateLabels}}" value="{{dateIndex}}" bindchange="selectTime"><view class="field">{{dateLabels[dateIndex]}} ⌄</view></picker><button class="btn light" bindtap="clearFilters">重置筛选</button></bottom-sheet>
 <bottom-sheet open="{{sortOpen}}" label="排序方式" dismissible="{{true}}" bind:close="closeSort">
  <view class="sort-heading"><text class="section-title">排序方式</text><button class="sort-close" bindtap="closeSort" aria-label="关闭排序">关闭</button></view>
  <view class="sort-options"><button wx:for="{{sortOptions}}" wx:key="code" class="sort-option {{sortCode===item.code?'selected':''}}" disabled="{{!item.enabled||sortBusy}}" data-code="{{item.code}}" bindtap="selectSort" aria-pressed="{{sortCode===item.code}}"><view class="sort-option-copy"><view class="sort-option-name">{{item.name}}</view><view class="sort-option-hint">{{item.hint}}</view></view><text wx:if="{{sortCode===item.code}}" class="sort-check">✓</text><text wx:elif="{{!item.enabled}}" class="sort-condition">条件不足</text></button></view>
  <view wx:if="{{sortBusy||sortError}}" class="sort-feedback" role="status">{{sortError||'正在获取定位…'}}</view>
 </bottom-sheet>
</view></view>
