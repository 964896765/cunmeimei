<view class="theme-root discover-root {{themeClass}}" style="{{themeStyle}};--channel-header-height:{{headerHeight}}px">
 <page-header id="navigation-header" title="发现同城" transparent="{{true}}" large-text="{{displayPreferences.largeText}}" bind:measure="headerMeasured"/>
 <view class="discover-toolbar"><channel-tabs id="business-channels" value="{{type}}" theme="{{displayPreferences.theme}}" large-text="{{displayPreferences.largeText}}" reduce-motion="{{displayPreferences.reduceMotion}}" bind:change="changeType"/></view>
 <view class="container discover-page">
 <view class="row result-header"><button class="browse-city" bindtap="chooseCity" aria-label="选择浏览城市">{{cityCode?cityLabel:'选择地区'}}</button><button class="sort-trigger" bindtap="openSort" aria-label="排序，当前{{sortLabel}}" aria-expanded="{{sortOpen}}"><text>{{sortLabel}}</text><view class="sort-chevron {{sortOpen?'expanded':''}}"></view></button></view>
 <view class="browse-filter-row"><view class="browse-scope"><browse-filters id="browse-refinements" category-id="{{categoryId}}" city-code="{{cityCode}}" district-code="{{districtCode}}" large-text="{{displayPreferences.largeText}}" bind:category="categoryChanged" bind:district="districtChanged"/></view>
 <view class="browse-secondary"><picker range="{{dateLabels}}" value="{{dateIndex}}" bindchange="selectTime"><view class="browse-chip {{days?'selected':''}}">{{dateLabels[dateIndex]}} ⌄</view></picker><button class="browse-chip {{images==='with'?'selected':''}}" bindtap="toggleImages" aria-pressed="{{images==='with'}}">仅有图片</button></view></view>
 <active-conditions id="active-conditions" keyword="{{q}}" category-id="{{categoryId}}" district-code="{{districtCode}}" days="{{days}}" images="{{images}}" radius-km="{{radiusKm}}" hide="days,images" large-text="{{displayPreferences.largeText}}" bind:remove="removeCondition" bind:reset="clearFilters"/>
 <view wx:if="{{filterNotice}}" class="notice" role="status">{{filterNotice}}</view>
 <view wx:if="{{sortCode==='distance'}}" class="notice distance-note">仅显示有已核验公开位置的商家与可预约服务，近似位置按公开精度计算。</view>
 <view class="result-list"><content-card id="discover-result-{{item.id}}" layout="stream" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" wx:for="{{filtered}}" wx:key="id" item="{{item}}" bind:open="goDetail" bind:favorite="toggleSaved"/></view>
 <view wx:if="{{error}}" class="state-panel"><text>{{error}}</text><button class="btn light" bindtap="retry">重新尝试</button></view><view wx:elif="{{loading}}" class="state-panel"><view class="skeleton"></view><text>正在加载…</text></view><view wx:elif="{{!filtered.length}}" class="state-panel discover-empty"><view class="section-title">暂时没有找到</view><text>当前条件下暂无公开信息，可调整上方频道、行业和筛选。</text><button class="btn light" bindtap="browseAll">浏览当前城市全部信息</button></view>
 <button wx:elif="{{hasMore}}" class="load-next" bindtap="loadMore">继续加载</button><view wx:else class="list-end">{{limitReached?'结果较多，请缩小地区或筛选条件继续查找。':'已看到当前条件下的全部信息'}}</view>
 <view class="discover-floats {{immersed?'immersed':''}}"><button class="float-action" bindtap="openSearch" aria-label="搜索信息" hover-class="float-pressed"><view class="float-search" aria-hidden="true"></view></button><button class="float-action" bindtap="openMap" aria-label="地图找信息" hover-class="float-pressed"><view class="float-globe" aria-hidden="true"><view></view></view></button></view>
 <view wx:if="{{sortOpen}}" class="sort-layer" catchtouchmove="preventScroll"><view class="sort-mask" bindtap="closeSort"></view><view class="sort-sheet" role="dialog" aria-label="排序方式"><view class="sort-heading"><text class="section-title">排序方式</text><button class="sort-close" bindtap="closeSort" aria-label="关闭排序">关闭</button></view><scroll-view scroll-y="true" class="sort-options"><button wx:for="{{sortOptions}}" wx:key="code" class="sort-option {{sortCode===item.code?'selected':''}}" disabled="{{!item.enabled||sortBusy}}" data-code="{{item.code}}" bindtap="selectSort" aria-pressed="{{sortCode===item.code}}"><view class="sort-option-copy"><view class="sort-option-name">{{item.name}}</view><view class="sort-option-hint">{{item.hint}}</view></view><text wx:if="{{sortCode===item.code}}" class="sort-check">✓</text><text wx:elif="{{!item.enabled}}" class="sort-condition">条件不足</text></button></scroll-view><view wx:if="{{sortBusy||sortError}}" class="sort-feedback" role="status">{{sortError||'正在获取定位…'}}</view></view></view>
</view></view>
