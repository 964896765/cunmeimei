<view class="theme-root discover-root {{themeClass}}" style="{{themeStyle}};--channel-header-height:{{headerHeight}}px">
 <page-header id="navigation-header" title="发现同城" transparent="{{true}}" large-text="{{displayPreferences.largeText}}" bind:measure="headerMeasured"/>
 <view class="discovery-hero"><view class="discovery-hero-copy"><view>发现身边 · 本地生活</view><text>招聘求职 · 房屋租售 · 二手闲置 · 生活服务</text></view><image src="/assets/discover-city.png" mode="aspectFit" aria-hidden="true"/></view>
 <view class="discover-toolbar"><channel-tabs id="business-channels" variant="underline" value="{{type}}" theme="{{displayPreferences.theme}}" large-text="{{displayPreferences.largeText}}" reduce-motion="{{displayPreferences.reduceMotion}}" bind:change="changeType"/></view>
 <view class="container discover-page"><view class="discover-controls">
 <view class="row result-header"><button class="browse-city" bindtap="chooseCity" aria-label="选择浏览地区"><image class="browse-location-icon" src="/assets/icons/location-{{iconPalette||'prism'}}.png" mode="aspectFit"/><text>{{cityCode?cityLabel:'选择地区'}}{{area&&area!=='全部地区'&&area!=='全市范围'?' · '+area:''}}</text><view class="city-chevron" aria-hidden="true"></view></button><button class="refine-trigger" bindtap="openFilters" aria-label="更多筛选"><image class="filter-funnel" src="/assets/icons/filter-{{iconPalette||'prism'}}.png" mode="aspectFit" aria-hidden="true"/></button></view>
 <scroll-view class="refinement-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="discovery-filter-pills"><block wx:for="{{quickFilters}}" wx:key="key"><picker wx:if="{{item.key==='category'}}" class="quick-category-picker" mode="multiSelector" range="{{refinementCategories}}" range-key="name" value="{{refinementCategoryValue}}" bindcolumnchange="refinementCategoryColumn" bindchange="refinementCategorySelected" bindcancel="cancelRefinementCategory"><view class="browse-chip {{item.selected?'selected':''}}" aria-label="{{item.label}}，选择分类"><text>{{item.label}}</text><view class="pill-chevron" aria-hidden="true"></view></view></picker><button wx:elif="{{item.key==='sort'}}" class="browse-chip {{item.selected?'selected':''}}" data-key="sort" bindtap="openSort" aria-label="当前{{sortLabel}}，更改排序"><text>{{sortLabel}}</text><view class="pill-chevron" aria-hidden="true"></view></button><button wx:else class="browse-chip {{item.selected?'selected':''}}" data-key="{{item.key}}" bindtap="openQuickFilter" aria-label="{{item.label}}，更改条件"><text>{{item.label}}</text><view class="pill-chevron" aria-hidden="true"></view></button></block></view></scroll-view>
 <active-conditions wx:if="{{q||(days&&!quickShowsDays)||images==='with'}}" id="active-conditions" refinements="{{refinements}}" keyword="{{q}}" category-id="{{categoryId}}" district-code="{{districtCode}}" days="{{days}}" images="{{images}}" radius-km="{{radiusKm}}" hide="radiusKm,refinement:employment,refinement:salary,refinement:intent,refinement:price,refinement:area,refinement:condition,refinement:supply,refinement:eventState,refinement:infoSource" large-text="{{displayPreferences.largeText}}" bind:remove="removeCondition" bind:reset="clearFilters"/>
 </view>
 <view wx:if="{{filterNotice}}" class="notice" role="status">{{filterNotice}}</view>
 <view wx:if="{{sortCode==='distance'}}" class="notice distance-note">仅显示有已核验公开位置的商家与可预约服务，近似位置按公开精度计算。</view>
 <view class="result-list"><content-card id="discover-result-{{item.id}}" layout="discovery" icon-palette="{{iconPalette}}" theme="{{displayPreferences.theme}}" wx:for="{{filtered}}" wx:key="id" item="{{item}}" bind:open="goDetail" bind:favorite="toggleSaved"/></view>
 <feedback-state wx:if="{{error}}" kind="error" title="{{filtered.length?'已保留当前内容':'暂时未能加载'}}" description="{{error}}" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="重新尝试" bind:action="retry"/><feedback-state wx:elif="{{loading}}" kind="loading" description="正在加载…" compact="{{false}}" large-text="{{displayPreferences.largeText}}"/><feedback-state wx:elif="{{!filtered.length}}" kind="empty" title="暂时没有找到" description="当前条件下暂无公开信息，可调整上方频道、行业和筛选。" compact="{{true}}" large-text="{{displayPreferences.largeText}}" action-text="浏览当前城市全部信息" bind:action="browseAll"/>
 <button wx:elif="{{hasMore}}" class="load-next" bindtap="loadMore">继续加载</button><view wx:else class="list-end">{{limitReached?'结果较多，请缩小地区或筛选条件继续查找。':'已看到当前条件下的全部信息'}}</view>
 <button wx:if="{{!loading&&!error&&!filtered.length}}" class="discovery-guidance" bindtap="chooseCity"><image src="/assets/icons/home-news-{{iconPalette}}.png" aria-hidden="true"/><text>试试切换地区，发现更多本地信息</text><text class="guidance-arrow" aria-hidden="true">›</text></button>
 <view class="discover-floats {{immersed?'immersed':''}}"><button class="float-action" bindtap="openSearch" aria-label="搜索信息" hover-class="float-pressed"><view class="float-search" aria-hidden="true"></view></button><button class="float-action" bindtap="openMap" aria-label="地图找信息" hover-class="float-pressed"><view class="float-globe" aria-hidden="true"><view></view></view></button></view>
 <bottom-sheet id="channel-filter-sheet" open="{{filterOpen}}" label="{{filterTitle}}" dismissible="{{true}}" bind:close="closeFilters">
  <view class="sort-heading"><text class="section-title">{{filterTitle}}</text><button class="sort-close" bindtap="closeFilters">完成</button></view>
  <view class="field-label">分类与地区</view>
  <browse-filters id="browse-refinements" channel="{{type}}" category-id="{{categoryId}}" city-code="{{cityCode}}" district-code="{{districtCode}}" large-text="{{displayPreferences.largeText}}" disabled="{{quickBusy}}" bind:category="categoryChanged" bind:district="districtChanged"/>
  <view class="panel-refinement" wx:for="{{panelFilters}}" wx:for-item="field" wx:key="key">
   <view class="field-label">{{field.label}}</view><view wx:if="{{field.hint}}" class="refinement-hint">{{field.hint}}</view>
   <view class="refinement-options"><button wx:for="{{field.options}}" wx:for-item="option" wx:key="value" class="refinement-option {{option.selected?'selected':''}}" data-key="{{field.key}}" data-value="{{option.value}}" bindtap="selectRefinement" disabled="{{quickBusy}}" aria-pressed="{{option.selected}}">{{option.label}}</button></view>
   <view wx:if="{{field.key==='radiusKm'&&(quickBusy||quickError)}}" class="notice" role="status">{{quickError||'正在获取定位…'}}</view>
  </view>
  <button class="btn light" disabled="{{quickBusy}}" bindtap="clearFilters">重置筛选</button>
 </bottom-sheet>
 <bottom-sheet open="{{quickOpen}}" label="{{quickTitle}}" dismissible="{{!quickBusy}}" bind:close="closeQuickFilter"><view class="sort-heading"><text class="section-title">{{quickTitle}}</text><button class="sort-close" bindtap="closeQuickFilter">关闭</button></view><view wx:if="{{quickHint}}" class="notice">{{quickHint}}</view><view class="refinement-options"><button wx:for="{{quickOptions}}" wx:key="value" class="refinement-option {{item.selected?'selected':''}}" data-value="{{item.value}}" bindtap="selectRefinement" disabled="{{quickBusy}}" aria-pressed="{{item.selected}}">{{item.label}}</button></view><view wx:if="{{quickBusy||quickError}}" class="notice" role="status">{{quickError||'正在获取定位…'}}</view></bottom-sheet>
 <bottom-sheet open="{{sortOpen}}" label="排序方式" dismissible="{{true}}" bind:close="closeSort">
  <view class="sort-heading"><text class="section-title">排序方式</text><button class="sort-close" bindtap="closeSort" aria-label="关闭排序">关闭</button></view>
  <view class="sort-options"><button wx:for="{{sortOptions}}" wx:key="code" class="sort-option {{sortCode===item.code?'selected':''}}" disabled="{{!item.enabled||sortBusy}}" data-code="{{item.code}}" bindtap="selectSort" aria-pressed="{{sortCode===item.code}}"><view class="sort-option-copy"><view class="sort-option-name">{{item.name}}</view><view class="sort-option-hint">{{item.hint}}</view></view><text wx:if="{{sortCode===item.code}}" class="sort-check">✓</text><text wx:elif="{{!item.enabled}}" class="sort-condition">条件不足</text></button></view>
  <view wx:if="{{sortBusy||sortError}}" class="sort-feedback" role="status">{{sortError||'正在获取定位…'}}</view>
 </bottom-sheet>
</view></view>
