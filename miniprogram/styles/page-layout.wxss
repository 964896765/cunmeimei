.layout-fixed { display:flex; flex-direction:column; height:var(--page-viewport,100vh); min-height:0; overflow:hidden; box-sizing:border-box; padding-bottom:var(--page-bottom,0px); }
.layout-fixed>page-header { display:block; flex-shrink:0; }
.layout-body { flex:1; display:flex; flex-direction:column; height:0; min-height:0; overflow:hidden; }
.layout-scroll { flex:1; height:0; min-height:0; width:100%; }
.pinned-surface { background:var(--surface); border-bottom:1rpx solid var(--border); box-shadow:0 4rpx 10rpx #45323f08; }
