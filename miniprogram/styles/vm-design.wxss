/* VM Design System 1.0. Palette values are supplied by utils/palettes.js. */
.theme-root {
 --space-1:8rpx;
 --space-2:16rpx;
 --space-3:24rpx;
 --space-4:32rpx;
 --space-5:40rpx;
 --space-6:48rpx;
 --radius-sm:12rpx;
 --radius-md:24rpx;
 --radius-lg:28rpx;
 --type-visual:48rpx;
 --type-page:38rpx;
 --type-section:36rpx;
 --type-card:30rpx;
 --type-body:30rpx;
 --type-meta:26rpx;
 --card-title:30rpx;
 --card-meta:26rpx;
 --control-height:96rpx;
 --row-height:104rpx;
 --glass-surface:var(--surface);
 --glass-line:var(--border);
 --card-glass:var(--surface);
 --glass-tile:var(--soft);
 --glass-shadow:var(--elevation);
 --page-wash:none;
 --elevation:0 6rpx 20rpx rgba(126,55,88,.08);
 --button-fill:none;
 --scene-color:#EFC9D9;
 min-height:100vh;
 --bottom-navigation-height:69px;
 background:var(--background);
 color:var(--text);
 font-size:var(--type-body);
 line-height:1.65;
}
.theme-root.theme-prism,
.theme-root.theme-prism.continuous-page,
.theme-root.material-pearl,
.theme-root.material-warm {
 background-color:var(--background);
 background-image:var(--page-wash);
}
.theme-root.theme-prism {
 --page-wash:radial-gradient(ellipse 104% 22% at -8% -5%,#fff4 80%,#fffc 81%,transparent 85%),radial-gradient(ellipse at 94% 5%,#f5cee9,transparent 63%),radial-gradient(ellipse at 4% 78%,#fce1ee,transparent 64%),linear-gradient(158deg,#fff3fa,#f9effa 57%,#fff7fc);
 --button-fill:linear-gradient(143deg,#c3356d,#b11b58 70%,#971340);
 --glass-surface:linear-gradient(135deg,#fffdfdf5,#fff9fdeb 65%,#fbf4fbed);
 --glass-line:#fff;
 --card-glass:#fffafd;
 --glass-tile:linear-gradient(150deg,#fff5fb,#f6c9e1);
 --glass-shadow:0 8rpx 24rpx #a92c751c;
 --prism-highlight:#ad1552;
 background-repeat:no-repeat;
 background-size:100% 1600rpx;
}
.theme-root.theme-dark { --scene-color:#7B647E; }
.continuous-page.theme-prism::before { background-image:none; }
.theme-root.theme-prism.has-bottom-tabs:not(.material-clear):not(.funeral-scope) {
 background-color:#f6f8fd;
 --page-wash:linear-gradient(158deg,#fff 6%,#f0f4ff 48%,#f8f5fb 80%,#fafbff);
 --glass-surface:linear-gradient(150deg,#fff 22%,#fbfcff);
 --glass-line:#fff;
 --card-glass:#fcfdff;
 --glass-tile:linear-gradient(145deg,#fff,#f5effa);
 --elevation:0 12rpx 28rpx #40315d1c,0 2rpx 6rpx #40315d0e;
 --glass-shadow:inset 0 1rpx 0 #fff,var(--elevation);
 background-size:100% 100%;
}
.container { padding:28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.title { color:var(--ink); font-size:var(--type-visual); font-weight:650; line-height:1.3; letter-spacing:-1rpx; }
.section { margin-top:40rpx; }
.section-head { margin-bottom:24rpx; }
.section-title { color:var(--ink); font-size:var(--type-section); font-weight:600; line-height:1.4; }
.subtitle,.notice,.list-desc,.section-caption { color:var(--muted); font-size:var(--type-meta); line-height:1.7; }
.card,.section-card { padding:28rpx; border:1rpx solid var(--border); border-radius:var(--radius-md); background:var(--surface); box-shadow:var(--elevation); }
.btn { display:flex; align-items:center; justify-content:center; min-height:var(--control-height); padding:20rpx 28rpx; border-radius:22rpx; font-size:30rpx; font-weight:600; line-height:1.5; box-shadow:none; }
.theme-root .btn:not(.light):not(.ghost):not(.danger) { background-color:var(--action); background-image:var(--button-fill); color:var(--on-action); }
.btn.light { background:var(--surface); border:1rpx solid var(--control-border); color:var(--ink); }
.btn.ghost { background:transparent; color:var(--link); }
.btn:active { opacity:.8; }
.btn[disabled] { opacity:.5; box-shadow:none; }
.field,.field-area { width:100%; padding:22rpx 24rpx; border:1rpx solid var(--control-border); border-radius:20rpx; background:var(--surface); color:var(--ink); font-size:30rpx; line-height:1.6; }
.field { min-height:var(--control-height); }
.field-label { display:block; color:var(--ink); font-size:28rpx; font-weight:500; margin-bottom:14rpx; }
.field:focus,.field-area:focus,.field.is-focused { border-color:var(--link); box-shadow:0 0 0 2rpx var(--soft); }
.field.error,.field-area.error { border-color:var(--danger); }
.field[disabled],.field-area[disabled] { background:var(--background); color:var(--muted); }
.chip { min-height:88rpx; padding:16rpx 24rpx; border-radius:14rpx; font-size:26rpx; }
.theme-root .chip.active { background:var(--soft); color:var(--link); border-color:var(--brand); box-shadow:none; }
.state-panel,.empty { box-shadow:var(--elevation); padding:32rpx 28rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); line-height:1.7; }
.badge,.status,.tag { border-radius:8rpx; font-size:24rpx; line-height:1.6; }
.body-copy { font-size:30rpx; line-height:1.85; }
.has-bottom-tabs .container { padding-bottom:calc(48rpx + var(--bottom-navigation-height) + env(safe-area-inset-bottom)); }
.has-bottom-tabs .discover-floats { bottom:calc(32rpx + var(--bottom-navigation-height) + env(safe-area-inset-bottom)); }
.large-text { --type-visual:52rpx; --type-page:40rpx; --type-section:40rpx; --type-card:38rpx; --type-body:34rpx; --type-meta:30rpx; --card-title:38rpx; --card-meta:30rpx; --control-height:108rpx; }
.large-text .title { font-size:52rpx; }
.large-text .section-title { font-size:40rpx; }
.large-text .btn,.large-text .field,.large-text .field-area { font-size:34rpx; }
.material-clear .card,.material-clear .section-card { border-color:var(--control-border); box-shadow:none; }
.theme-prism:not(.material-clear):not(.funeral-scope):not(.memorial-page) .section-card { background:var(--glass-surface); border-color:var(--glass-line); box-shadow:var(--glass-shadow); }
.theme-root.material-clear { --glass-surface:var(--surface); --glass-line:var(--control-border); --card-glass:var(--surface); --glass-tile:var(--soft); --glass-shadow:none; }
.reduce-motion view,.reduce-motion button,.reduce-motion image { animation:none!important; transition:none!important; }
@media (prefers-reduced-motion:reduce) {
 view,button,image { animation:none!important; transition:none!important; }
}
