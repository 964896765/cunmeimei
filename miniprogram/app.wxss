/* Semantic foundations shared by all 27 registered pages. */
page {
 --background:#FBF8FA; --surface:#FFFFFF; --ink:#19171C;
 --text:#38343C; --muted:#6D6671; --brand:#A44970;
 --action:#A13E65; --on-action:#FFFFFF; --link:#973454;
 --soft:#F9EDF2; --soft-alt:#F0EAF4; --border:#F0E7ED;
 --control-border:#9B8292; --danger:#AE3154; --danger-soft:#FBEAF0;
 --price:#BC2855; --action-end:#A54A6C;
 background:var(--background); color:var(--ink);
 font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;
 font-size:30rpx; line-height:1.55;
 --glow-start:#F8E8EE;  --glow-rose:#FAEDF1;  --glow:#F1ECF6;  --wash-rose:#FBF8FA;  --wash-blue:#FBF8FA;  --wash-lilac:#FBF8FA; }
view,text,input,textarea,button,picker { box-sizing:border-box; }
button,input,textarea { font-family:inherit; }
button::after { border:0; }
button[aria-pressed="true"],button[aria-selected="true"] { font-weight:600; }
button:focus,input:focus,textarea:focus { outline:2rpx solid var(--control-border); outline-offset:3rpx; }
.top-row,.row,.section-head { display:flex; align-items:center; justify-content:space-between; }
.subtitle { margin-top:10rpx; }
.location,.more,.muted,.small { color:var(--muted); font-size:25rpx; }
.search { display:flex; align-items:center; min-height:88rpx; margin-top:22rpx; padding:0 25rpx; border:1rpx solid var(--border); border-radius:50rpx; background:var(--surface); }
.search-dot { position:relative; display:block; flex-shrink:0; width:27rpx; height:27rpx; margin-right:23rpx; border:3rpx solid var(--muted); border-radius:50%; }
.search-dot::after { content:''; position:absolute; right:-10rpx; bottom:-5rpx; height:3rpx; width:15rpx; transform:rotate(45deg); background:var(--muted); }
.search-placeholder { flex:1; color:var(--muted); font-size:26rpx; }
.list-card { display:flex; align-items:center; gap:22rpx; margin-bottom:18rpx; }
.list-art { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:112rpx; height:112rpx; border-radius:22rpx; background:var(--soft); color:var(--link); font-size:36rpx; font-weight:600; }
.list-text { flex:1; min-width:0; }
.list-title { color:var(--ink); font-size:30rpx; font-weight:600; line-height:1.45; }
.list-desc { margin-top:6rpx; }
.list-price { margin-top:8rpx; color:var(--price); font-size:28rpx; font-weight:600; }
.tag,.status,.badge { display:inline-block; padding:5rpx 12rpx; color:var(--link); background:var(--soft); }
.chips { display:flex; overflow:auto; white-space:nowrap; gap:12rpx; margin:22rpx 0; }
.chip { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; border:1rpx solid transparent; background:var(--surface); color:var(--muted); }
.btn.danger { background:var(--danger-soft); color:var(--danger); }
.field-label { margin:24rpx 0 10rpx; }
.field,.field-area { margin:10rpx 0 22rpx; }
input.field { line-height:normal; }
picker .field { display:flex; align-items:center; }
.field-area { min-height:200rpx; }
.divider { border-top:1rpx solid var(--border); margin:26rpx 0; }
.notice { padding:12rpx 0; }
.section-caption { display:block; margin-top:5rpx; }
.section-card { margin:20rpx 0; }
.state-panel { margin:24rpx 0; color:var(--muted); text-align:center; }
.state-panel .btn { margin-top:24rpx; }
.state-panel .section-title { margin-bottom:12rpx; }
.news-entry { padding:26rpx 0; border-bottom:1rpx solid var(--border); }
.news-title { color:var(--ink); font-size:var(--card-title,30rpx); font-weight:600; line-height:1.6; word-break:break-all; }
.news-summary { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-top:10rpx; color:var(--text); font-size:var(--card-meta,26rpx); line-height:1.8; }
.news-source { margin-top:12rpx; color:var(--muted); font-size:var(--card-meta,26rpx); line-height:1.6; }
.points-focused { border:2rpx solid var(--link); box-shadow:0 0 0 4rpx var(--soft); }
.skeleton { height:32rpx; margin:12rpx 0 20rpx; border-radius:10rpx; background:var(--border); }
.skeleton.short { width:65%; }
.list-end { padding:28rpx; color:var(--muted); font-size:24rpx; text-align:center; }
.load-next { padding:28rpx; color:var(--link); font-size:26rpx; text-align:center; }
.danger-text { color:var(--danger); }
.link { padding:18rpx 0; color:var(--link); font-size:26rpx; }
.body-copy { color:var(--text); white-space:pre-wrap; word-break:break-all; }
.action-row { display:flex; gap:16rpx; margin-top:20rpx; }
.action-row .btn { flex:1; }
.area-chips { margin-top:0; }
.area { display:inline-block; padding:10rpx 18rpx; color:var(--muted); font-size:25rpx; }
.area.selected { color:var(--link); background:var(--soft); border-radius:16rpx; }
.result-header { margin:16rpx 0; }
.scroll-chip { width:100%; }
.inline-feedback { margin:20rpx 0; padding:20rpx 24rpx; border:1rpx solid var(--border); border-radius:20rpx; background:var(--soft); color:var(--ink); font-size:26rpx; line-height:1.7; }
.large-text .row,.large-text .action-row,.large-text .settings-row { flex-wrap:wrap; gap:12rpx; }
.large-text .action-row .btn { min-width:240rpx; }
.large-text .settings-row>view { min-width:65%; }
.large-text .field-area { min-height:280rpx; }
.large-text .notice-body,.large-text .contact-title,.large-text .notice-title,.large-text .profile-subtitle,.large-text .category-name,.large-text .chip,.large-text .area { font-size:30rpx; }
.continuous-page { position:relative; }
@import "styles/vm-design.wxss";
