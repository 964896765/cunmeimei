# Include once in the existing Nginx http context after checking paths and names.
# Replace both certificate paths with the verified existing certificate and key.
# Prepare /var/log/dgqfl-website and install the matching logrotate rule.
map $request_uri $dgqfl_website_path {
    "~^(?<dgqfl_path_without_query>[^?]*)" $dgqfl_path_without_query;
    default /;
}
log_format dgqfl_website escape=json
    '$remote_addr [$time_iso8601] "$request_method $dgqfl_website_path" $status "$http_user_agent"';

server {
    listen 80;
    server_name dgqfl.xyz www.dgqfl.xyz;
    server_tokens off;
    access_log /var/log/dgqfl-website/access.log dgqfl_website;
    error_log /var/log/dgqfl-website/error.log warn;
    return 301 https://dgqfl.xyz$request_uri;
}

server {
    listen 443 ssl;
    server_name www.dgqfl.xyz;
    server_tokens off;
    ssl_certificate /path/to/verified/fullchain.pem;
    ssl_certificate_key /path/to/verified/privkey.pem;
    access_log /var/log/dgqfl-website/access.log dgqfl_website;
    error_log /var/log/dgqfl-website/error.log warn;
    return 301 https://dgqfl.xyz$request_uri;
}

server {
    listen 443 ssl;
    server_name dgqfl.xyz;
    ssl_certificate /path/to/verified/fullchain.pem;
    ssl_certificate_key /path/to/verified/privkey.pem;
    root /srv/dgqfl-website/current;
    charset utf-8;
    absolute_redirect off;
    autoindex off;
    server_tokens off;
    access_log /var/log/dgqfl-website/access.log dgqfl_website;
    error_log /var/log/dgqfl-website/error.log warn;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    error_page 404 /404.html;
    location = /404.html { internal; }
    location = / { try_files /index.html =404; }
    location ~ ^/(about|services|help|agreement|privacy|contact)$ {
        try_files $uri/index.html =404;
    }
    location ~ ^/(about|services|help|agreement|privacy|contact)/$ {
        return 308 /$1$is_args$args;
    }
    location ~ ^/(styles\.css|menu\.js|butterfly-motion\.js|robots\.txt|sitemap\.xml)$ {
        try_files $uri =404;
    }
    location ~* ^/media/[a-z0-9][a-z0-9_-]*\.(png|jpe?g|webp)$ {
        try_files $uri =404;
        expires 1d;
    }
    location / { return 404; }
}
