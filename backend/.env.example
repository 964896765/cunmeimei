# Only server-side; never copy this file to the mini program.
NODE_ENV=development
HOST=127.0.0.1
PORT=3101
# Use PostgreSQL for real shared persistence. Explicitly use DATA_DRIVER=memory ONLY for local API demos.
DATA_DRIVER=memory
DATABASE_URL=postgres://citylife:your-password@127.0.0.1:5432/citylife
WECHAT_APPID=
WECHAT_SECRET=
# V1: real legal operator and privacy contact. Login stays unavailable until configured.
PLATFORM_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
# Only enable /api/v1/dev/login on local loopback for developer test; must be off in production.
ALLOW_DEV_LOGIN=false
# Optional staging admin. Supply a long unique password through the environment.
ADMIN_PASSWORD=
# Separate credentials for platform security and business qualification review.
SUPER_ADMIN_PASSWORD=
VERIFICATION_ADMIN_PASSWORD=
# Optional independent grants. Allowed values are privacy and evidence.
# Empty grants preserve least-privilege access for each role.
OPERATOR_ADMIN_PERMISSIONS=
VERIFIER_ADMIN_PERMISSIONS=
# Required in production. Generate a random 32-byte key and encode as base64.
PHONE_ENCRYPTION_KEY=
# V0.6: on FIRST PostgreSQL startup these become the initial enabled regions.
# Subsequent changes are maintained via the authenticated /admin console.
# Replace the placeholder values with your real test region before initial boot.
SERVICE_AREAS=中心街道,西城区,北城区

# Private license evidence. Mount a protected directory outside the public web root.
PRIVATE_UPLOAD_DIR=../private-data

# V0.5: NEVER point the integration suite to your production database.
# Supply only in your local PowerShell test session, not in a public server environment:
# PG_TEST_DATABASE_URL=postgres://test_user:test_password@127.0.0.1:5432/citylife_integration_test

# V0.7 production checks:
# NODE_ENV=production, DATA_DRIVER=postgres, ALLOW_DEV_LOGIN=false.
# WECHAT_APPID must be a real wx-prefixed ID, secret lives on SERVER ONLY.
# ADMIN_PASSWORD should be a unique long credential (16+ chars).
# PRIVATE_UPLOAD_DIR must be an absolute directory OUTSIDE the source repository.
# On Windows, example: PRIVATE_UPLOAD_DIR=D:\citylife-private
# On Linux, example: PRIVATE_UPLOAD_DIR=/var/lib/citylife-private
# Run `npm run preflight` before startup, and `npm run db:check` against PostgreSQL.

# V0.24: if HTTPS is terminated by a local reverse proxy, list the TCP IPs
# of the trusted proxy only. Unset by default (never trust visitor-supplied headers).
# Nginx MUST overwrite X-Real-IP with $remote_addr (do not pass user input).
# Do not put end-user IPs or broad subnets here. Limit to 16 exact addresses.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
